<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      ★ CORRECTION (06/09, réintégration au build) : net8.0 (tout court) ne
      compilait déjà plus — Moto.Core cible net8.0-windows10.0.19041.0 (MAUI),
      NuGet refuse la référence de projet (NU1201, incompatibilité de TFM).
      Les fichiers obj\ présents sur disque dataient d'avant ce retargeting de
      Moto.Core, pas d'un build réussi récent.
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moto.Core\Moto.Core.csproj" />
    <!--
      ★ AJOUT (22/09) : référence vers le projet MAUI Moto.Editor, pour pouvoir
      enfin TESTER ChatService (il y vit, et il n'était jusqu'ici vérifiable
      qu'à la main). Le TFM est identique des deux côtés
      (net8.0-windows10.0.19041.0), donc le NU1201 documenté ci-dessus — qui
      venait d'une incompatibilité de TFM, pas du caractère MAUI — ne
      s'applique pas ici. À retirer si la référence s'avère ingérable.
    -->
    <ProjectReference Include="..\Moto.Editor\Moto.Editor.csproj" />
  </ItemGroup>

  <!--
    ★ EXCLUSION (06/09) : les 6 fichiers de E2E\ testent le même cluster IA
    embarquée (ONNX) que Moto.Core.csproj exclut déjà lui-même
    (EmbeddedLlmEngine, LayeredModelLoader, ModelSecurityService,
    SpeculativeDecoder, AiWatchdogService, ModelDownloaderService — voir ses
    <Compile Remove> Moto.AI\Embedded\...). Rien n'est perdu, juste mis de
    côté au même titre que le code qu'ils testent.
  -->
  <ItemGroup>
    <Compile Remove="E2E\**\*.cs" />
  </ItemGroup>

</Project>
