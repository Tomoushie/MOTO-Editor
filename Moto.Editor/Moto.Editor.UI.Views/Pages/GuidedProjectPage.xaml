<!-- Pages/GuidedProjectPage.xaml -->
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Pages.GuidedProjectPage"
             Title="Créer un projet guidé">

    <ScrollView Padding="20">

        <VerticalStackLayout Spacing="12" MaximumWidth="600">

            <Label Text="Nom du projet"
                   FontAttributes="Bold" />

            <Entry x:Name="ProjectName"
                   Placeholder="MonProjet"
                   Text="MonProjet" />

            <Label Text="Description"
                   FontAttributes="Bold" />

            <Editor x:Name="ProjectDescription"
                    HeightRequest="90"
                    Text="Un petit projet pour apprendre." />

            <Label Text="Type de projet"
                   FontAttributes="Bold" />

            <Picker x:Name="TemplatePicker"
                    Title="Choisir un type">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Application console</x:String>
                        <x:String>Module de jeu</x:String>
                        <x:String>API web</x:String>
                        <x:String>Bibliothèque</x:String>
                        <x:String>Projet vide</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <HorizontalStackLayout Spacing="12">
                <CheckBox x:Name="IncludeTests" IsChecked="True" />
                <Label Text="Inclure des tests" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="12">
                <CheckBox x:Name="IncludeDocumentation" IsChecked="True" />
                <Label Text="Inclure une documentation" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button Text="Créer le projet"
                    Clicked="OnCreateClicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
