<controls:MotoLogoView Size="36" Margin="6,10,6,14" />
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Moto.Editor.Controls"
             xmlns:views="clr-namespace:Moto.Editor.Views"
             x:Class="Moto.Editor.MainPage"
             Title="MOTO Editor">

    <ContentPage.Resources>
        <ResourceDictionary Source="Themes/MotoTheme.xaml" />
    </ContentPage.Resources>

    <Grid BackgroundColor="{StaticResource BgApp}"
          RowDefinitions="Auto,*,Auto"
          ColumnDefinitions="Auto,Auto,*,Auto">

    <Grid.RowDefinitions>
    <RowDefinition Height="32" />  <!-- Title bar custom -->
    <RowDefinition Height="*" />   <!-- Contenu principal -->
    </Grid.RowDefinitions>

        <!-- ── Title bar custom avec boutons de fenêtre ── -->
        <controls:CustomMenuBarView x:Name="MenuBar" Grid.Row="0" />

        <!-- ── Zone de drag pour la title bar ── -->
        <Border x:Name="TitleBarDragZone"
            Grid.Row="0"
            BackgroundColor="Transparent"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            InputTransparent="True" />

        <!-- Barre de menus custom (VS Code/Zen, sans chrome Windows) -->
        <controls:CustomMenuBarView x:Name="MenuBar" Grid.ColumnSpan="4" />

        <!-- Activity bar (Zen/VS Code) -->
        <controls:ActivityBarView x:Name="ActivityBar" Grid.Row="1" Grid.Column="0" />

        <!-- Sidebar : ChatGPT-style OU explorateur (bascule via activity bar) -->
        <Grid Grid.Row="1" Grid.Column="1">
            <views:SidebarView x:Name="Sidebar" />
            <views:FileExplorerView x:Name="ExplorerPanel" IsVisible="False" />
        </Grid>

        <!-- Centre : accueil (Claude/ChatGPT) OU éditeur -->
        <Grid Grid.Row="1" Grid.Column="2">
            <views:HomeView x:Name="Home" />
            <controls:EditorPaneView x:Name="EditorPane" IsVisible="False" />
        </Grid>

        <!-- Panneau conversation IA droit (VS Code Claude Code / ChatGPT) -->
        <Grid Grid.Row="1" Grid.Column="3" x:Name="AiHost" WidthRequest="340" />

        <!-- Status bar (Zen/VS Code) -->
        <views:StatusBarView x:Name="StatusBar" Grid.Row="2" Grid.ColumnSpan="4" />

        <!-- ══ OVERLAYS EXISTANTS (aucun supprimé) ══ -->
        <views:ExportMenuView x:Name="ExportMenu" Grid.Row="1" Grid.ColumnSpan="4"
            HorizontalOptions="End" VerticalOptions="Start" Margin="0,40,60,0" IsVisible="False" />
        <views:PresentationView x:Name="PresentationPanel" Grid.Row="1" Grid.ColumnSpan="4"
            HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False" />
        <views:RemoteConnectView x:Name="RemotePanel" Grid.Row="1" Grid.ColumnSpan="4"
            HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False" />
        <views:CollabView x:Name="CollabPanel" Grid.Row="1" Grid.ColumnSpan="4"
            HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False" />
        <views:AutoLinkView x:Name="AutoLinkPanel" Grid.Row="1" Grid.ColumnSpan="4"
            HorizontalOptions="End" VerticalOptions="Start" Margin="0,40,60,0" IsVisible="False" />
        <views:ContextSuggestionsView x:Name="ContextPanel" Grid.Row="1" Grid.ColumnSpan="4"
            HorizontalOptions="End" VerticalOptions="Start" Margin="0,40,60,0" IsVisible="False" />
        <views:DocPanelView x:Name="DocPanel" Grid.Row="1" Grid.ColumnSpan="4"
            HorizontalOptions="End" VerticalOptions="Start" Margin="0,40,60,0" IsVisible="False" />
        <views:PerformanceView x:Name="PerformancePanel" Grid.Row="1" Grid.ColumnSpan="4"
            HorizontalOptions="End" VerticalOptions="Start" Margin="0,40,60,0" IsVisible="False" />
        <views:PlatformView x:Name="PlatformPanel" Grid.Row="1" Grid.ColumnSpan="4"
            HorizontalOptions="End" VerticalOptions="Start" Margin="0,40,60,0" IsVisible="False" />
        <views:SettingsMenuView x:Name="SettingsMenu" Grid.Row="1" Grid.ColumnSpan="4"
            HorizontalOptions="End" VerticalOptions="Start" Margin="0,40,60,0" IsVisible="False" />
        <views:PasswordGateView x:Name="PasswordGate" Grid.Row="1" Grid.ColumnSpan="4"
            HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False" />
        <views:AiCommandBarView x:Name="AiBar" Grid.Row="1" Grid.ColumnSpan="4"
            HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,60" IsVisible="False" />

    </Grid>

</ContentPage>
