<!-- Views/DiagnosticsView.xaml -->
<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.DiagnosticsView"
             BackgroundColor="#141519">

    <Grid RowDefinitions="Auto,*">

        <Label Grid.Row="0"
               Text="Diagnostics"
               FontAttributes="Bold"
               Padding="8" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Diagnostics}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="8,4">
                        <Label Text="{Binding Severity}"
                               FontAttributes="Bold" />
                        <Label Text="{Binding Message}" />
                        <Label Text="{Binding File}"
                               FontSize="12"
                               Opacity="0.7" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentView>
