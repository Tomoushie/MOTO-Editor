<!-- Views/QuickActionsView.xaml -->
<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.QuickActionsView"
             x:Name="QuickActionsRoot"
             BackgroundColor="#17181C">

    <Grid RowDefinitions="Auto,*">

        <Label Grid.Row="0"
               Text="Actions rapides"
               FontAttributes="Bold"
               Padding="8" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding QuickActions}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Button Text="{Binding Title}"
                            Command="{Binding BindingContext.RunQuickActionCommand, Source={x:Reference QuickActionsRoot}}"
                            CommandParameter="{Binding .}"
                            Margin="6,3" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentView>
