<!-- Controls/MiniMapView.xaml -->
<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Controls.MiniMapView"
             WidthRequest="120">

    <!--
        Remplace MiniMapControl WinForms.
        Utilise GraphicsView pour dessiner une vue légère du code.
    -->
    <GraphicsView x:Name="MiniMap"
                  BackgroundColor="#17181C"
                  HeightRequest="300"
                  WidthRequest="120" />

</ContentView>
