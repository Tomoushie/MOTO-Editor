<?xml version="1.0" encoding="utf-8" ?>
<!--
  Moto.Editor/Controls/ActivityBarView.xaml
  ★ REFONTE (30/08, 2e passe) : demande explicite de Tom — se rapprocher d'un
  visuel façon "Zen Code" minimaliste : plus d'icônes, la barre bascule de
  colonne verticale (gauche, 48px) à ligne horizontale sous la barre de titre,
  espacée, police système moderne (Segoe UI Variable — native Windows 11).
  Le code-behind (ActivityBarView.xaml.cs) n'a PAS changé : mêmes
  CommandParameter ("explorer","search","ai","cortex","collab","settings"),
  même événement ActivitySelected — seul l'habillage visuel change.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Controls.ActivityBarView"
             HeightRequest="38" BackgroundColor="{StaticResource BgSide}">

    <HorizontalStackLayout Spacing="4" Padding="20,0" VerticalOptions="Center">

        <Border Padding="12,6" StrokeThickness="0" BackgroundColor="Transparent">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnItemTapped" CommandParameter="explorer" />
            </Border.GestureRecognizers>
            <Label Text="Fichiers" FontSize="{DynamicResource FontSizeUiText}" FontFamily="Segoe UI Variable Text"
                   TextColor="{StaticResource Txt1}" />
        </Border>

        <Border Padding="12,6" StrokeThickness="0" BackgroundColor="Transparent">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnItemTapped" CommandParameter="search" />
            </Border.GestureRecognizers>
            <Label Text="Recherche" FontSize="{DynamicResource FontSizeUiText}" FontFamily="Segoe UI Variable Text"
                   TextColor="{StaticResource Txt1}" />
        </Border>

        <Border Padding="12,6" StrokeThickness="0" BackgroundColor="Transparent">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnItemTapped" CommandParameter="ai" />
            </Border.GestureRecognizers>
            <Label Text="IA" FontSize="{DynamicResource FontSizeUiText}" FontFamily="Segoe UI Variable Text"
                   TextColor="{StaticResource Txt1}" />
        </Border>

        <Border Padding="12,6" StrokeThickness="0" BackgroundColor="Transparent">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnItemTapped" CommandParameter="cortex" />
            </Border.GestureRecognizers>
            <Label Text="Cortex" FontSize="{DynamicResource FontSizeUiText}" FontFamily="Segoe UI Variable Text"
                   TextColor="{StaticResource Txt1}" />
        </Border>

        <Border Padding="12,6" StrokeThickness="0" BackgroundColor="Transparent">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnItemTapped" CommandParameter="collab" />
            </Border.GestureRecognizers>
            <Label Text="Collab" FontSize="{DynamicResource FontSizeUiText}" FontFamily="Segoe UI Variable Text"
                   TextColor="{StaticResource Txt1}" />
        </Border>

        <!-- ★ RETRAIT (31/08) : l'engrenage "Réglages" a déménagé dans la barre de
             titre (CustomMenuBarView), à droite à côté de Min/Max/Fermer — demandé
             explicitement par Tom (point 1 : "remplacer" le bouton ici par celui
             d'en haut, pas dupliquer). -->

    </HorizontalStackLayout>

</ContentView>
