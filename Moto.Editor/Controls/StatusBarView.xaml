<!-- Moto.Editor/Controls/StatusBarView.xaml -->
<UserControl x:Class="Moto.Editor.Controls.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="{StaticResource StatusBarBackgroundBrush}"
          Height="28"
          Padding="8,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ══ Colonne 0 : Status text ══ -->
        <TextBlock x:Name="StatusLabel"
                   Grid.Column="0"
                   Text="Prêt"
                   FontSize="12"
                   Foreground="{StaticResource StatusBarTextBrush}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>

        <!-- ══ Colonne 1 : Compteurs erreurs / warnings ══ -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    Margin="8,0">
            <TextBlock x:Name="ErrorCount"
                       Text="⚠ 0"
                       FontSize="12"
                       Foreground="{StaticResource ErrorBrush}"/>
            <TextBlock x:Name="WarningCount"
                       Text="⚡ 0"
                       FontSize="12"
                       Foreground="{StaticResource WarningBrush}"/>
        </StackPanel>

        <!-- ══ Colonne 2 : Bouton Info (i) ══ -->
        <Border Grid.Column="2"
                Width="20" Height="20"
                Margin="4,0"
                Background="{StaticResource StatusBarAccentBrush}"
                CornerRadius="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Tapped="OnInfoClicked"
                IsHitTestVisible="True">
            <TextBlock Text="i"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{StaticResource StatusBarBackgroundBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- ══ Colonne 3 : ★ Toggle Ultra-Lite ══ -->
        <ToggleButton x:Name="UltraLiteToggle"
                      Grid.Column="3"
                      Content="⚡"
                      FontSize="13"
                      Width="32" Height="24"
                      Margin="4,0,0,0"
                      ToolTipService.ToolTip="Mode Ultra-Lite (désactive IA, CRDT, Marketplace, plugins…)"
                      Toggled="OnUltraLiteToggled"
                      Background="Transparent"
                      Foreground="{StaticResource StatusBarTextBrush}"
                      BorderBrush="{StaticResource StatusBarBorderBrush}"/>
    </Grid>
</UserControl>
