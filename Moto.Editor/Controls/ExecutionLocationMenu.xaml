<?xml version="1.0" encoding="utf-8" ?>
<!--
  Moto.Editor/Controls/ExecutionLocationMenu.xaml
  Ajouté le 30/08 : menu custom pour le chip "💻 Local" de l'accueil, en
  remplacement de DisplayActionSheet (menu natif Windows — pas custom, mal
  aligné, repéré par Tom).
  ★ CORRECTION (30/08, 2e passe) : la 1ère version (fond semi-transparent
  plein écran + ferme au clic en dehors) ne s'affichait pas correctement chez
  Tom (bandes non couvertes, deux essais). Remplacée par le MÊME modèle
  simple, prouvé fiable, que TOUS les autres panneaux flottants de ce projet
  (SettingsMenu, RemotePanel, CollabPanel...) : ancré en haut à droite, sans
  fond plein écran. Fermeture via un bouton ✕ dans l'en-tête au lieu du clic
  en dehors.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Controls.ExecutionLocationMenu">

    <!-- ★ RETOUCHE (01/09, direction "Hybride Claude") : bordure adoucie (voir
         MotoTheme.xaml) ; rayon déjà à 12, gardé tel quel.
         ★ CORRECTION (01/09) : l'ombre ajoutée dans un premier temps cassait le
         menu entier (n'apparaissait plus du tout, confirmé par Tom) — ce menu
         vit dans un Grid volontairement codé pour NE PAS se redimensionner
         (HomeView.xaml, commentaire du 31/08 : "un Grid MAUI n'est PAS
         automatiquement rogné à ses limites... LocationMenu peut déborder
         par-dessus sans agrandir ce Grid"), et l'ombre perturbe ce mécanisme de
         débordement déjà fragile. Retirée ici spécifiquement (GearMenuView et
         SettingsWindowView, dans des conteneurs normaux, gardent la leur sans
         problème). -->
    <Border Stroke="{StaticResource BorderSoft}" StrokeShape="RoundRectangle 12"
            BackgroundColor="{StaticResource BgPanel}" Padding="8" WidthRequest="260">

        <VerticalStackLayout Spacing="2">

            <Grid ColumnDefinitions="*,Auto" Margin="6,2,2,6">
                <Label Text="Emplacement d'exécution" FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource Txt2}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="✕" WidthRequest="26" HeightRequest="22" FontSize="11"
                        Padding="0" BackgroundColor="Transparent" Clicked="OnCloseClicked" />
            </Grid>

            <Border x:Name="RowLocal" BackgroundColor="Transparent" Padding="10,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRowTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Text="💻" FontSize="14" />
                    <Label Grid.Column="1" Text="Local" FontSize="13" Margin="8,0" />
                    <Label Grid.Column="2" Text="✓" TextColor="{StaticResource Accent}" />
                </Grid>
            </Border>

            <Border x:Name="RowCloud" BackgroundColor="Transparent" Padding="10,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRowTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Text="☁️" FontSize="14" />
                    <Label Grid.Column="1" Text="Cloud" FontSize="13" Margin="8,0" />
                </Grid>
            </Border>

            <Border x:Name="RowRemote" BackgroundColor="Transparent" Padding="10,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRowTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Text="🖱️" FontSize="14" />
                    <Label Grid.Column="1" Text="Contrôle à distance" FontSize="13" Margin="8,0" />
                </Grid>
            </Border>

            <Border x:Name="RowWsl" BackgroundColor="Transparent" Padding="10,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRowTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Text="🐧" FontSize="14" />
                    <Label Grid.Column="1" Text="WSL" FontSize="13" Margin="8,0" />
                </Grid>
            </Border>

            <Border x:Name="RowSsh" BackgroundColor="Transparent" Padding="10,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRowTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Text="🔐" FontSize="14" />
                    <Label Grid.Column="1" Text="SSH" FontSize="13" Margin="8,0" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </Border>
</ContentView>
