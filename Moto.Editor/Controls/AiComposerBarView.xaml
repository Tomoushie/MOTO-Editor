<?xml version="1.0" encoding="utf-8" ?>
<!--
  Moto.Editor/Controls/AiComposerBarView.xaml
  ★ AJOUT (31/08) : barre sous la zone de saisie de l'Accueil, demandée par Tom
  (points 2 à 5, captures de l'app Claude Code fournies en référence) :
  - "+" : modèle utilisé (réutilise le vrai réglage ai.default_model,
    catégorie "AI" de la fenêtre de Réglages — mêmes 5 choix).
  - Effort : réutilise le vrai réglage power_mode (Éco/Balanced/Ultra).
  - Micro + flèche : bouton dictée (honnêteté : pas encore câblé à une vraie
    reconnaissance vocale, message clair plutôt qu'un effet simulé) + liste
    des micros réellement détectés sur la machine (Windows.Devices.Enumeration,
    avec repli propre si indisponible).
  - IA / Cortex : rapatriés ici depuis la barre du haut (point 5 — "bouger").
  - Pastille de droite : "Token : infini" — texte fixe proposé par Tom
    lui-même (tout est local ou MOTO AI, pas de budget à afficher).
  Popups dans une ligne SÉPARÉE au-dessus de la barre (pas de superposition à
  gérer) — s'affichent directement au-dessus du bouton concerné.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Moto.Editor.Controls"
             x:Class="Moto.Editor.Controls.AiComposerBarView">

    <Grid RowDefinitions="Auto,Auto" RowSpacing="6">

        <!-- ══ Ligne 0 : popups (un seul visible à la fois) ══ -->
        <Grid Grid.Row="0" HorizontalOptions="Start">

            <Border x:Name="ModelPopup" IsVisible="False"
                    Stroke="{StaticResource BorderCol}" StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource BgPanel}" Padding="6" WidthRequest="230">
                <VerticalStackLayout x:Name="ModelList" Spacing="1" />
            </Border>

            <Border x:Name="EffortPopup" IsVisible="False"
                    Stroke="{StaticResource BorderCol}" StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource BgPanel}" Padding="6" WidthRequest="200">
                <VerticalStackLayout x:Name="EffortList" Spacing="1" />
            </Border>

            <Border x:Name="MicPopup" IsVisible="False"
                    Stroke="{StaticResource BorderCol}" StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource BgPanel}" Padding="6" WidthRequest="260">
                <VerticalStackLayout x:Name="MicList" Spacing="1" />
            </Border>

        </Grid>

        <!-- ══ Ligne 1 : la barre elle-même ══ -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="4">

            <Border Grid.Column="0" WidthRequest="30" HeightRequest="30" StrokeThickness="0"
                    BackgroundColor="Transparent">
                <Label Text="＋" FontSize="16" TextColor="{StaticResource Txt1}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnModelButtonTapped" />
                </Border.GestureRecognizers>
            </Border>

            <Border Grid.Column="1" Padding="10,5" StrokeThickness="0"
                    BackgroundColor="{StaticResource BgPanel}" StrokeShape="RoundRectangle 8">
                <Label x:Name="EffortLabel" Text="Effort · Balanced" FontSize="11" TextColor="{StaticResource Txt1}" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnEffortButtonTapped" />
                </Border.GestureRecognizers>
            </Border>

            <!-- ★ Emoji gardé ici (pas d'icône vectorielle micro vérifiée dans
                 Controls/MotoIcons.cs — plutôt ça qu'un glyphe deviné sans rapport). -->
            <Border Grid.Column="2" WidthRequest="30" HeightRequest="30" StrokeThickness="0"
                    BackgroundColor="Transparent">
                <Label Text="🎤" FontSize="13"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMicButtonTapped" />
                </Border.GestureRecognizers>
            </Border>

            <Border Grid.Column="3" WidthRequest="20" HeightRequest="30" StrokeThickness="0"
                    BackgroundColor="Transparent">
                <Label Text="⌄" FontSize="12" TextColor="{StaticResource Txt2}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMicChevronTapped" />
                </Border.GestureRecognizers>
            </Border>

            <Border Grid.Column="4" Padding="10,5" StrokeThickness="0"
                    BackgroundColor="{StaticResource BgPanel}" StrokeShape="RoundRectangle 8">
                <Label Text="IA" FontSize="11" TextColor="{StaticResource Txt1}" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAiTapped" />
                </Border.GestureRecognizers>
            </Border>

            <Border Grid.Column="5" Padding="10,5" StrokeThickness="0"
                    BackgroundColor="{StaticResource BgPanel}" StrokeShape="RoundRectangle 8">
                <Label Text="Cortex" FontSize="11" TextColor="{StaticResource Txt1}" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCortexTapped" />
                </Border.GestureRecognizers>
            </Border>

            <HorizontalStackLayout Grid.Column="7" Spacing="6" VerticalOptions="Center">
                <Border WidthRequest="7" HeightRequest="7" StrokeThickness="0"
                        BackgroundColor="{StaticResource Accent}" StrokeShape="RoundRectangle 4" />
                <Label Text="Token : infini · 100% local" FontSize="11" TextColor="{StaticResource Txt2}" />
            </HorizontalStackLayout>

        </Grid>
    </Grid>
</ContentView>
