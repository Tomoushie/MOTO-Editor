<?xml version="1.0" encoding="utf-8" ?>
<!--
  Moto.Editor/Controls/CodeEditorView.xaml
  Ce fichier ne contenait, avant correction, qu'un fragment "AJOUT" destiné à
  EditorPaneView.xaml (bouton Export) — probablement enregistré sous le
  mauvais nom par une session précédente. CodeEditorView.xaml.cs (le vrai
  code-behind, complet) n'a besoin que d'un seul élément nommé : le WebView
  "Web" qui héberge l'éditeur HTML/JS maison.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Controls.CodeEditorView">
    <WebView x:Name="Web"
             HorizontalOptions="Fill"
             VerticalOptions="Fill" />
</ContentView>
