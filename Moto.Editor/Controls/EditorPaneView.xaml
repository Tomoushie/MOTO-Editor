<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Moto.Editor.Controls"
             x:Class="Moto.Editor.Controls.EditorPaneView"
             BackgroundColor="#1E2025">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- ============================================================ -->
        <!-- Ligne 1 : Toolbar (flèches ← →, export, onglets, actions)    -->
        <!-- ============================================================ -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto"
              BackgroundColor="#17181C" Padding="6,4" ColumnSpacing="4">

            <!-- Navigation historique -->
            <!-- ★ CORRECTION (30/08, 2e passe) : héritaient du style Button par défaut
                 (fond gris #202126, App.xaml) — trop discrètes selon Tom ("les flèches
                 devraient être plus grandes, plus visibles et supprimer le fond gris").
                 Fond transparent + police agrandie, ICI seulement (pas touché au style
                 par défaut, utilisé par beaucoup d'autres boutons dans toute l'appli). -->
            <Button Grid.Column="0" Text="←" Padding="8,2" FontSize="18"
                    BackgroundColor="Transparent" TextColor="{StaticResource Txt1}"
                    ToolTipProperties.Text="Fichier précédent"
                    Clicked="OnBackClicked" />

            <Button Grid.Column="1" Text="→" Padding="8,2" FontSize="18"
                    BackgroundColor="Transparent" TextColor="{StaticResource Txt1}"
                    ToolTipProperties.Text="Fichier suivant"
                    Clicked="OnForwardClicked" />

            <!-- ★ CORRECTION (30/08) : la simple flèche "⬇" n'était pas assez claire
                 selon Tom ("personne ne sait ce qu'elle représente")
                 ★ CORRECTION (31/08) : fond gris par défaut retiré + agrandi, même
                 traitement que les flèches ← → ("tout est trop petit", Tom). -->
            <Button Grid.Column="2" Text="⬇ Exporter" Padding="10,4" FontSize="14"
                    BackgroundColor="Transparent" TextColor="{StaticResource Txt1}"
                    ToolTipProperties.Text="Exporter (txt, md, html, pdf, docx, odt, rtf...)"
                    Clicked="OnExportClicked" />

            <!-- Onglets (nom + badge d'erreurs) -->
            <!-- ★ CORRECTION (31/08) : fond forcé à transparent — Tom signale que le
                 nom du fichier garde un fond gris malgré le Border transparent du
                 DataTemplate (ci-dessous) ; peut venir du CollectionView lui-même. -->
            <CollectionView Grid.Column="3" x:Name="TabsList" BackgroundColor="Transparent"
                            SelectionMode="Single" HeightRequest="34"
                            SelectionChanged="OnTabSelected">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="5" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- ★ CORRECTION (31/08) : fond plein retiré (juste un contour
                             discret) + agrandi ("tout est trop petit", Tom). -->
                        <Border StrokeShape="RoundRectangle 8" BackgroundColor="Transparent"
                                Stroke="{StaticResource BorderCol}" StrokeThickness="1"
                                Padding="12,6">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Title}" FontSize="13" VerticalOptions="Center"
                                       TextColor="{StaticResource Txt1}" />
                                <Label Text="{Binding ErrorBadge}" TextColor="OrangeRed"
                                       FontSize="12" IsVisible="{Binding HasErrors}"
                                       VerticalOptions="Center" />
                                <!-- ★ AJOUT (31/08) : aucun moyen de fermer un onglet n'existait —
                                     impossible de revenir à l'Accueil une fois un fichier ouvert
                                     (repéré par Tom). -->
                                <Label Text="✕" FontSize="12" TextColor="{StaticResource Txt2}"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTabCloseTapped" CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Actions : split / plein écran / IA / preview
                 ★ CORRECTION (31/08) : les 4 icônes agrandies ("trop petites", Tom). -->
            <Button Grid.Column="4" Text="⧉" Padding="10,4" FontSize="16"
                    ToolTipProperties.Text="Partager l'écran"
                    Clicked="OnSplitClicked" />

            <!-- ★ CORRECTION (30/08) : icône désormais mise à jour par MainPage
                 (SetMaximizeIcon) — Tom ne retrouvait pas comment revenir en arrière
                 une fois en plein écran. -->
            <Button x:Name="BtnMaximize" Grid.Column="5" Text="⛶" Padding="10,4" FontSize="16"
                    ToolTipProperties.Text="Agrandir la zone (plein écran)"
                    Clicked="OnMaximizeClicked" />

            <Button Grid.Column="6" Text="🤖" Padding="10,4" FontSize="16"
                    ToolTipProperties.Text="Bandeau IA (modèle + prompts)"
                    Clicked="OnAiClicked" />

            <!-- ★ AJOUT (30/08, 3e passe) : "menu de prévisualisation" demandé par
                 Tom (point 18) — LivePreviewView + PreviewEngine existaient déjà dans
                 le dépôt (complets, fonctionnels), mais n'étaient jamais atteignables
                 par aucun bouton ni menu. Câblé ici, au plus près du fichier ouvert. -->
            <Button Grid.Column="7" Text="🌐" Padding="10,4" FontSize="16"
                    ToolTipProperties.Text="Prévisualiser le fichier"
                    Clicked="OnPreviewClicked" />

        </Grid>

        <!-- ============================================================ -->
        <!-- Ligne 2 : Breadcrumb (localisation du fichier)               -->
        <!-- ============================================================ -->
        <Border Grid.Row="1" StrokeShape="RoundRectangle 6" BackgroundColor="#202126"
                Padding="10,6" Margin="6,4">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" x:Name="CrumbLabel"
                       Text="Aucun fichier ouvert" FontSize="12" Opacity="0.8" />
                <Button Grid.Column="1" Text="Open File  Alt-Enter"
                        FontSize="10" Padding="8,2"
                        Clicked="OnOpenFileClicked" />
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- Ligne 3 : Bandeau IA (modèle + prompts, modifie en direct)   -->
        <!-- ============================================================ -->
        <Border Grid.Row="2" x:Name="AiBand" IsVisible="False"
                StrokeShape="RoundRectangle 8" BackgroundColor="#1A1B1F"
                Stroke="#3A3B40" Padding="8" Margin="6,0,6,4">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6">

                <Picker Grid.Row="0" Grid.Column="0" x:Name="ModelPicker"
                        WidthRequest="190" FontSize="11">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>MOTO interne</x:String>
                            <x:String>Ollama (qwen2.5-coder:7b)</x:String>
                            <x:String>OpenAI</x:String>
                            <x:String>Anthropic</x:String>
                            <x:String>Mistral</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Entry Grid.Row="0" Grid.Column="1" x:Name="PromptEntry"
                       Placeholder="Demande à l'IA de modifier le code… (Entrée pour envoyer)"
                       FontSize="12" BackgroundColor="Transparent"
                       Completed="OnAiSendClicked" />

                <Button Grid.Row="0" Grid.Column="2" Text="➤" Padding="10,2"
                        Clicked="OnAiSendClicked" />

                <Label Grid.Row="1" Grid.ColumnSpan="3" x:Name="AiStatus"
                       FontSize="10" Opacity="0.6" />

            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- Ligne 4 : Éditeur maison (WebView)                           -->
        <!-- ============================================================ -->
        <controls:CodeEditorView Grid.Row="3" x:Name="Editor" x:FieldModifier="Public" Margin="6,0,6,6" />

    </Grid>

</ContentView>
