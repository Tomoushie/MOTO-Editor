<?xml version="1.0" encoding="utf-8" ?>
<!--
  EditorPaneView — passe visuelle MOTO Dark (01/09)
  Layout type Zed: barre d'onglets flush (onglet actif = fond éditeur),
  puis toolbar plate, breadcrumb discret, bandeau IA, surface éditeur.
  ★ Relayée par Tom via une autre IA ("Grok") — adoptée après vérification
  contre le vrai code (5 couleurs manquantes ajoutées à MotoTheme.xaml, voir
  ce fichier ; le .cs derrière n'a pas changé, confirmé identique au dépôt).
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Moto.Editor.Controls"
             x:Class="Moto.Editor.Controls.EditorPaneView"
             BackgroundColor="{StaticResource BgEditor}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- ═══ Ligne 0 : barre d'onglets (surface ; actif = flush éditeur) ═══ -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource BgPanel}"
              HeightRequest="36"
              Padding="0">
            <CollectionView x:Name="TabsList"
                            BackgroundColor="Transparent"
                            SelectionMode="Single"
                            HeightRequest="36"
                            SelectionChanged="OnTabSelected"
                            Margin="4,0,4,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="0" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="0"
                                Padding="14,0,10,0"
                                HeightRequest="36"
                                StrokeShape="RoundRectangle 0"
                                BackgroundColor="{StaticResource BgPanel}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{StaticResource BgPanel}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{StaticResource BgEditor}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="{Binding Title}"
                                       FontSize="{DynamicResource FontSizeUiText}"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource Txt1}" />
                                <Label Text="{Binding ErrorBadge}"
                                       TextColor="{StaticResource Error}"
                                       FontSize="{DynamicResource FontSizeUiSmall}"
                                       IsVisible="{Binding HasErrors}"
                                       VerticalOptions="Center" />
                                <Label Text="✕"
                                       FontSize="{DynamicResource FontSizeUiSmall}"
                                       TextColor="{StaticResource Txt2}"
                                       VerticalOptions="Center"
                                       Opacity="0.7">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTabCloseTapped" CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- ═══ Ligne 1 : toolbar (même fond que l'éditeur = flush) ═══ -->
        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto"
              BackgroundColor="{StaticResource BgEditor}"
              Padding="6,2"
              ColumnSpacing="2">

            <Button Grid.Column="0" Text="←" Padding="8,2" FontSize="16"
                    BackgroundColor="Transparent" TextColor="{StaticResource Txt1}"
                    BorderWidth="0"
                    ToolTipProperties.Text="Fichier précédent"
                    Clicked="OnBackClicked" />

            <Button Grid.Column="1" Text="→" Padding="8,2" FontSize="16"
                    BackgroundColor="Transparent" TextColor="{StaticResource Txt1}"
                    BorderWidth="0"
                    ToolTipProperties.Text="Fichier suivant"
                    Clicked="OnForwardClicked" />

            <Button Grid.Column="2" Text="⬇ Exporter" Padding="10,2" FontSize="12"
                    BackgroundColor="Transparent" TextColor="{StaticResource Txt2}"
                    BorderWidth="0"
                    ToolTipProperties.Text="Exporter (txt, md, html, pdf, docx, odt, rtf...)"
                    Clicked="OnExportClicked" />

            <BoxView Grid.Column="3" Color="Transparent" />

            <Button Grid.Column="4" Text="⧉" Padding="8,2" FontSize="14"
                    BackgroundColor="Transparent" TextColor="{StaticResource Txt2}"
                    BorderWidth="0"
                    ToolTipProperties.Text="Partager l'écran"
                    Clicked="OnSplitClicked" />

            <Button x:Name="BtnMaximize" Grid.Column="5" Text="⛶" Padding="8,2" FontSize="14"
                    BackgroundColor="Transparent" TextColor="{StaticResource Txt2}"
                    BorderWidth="0"
                    ToolTipProperties.Text="Agrandir la zone (plein écran)"
                    Clicked="OnMaximizeClicked" />

            <Button Grid.Column="6" Text="🤖" Padding="8,2" FontSize="14"
                    BackgroundColor="Transparent" TextColor="{StaticResource Txt2}"
                    BorderWidth="0"
                    ToolTipProperties.Text="Bandeau IA (modèle + prompts)"
                    Clicked="OnAiClicked" />

            <Button Grid.Column="7" Text="🌐" Padding="8,2" FontSize="14"
                    BackgroundColor="Transparent" TextColor="{StaticResource Txt2}"
                    BorderWidth="0"
                    ToolTipProperties.Text="Prévisualiser le fichier"
                    Clicked="OnPreviewClicked" />
        </Grid>

        <!-- ═══ Ligne 2 : breadcrumb plat (plus de carte arrondie) ═══ -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto"
              BackgroundColor="{StaticResource BgEditor}"
              Padding="12,4,8,4">
            <BoxView Color="{StaticResource BorderMuted}"
                     HeightRequest="1"
                     VerticalOptions="Start"
                     Grid.ColumnSpan="2" />
            <Label Grid.Column="0" x:Name="CrumbLabel"
                   Text="Aucun fichier ouvert"
                   FontSize="{DynamicResource FontSizeUiSmall}"
                   TextColor="{StaticResource Txt2}"
                   VerticalOptions="Center"
                   Margin="0,4,0,0" />
            <Button Grid.Column="1" Text="Open File"
                    FontSize="{DynamicResource FontSizeUiSmall}"
                    Padding="8,2"
                    Margin="0,4,0,0"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Accent}"
                    BorderWidth="0"
                    Clicked="OnOpenFileClicked" />
        </Grid>

        <!-- ═══ Ligne 3 : bandeau IA ═══ -->
        <Border Grid.Row="3" x:Name="AiBand" IsVisible="False"
                StrokeShape="RoundRectangle 0"
                BackgroundColor="{StaticResource BgPanel}"
                Stroke="{StaticResource BorderMuted}"
                StrokeThickness="1"
                Padding="8"
                Margin="0">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6">
                <Picker Grid.Row="0" Grid.Column="0" x:Name="ModelPicker"
                        WidthRequest="190" FontSize="11">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>MOTO interne</x:String>
                            <x:String>Ollama (qwen2.5-coder:7b)</x:String>
                            <x:String>OpenAI</x:String>
                            <x:String>Anthropic</x:String>
                            <x:String>Mistral</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Entry Grid.Row="0" Grid.Column="1" x:Name="PromptEntry"
                       Placeholder="Demande à l'IA de modifier le code… (Entrée pour envoyer)"
                       FontSize="12" BackgroundColor="Transparent"
                       Completed="OnAiSendClicked" />

                <Button Grid.Row="0" Grid.Column="2" Text="➤" Padding="10,2"
                        BackgroundColor="{StaticResource Accent}"
                        TextColor="{StaticResource BgEditor}"
                        BorderWidth="0"
                        Clicked="OnAiSendClicked" />

                <Label Grid.Row="1" Grid.ColumnSpan="3" x:Name="AiStatus"
                       FontSize="10" TextColor="{StaticResource Txt2}" Opacity="0.8" />
            </Grid>
        </Border>

        <!-- ═══ Ligne 4 : éditeur ═══ -->
        <controls:CodeEditorView Grid.Row="4" x:Name="Editor" x:FieldModifier="Public" Margin="0" />

    </Grid>

</ContentView>
