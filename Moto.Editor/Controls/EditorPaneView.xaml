<?xml version="1.0" encoding="utf-8" ?>
<!--
  EditorPaneView — passe visuelle MOTO Dark (01/09)
  Layout type Zed: barre d'onglets flush (onglet actif = fond éditeur),
  puis toolbar plate, breadcrumb discret, bandeau IA, surface éditeur.
  ★ Relayée par Tom via une autre IA ("Grok") — adoptée après vérification
  contre le vrai code (5 couleurs manquantes ajoutées à MotoTheme.xaml, voir
  ce fichier ; le .cs derrière n'a pas changé, confirmé identique au dépôt).
  ★ REFAIT (25/09, passe « moyen → élevé ») : disposition VS Code.
    - Onglets : trait d'accent de 2 px sur l'onglet actif, icône colorée par type
      de fichier (Controls/FileTypeVisual), titre gris quand inactif, fermeture en
      glyphe fin, séparateur de 1 px entre onglets.
    - Les actions de l'éditeur (exporter, aperçu, bandeau IA, partage, plein écran)
      rejoignent la ligne des onglets, à droite : une barre d'outils entière en
      moins (la ligne 1 reste vide, pour ne pas décaler les numéros de lignes
      utilisés ailleurs). Glyphes Segoe Fluent Icons au lieu des emojis.
    - Fil d'Ariane relatif au projet ouvert, séparateurs « › », nom du fichier en
      clair ; précédent/suivant à sa gauche (comme Zed/JetBrains).
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Moto.Editor.Controls"
             x:Class="Moto.Editor.Controls.EditorPaneView"
             BackgroundColor="{StaticResource BgEditor}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- ═══ Ligne 0 : onglets (fond panneau ; actif = fond éditeur + trait d'accent) et actions ═══ -->
        <!-- ★ AJOUT (28/09) : la barre entière porte un nom — réglage tabs_show. -->
        <Grid Grid.Row="0" x:Name="TabBarRow"
              ColumnDefinitions="*,Auto"
              BackgroundColor="{StaticResource BgPanel}"
              HeightRequest="36">
            <CollectionView x:Name="TabsList"
                            Grid.Column="0"
                            BackgroundColor="Transparent"
                            SelectionMode="Single"
                            HeightRequest="36"
                            SelectionChanged="OnTabSelected">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="0" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- ★ (25/09) : l'onglet actif suit EditorDocument.IsActive (déclencheurs), l'état « Selected » du
                             CollectionView ne s'appliquant pas sous Windows. Les deux états visuels restent vides pour que
                             la surbrillance native de sélection ne se superpose pas. -->
                        <Grid HeightRequest="36" BackgroundColor="{StaticResource BgPanel}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Selected" />
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid" Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource BgEditor}" />
                                </DataTrigger>
                            </Grid.Triggers>

                            <!-- ★ AJOUT (28/09) : survol de l'onglet, pour le réglage tabs_show_close = « Hover »
                                 (la croix n'apparaît qu'au survol ; l'onglet actif la garde, voir EditorDocument). -->
                            <Grid.GestureRecognizers>
                                <PointerGestureRecognizer PointerEntered="OnTabPointerEntered"
                                                          PointerExited="OnTabPointerExited" />
                            </Grid.GestureRecognizers>

                            <HorizontalStackLayout Padding="12,0,6,0" Spacing="7" VerticalOptions="Center">
                                <!-- ★ AJOUT (28/09) : croix de fermeture AVANT l'icône — réglage tabs_close_position = « Left ».
                                     Deux exemplaires de la même croix (avant / après) plutôt qu'un déplacement d'enfant à
                                     l'exécution : un StackLayout n'a pas d'ordre modifiable, et l'un OU l'autre est visible,
                                     jamais les deux (le DataTemplate garde donc un seul ordre d'éléments, sans recoloration). -->
                                <Label IsVisible="{Binding ShowCloseLeft}"
                                       Text="{x:Static controls:MotoIcons.Close}"
                                       FontFamily="{x:Static controls:MotoIcons.FontFamily}"
                                       FontSize="9"
                                       TextColor="{StaticResource Txt3}"
                                       Padding="5,4"
                                       VerticalOptions="Center"
                                       ToolTipProperties.Text="Fermer">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTabCloseTapped" CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label IsVisible="{Binding ShowFileGlyph}"
                                       Text="{Binding FileGlyph}"
                                       TextColor="{Binding FileGlyphColor}"
                                       FontFamily="{x:Static controls:MotoIcons.FontFamily}"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                                <Label x:Name="TabTitle"
                                       Text="{Binding Title}"
                                       FontSize="{DynamicResource FontSizeUiText}"
                                       TextColor="{StaticResource Txt2}"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource Txt1}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border IsVisible="{Binding ShowErrorBadge}"
                                        BackgroundColor="{StaticResource DangerMuted}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="5,0"
                                        HeightRequest="16"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding ErrorBadge}"
                                           TextColor="{StaticResource Error}"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                </Border>
                                <Label IsVisible="{Binding ShowCloseRight}"
                                       Text="{x:Static controls:MotoIcons.Close}"
                                       FontFamily="{x:Static controls:MotoIcons.FontFamily}"
                                       FontSize="9"
                                       TextColor="{StaticResource Txt3}"
                                       Padding="5,4"
                                       VerticalOptions="Center"
                                       ToolTipProperties.Text="Fermer">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTabCloseTapped" CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>

                            <BoxView x:Name="ActiveLine"
                                     HeightRequest="2"
                                     VerticalOptions="Start"
                                     Color="{StaticResource Accent}"
                                     IsVisible="{Binding IsActive}" />
                            <BoxView WidthRequest="1"
                                     HorizontalOptions="End"
                                     Color="{StaticResource BorderMuted}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- ★ AJOUT (28/09) : le groupe d'actions porte un nom — réglage tabs_bar_buttons. -->
            <HorizontalStackLayout Grid.Column="1" x:Name="TabBarActions" Spacing="2" Padding="8,0,8,0" VerticalOptions="Center">
                <Button Style="{StaticResource MotoIconButton}"
                        Text="{x:Static controls:MotoIcons.Download}"
                        ToolTipProperties.Text="Exporter (txt, md, html, pdf, docx, odt, rtf…)"
                        Clicked="OnExportClicked" />
                <Button Style="{StaticResource MotoIconButton}"
                        Text="{x:Static controls:MotoIcons.Globe}"
                        ToolTipProperties.Text="Prévisualiser le fichier"
                        Clicked="OnPreviewClicked" />
                <Button Style="{StaticResource MotoIconButton}"
                        Text="{x:Static controls:MotoIcons.Robot}"
                        ToolTipProperties.Text="Modifier ce fichier avec l'IA (Ctrl+Maj+I)"
                        Clicked="OnAiClicked" />
                <Button Style="{StaticResource MotoIconButton}"
                        Text="{x:Static controls:MotoIcons.DockRight}"
                        ToolTipProperties.Text="Partager l'écran"
                        Clicked="OnSplitClicked" />
                <Button x:Name="BtnMaximize"
                        Style="{StaticResource MotoIconButton}"
                        Text="{x:Static controls:MotoIcons.FullScreen}"
                        ToolTipProperties.Text="Agrandir la zone (plein écran)"
                        Clicked="OnMaximizeClicked" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Ligne 1 : volontairement vide (ancienne barre d'outils, fusionnée dans la ligne 0). -->

        <!-- ═══ Ligne 2 : précédent/suivant + fil d'Ariane ═══ -->
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,Auto,*,Auto"
              ColumnSpacing="2"
              BackgroundColor="{StaticResource BgEditor}"
              Padding="6,3,8,3">
            <!-- ★ AJOUT (28/09) : les deux boutons d'historique portent un nom — réglage tabs_nav_buttons
                 (le fil d'Ariane, colonne 2, reste visible dans tous les cas).
                 ★ Piège évité : ce Grid ne doit pas être nommé « TabBarRow », déjà pris par la ligne 0. -->
            <Button Grid.Column="0" x:Name="BtnNavBack"
                    Style="{StaticResource MotoIconButton}"
                    Text="{x:Static controls:MotoIcons.Back}"
                    FontSize="12" WidthRequest="24" HeightRequest="24" MinimumWidthRequest="24" MinimumHeightRequest="24"
                    ToolTipProperties.Text="Fichier précédent"
                    Clicked="OnBackClicked" />
            <Button Grid.Column="1" x:Name="BtnNavForward"
                    Style="{StaticResource MotoIconButton}"
                    Text="{x:Static controls:MotoIcons.Forward}"
                    FontSize="12" WidthRequest="24" HeightRequest="24" MinimumWidthRequest="24" MinimumHeightRequest="24"
                    ToolTipProperties.Text="Fichier suivant"
                    Clicked="OnForwardClicked" />
            <Label Grid.Column="2" x:Name="CrumbLabel"
                   Text="Aucun fichier ouvert"
                   FontSize="{DynamicResource FontSizeUiSmall}"
                   TextColor="{StaticResource Txt3}"
                   LineBreakMode="HeadTruncation"
                   VerticalOptions="Center"
                   Margin="8,0,0,0" />
            <Button Grid.Column="3"
                    Style="{StaticResource MotoGhostButton}"
                    Text="Ouvrir un fichier…"
                    FontSize="{DynamicResource FontSizeUiSmall}"
                    Padding="8,2"
                    Clicked="OnOpenFileClicked" />
        </Grid>

        <!-- ═══ Ligne 3 : bandeau IA ═══ -->
        <!-- ★ (27/09, point 3 de Tom) : la barre centrale flottante est retirée ; ce bandeau est LA petite barre qui modifie le fichier
             ouvert. Fermé par défaut, il ne s'ouvre que sur demande : Ctrl+Maj+I, bouton 🤖, palette. Échap le referme. -->
        <Border Grid.Row="3" x:Name="AiBand" IsVisible="False"
                StrokeShape="RoundRectangle 0"
                BackgroundColor="{StaticResource BgPanel}"
                Stroke="{StaticResource BorderMuted}"
                StrokeThickness="1"
                Padding="10,8"
                Margin="0">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                <!-- ★ CHANGÉ (26/09, décision de Tom) : seulement les modèles locaux ici ; MainPage ajoute les services en ligne dont la clé
                     est enregistrée, puis « Ajouter un service en ligne… » (EditorPaneView.SetModelChoices). -->
                <Picker Grid.Row="0" Grid.Column="0" x:Name="ModelPicker"
                        WidthRequest="200" FontSize="12" SelectedIndexChanged="OnModelPickerChanged">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>MOTO interne</x:String>
                            <x:String>Ollama (qwen2.5-coder:7b)</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Entry Grid.Row="0" Grid.Column="1" x:Name="PromptEntry"
                       Placeholder="Que changer dans ce fichier ? (Entrée pour envoyer, Échap pour fermer)"
                       FontSize="{StaticResource FontSizeBody}" BackgroundColor="Transparent"
                       Completed="OnAiSendClicked" />

                <!-- ★ MODIFIÉ (24/09, écriture générative) : le bouton d'envoi devient « arrêter » pendant qu'un modèle écrit — largeur
                     fixe ; « Annuler » (sur la ligne d'état) remet le fichier comme avant la dernière modification faite d'ici.
                     ★ (25/09) : glyphes Segoe Fluent Icons (envoyer / arrêter) au lieu de ➤ / ■. -->
                <Button Grid.Row="0" Grid.Column="2" x:Name="AiSendButton"
                        Text="{x:Static controls:MotoIcons.Send}"
                        FontFamily="{x:Static controls:MotoIcons.FontFamily}"
                        FontSize="14"
                        Padding="0"
                        WidthRequest="40"
                        HeightRequest="32"
                        CornerRadius="{StaticResource RadiusSmInt}"
                        BackgroundColor="{StaticResource Accent}"
                        TextColor="White"
                        BorderWidth="0"
                        ToolTipProperties.Text="Envoyer"
                        Clicked="OnAiSendClicked" />

                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceXs}" Margin="0,4,0,0">
                    <Label Grid.Column="0" x:Name="AiStatus"
                           FontSize="{StaticResource FontSizeSmall}" TextColor="{StaticResource Txt2}"
                           VerticalOptions="Center" />

                    <Button Grid.Column="1" x:Name="AiUndoButton" IsVisible="False"
                            Style="{StaticResource MotoGhostButton}"
                            Text="↩ Annuler la modification"
                            TextColor="{StaticResource AccentText}"
                            Clicked="OnAiUndoClicked" />
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ Ligne 4 : éditeur ═══ -->
        <!-- ★ HISTORIQUE (04/09) : une marge basse de 110 px contournait l'"airspace"
             supposé du WebView de l'ancien CodeEditorView. CodeEditorViewSkia (22/09)
             l'avait conservée comme simple espace visuel. -->
        <!-- ★ ADOPTÉ (22/09, chantier rendu direct SkiaSharp, incrément 1 validé
             par Tom sur écran réel) : CodeEditorView (WebView) remplacé par
             CodeEditorViewSkia. Voir Docs/design/Cadrage-CodeEditor-SkiaSharp.md. -->
        <!-- ★ REPRIS (25/09, choix C de Tom) : retour à CodeEditorView (WebView) — CodeEditorViewSkia n'a ni défilement ni
             sélection à la souris. La marge basse de 110 est retirée : avec un éditeur qui défile, sa barre de défilement
             s'arrêtait 110 px au-dessus du bas de la zone. La place du bandeau IA flottant (AiBar) est désormais une marge
             de fin DANS l'éditeur (120 px sous la dernière ligne) : le code remonte au-dessus du bandeau, comme dans VS Code.
             Vérifié le 25/09 (captures) : diff, réglages et palette s'affichent bien PAR-DESSUS ce WebView ; la fenêtre
             native de WebView2 fait 0×0, les clics au-dessus de l'éditeur vont à l'interface XAML. -->
        <controls:CodeEditorView Grid.Row="4" x:Name="Editor" x:FieldModifier="Public" />

    </Grid>

</ContentView>
