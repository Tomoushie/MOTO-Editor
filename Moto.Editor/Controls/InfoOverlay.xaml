<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Controls.InfoOverlay"
             IsVisible="False"
             BackgroundColor="#80000000">
    <Border BackgroundColor="{StaticResource BgPanel}"
            Stroke="{StaticResource BgHover}" StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            Padding="20" WidthRequest="420"
            HorizontalOptions="Center" VerticalOptions="Center">
        <VerticalStackLayout Spacing="12">

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="MOTO Editor" FontSize="20" FontAttributes="Bold"
                       TextColor="{StaticResource Txt1}"/>
                <Button Grid.Column="1" Text="✕" WidthRequest="30" HeightRequest="30"
                        BackgroundColor="Transparent" TextColor="{StaticResource Txt2}"
                        Clicked="OnCloseClicked"/>
            </Grid>

            <Border BackgroundColor="{StaticResource BgSide}"
                    Stroke="Transparent" StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    Padding="12">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="VersionLabel" Text="Version 1.0.0"
                           FontSize="14" FontAttributes="Bold"
                           TextColor="{StaticResource Txt1}"/>
                    <Label x:Name="BuildLabel" Text="Build —" FontSize="11"
                           TextColor="{StaticResource Txt2}"/>
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout Spacing="8">
                <Button x:Name="CheckUpdateBtn" Text="🔄 Rechercher MAJ"
                        BackgroundColor="{StaticResource Accent}" TextColor="White"
                        Clicked="OnCheckUpdateClicked"/>
                <Button Text="📋 Changelog"
                        BackgroundColor="{StaticResource BgSide}" TextColor="{StaticResource Txt1}"
                        Clicked="OnChangelogClicked"/>
            </HorizontalStackLayout>

            <BoxView HeightRequest="1" BackgroundColor="{StaticResource BgHover}"/>

            <VerticalStackLayout Spacing="4">
                <Label Text="Produit par" FontSize="11" TextColor="{StaticResource Txt2}"/>
                <Label Text="MOTO Software" FontSize="13" FontAttributes="Bold"
                       TextColor="{StaticResource Txt1}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Créateur" FontSize="11" TextColor="{StaticResource Txt2}"/>
                <Label Text="Tom NOWAK" FontSize="14" FontAttributes="Bold"
                       TextColor="{StaticResource Txt1}"/>
                <Label x:Name="EmailLabel" Text="nowaktombe@protonmail.com"
                       FontSize="12" TextColor="{StaticResource Accent}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEmailClicked"/>
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

            <Label Text="© 2026 MOTO Software. Tous droits réservés."
                   FontSize="10" TextColor="{StaticResource Txt2}"
                   HorizontalOptions="Center" Margin="0,8,0,0"/>
        </VerticalStackLayout>
    </Border>
</ContentView>
