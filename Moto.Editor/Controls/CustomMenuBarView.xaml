<!-- Moto.Editor/Controls/CustomMenuBarView.xaml -->
<!--
  ★ CORRECTION (31/08) : boutons agrandis (46→52px, police 12/14→14/16) et
  survol/clic ajoutés en code-behind (AttachButtonFeedback) — demandé par Tom
  ("agrandir... et leur donner des animations au survol et après clic, comme
  pour Windows par défaut" : gris neutre pour Réduire/Plein écran, rouge pour
  Fermer, exactement la convention native Windows).
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Controls.CustomMenuBarView"
             HeightRequest="36">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <!-- Zone de drag (title bar custom) -->
        <Border x:Name="TitleBarDragZone"
                Grid.Column="0"
                BackgroundColor="Transparent"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />

        <!-- Bouton Minimiser -->
        <Border x:Name="BtnMin"
                Grid.Column="1"
                WidthRequest="52"
                BackgroundColor="Transparent"
                StrokeThickness="0">
            <Label Text="─"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   FontSize="14"
                   TextColor="{StaticResource Txt1}" />
        </Border>

        <!-- Bouton Maximiser -->
        <Border x:Name="BtnMax"
                Grid.Column="2"
                WidthRequest="52"
                BackgroundColor="Transparent"
                StrokeThickness="0">
            <Label Text="□"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   FontSize="14"
                   TextColor="{StaticResource Txt1}" />
        </Border>

        <!-- Bouton Fermer -->
        <Border x:Name="BtnClose"
                Grid.Column="3"
                WidthRequest="52"
                BackgroundColor="Transparent"
                StrokeThickness="0">
            <Label Text="×"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   FontSize="16"
                   TextColor="{StaticResource Txt1}" />
        </Border>
    </Grid>
</ContentView>
