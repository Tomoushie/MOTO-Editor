<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Controls.MotoLogoView">

    <!-- Badge logo hexagonal, taille paramétrable, cohérent MotoTheme -->
    <Border x:Name="LogoBorder"
            Background="{DynamicResource MotoLogoBackground}"
            Padding="4">
        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
        <Image x:Name="LogoImage"
               Source="moto_logo.png"
               Aspect="AspectFit"
               WidthRequest="32" HeightRequest="32" />
    </Border>
</ContentView>
