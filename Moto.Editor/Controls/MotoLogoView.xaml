<?xml version="1.0" encoding="utf-8" ?>
<!--
  ★ CORRECTION (31/08) : fond "bleu marine" (#0B1526, MotoLogoBackground)
  retiré — Tom le voyait comme un carré derrière le logo sur l'Accueil et les
  écrans À propos (3 usages, tous des gros logos centrés) et le voulait
  transparent. Border gardée (Padding) pour ne rien redimensionner ailleurs,
  juste sans couleur de fond.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Controls.MotoLogoView">

    <Border x:Name="LogoBorder"
            Background="Transparent"
            Padding="4">
        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
        <Image x:Name="LogoImage"
               Source="moto_logo.png"
               Aspect="AspectFit"
               WidthRequest="32" HeightRequest="32" />
    </Border>
</ContentView>
