<?xml version="1.0" encoding="utf-8" ?>
<!--
  Moto.Editor/Themes/MotoTheme.xaml
  Reconstruit en ResourceDictionary complet et valide : le fichier ne contenait
  plus qu'un fragment "Ajouts" (styles hover Button/Entry) sans racine
  ResourceDictionary, avec deux <Color x:Key="..."> égarés à l'intérieur d'un
  <Style> (emplacement invalide). La palette de base (BgApp/BgPanel/Txt1/...)
  utilisée par toutes les vues via {StaticResource ...} n'existait nulle part —
  ajoutée ici en reprenant les couleurs déjà codées en dur dans les vues
  existantes (EditorPaneView, SnapLayoutsHelper, AiCommandBarView...).
  Fusionné dans App.xaml via ResourceDictionary.MergedDictionaries.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ══════════════════ Palette de base ══════════════════ -->
    <Color x:Key="BgApp">#1E2025</Color>
    <Color x:Key="BgPanel">#202126</Color>
    <Color x:Key="BgSide">#17181C</Color>
    <Color x:Key="BgHover">#2A2C31</Color>
    <!-- ★ AJOUT (02/09, retouches visuelles) : #1A1B1F recopié à la main dans 12
         fichiers (Cortex/Neural/Platform/Workspace/AutoLink/ContextSuggestions/
         DocPanel/ExportMenu/PasswordGate/Performance/Presentation/RemoteConnect)
         comme fond de la carte INTÉRIEURE de chaque panneau, une teinte
         légèrement différente du fond du cadre extérieur d'AddFloatingPanel
         (BgPanel) pour donner une impression de profondeur — usage cohérent et
         volontaire (pas une dérive), donc promu en vrai jeton au lieu d'être
         "corrigé" vers BgPanel/BgApp (ce qui aurait aplati cet effet exprès). -->
    <Color x:Key="BgPanelInner">#1A1B1F</Color>
    <Color x:Key="Txt1">#E5E7EB</Color>
    <Color x:Key="Txt2">#9CA3AF</Color>
    <!-- ★ CHANGÉ (22/09, Phase 0 du langage visuel — décision prise en
         autonomie, Tom devant répondre après coup) : l'accent passe de
         #D97757 (orange terracotta, la teinte de Claude) à #007ACC.
         Trois raisons : c'est la valeur annoncée par la présentation projet
         ET par QWEN.md (le code était le seul à dire autre chose), c'est
         celle des trois références visuelles visées (VS Code #007ACC, Zed,
         JetBrains — tous bleus), et MOTO se bat sur le terrain des IDE, pas
         sur celui de Claude. L'ancienne teinte est CONSERVÉE sous
         AccentWarm : revenir en arrière coûte une ligne. 55 usages dans le
         code suivent ce jeton. -->
    <Color x:Key="Accent">#007ACC</Color>
    <Color x:Key="AccentWarm">#D97757</Color>
    <Color x:Key="BorderCol">#3A3B40</Color>
    <Color x:Key="MotoLogoBackground">#0B1526</Color>
    <Color x:Key="MotoAccentBlue">#2E9BFF</Color>

    <!-- ★ AJOUT (01/09) : 4 couleurs référencées (DynamicResource) dans 9 écrans
         secondaires (À propos, tableau de bord DevOps, Marketplace, Git, Revue,
         Suivi IA, Tableau blanc) mais jamais définies nulle part — trouvé en
         travaillant sur la cohérence des rayons d'arrondi. Ces écrans rendaient
         donc, à ces endroits précis, sans fond ni bordure (DynamicResource sur
         une clé absente ne lève pas d'erreur, elle ne s'applique juste pas).
         Valeurs choisies en réutilisant la palette déjà existante, par analogie
         avec l'usage réel ailleurs dans l'appli (jamais de nouvelle teinte
         inventée) :
         - MotoCardBackground = BgPanel (déjà le fond "carte/panneau" standard)
         - MotoCardBorder = BorderCol (déjà la bordure "carte" standard, ex. la
           carte de stats de l'Accueil)
         - MotoSubtleBackground = BgHover (déjà utilisé pour un fond légèrement
           plus clair/discret que BgPanel — ex. petites pastilles/badges)
         - MotoCanvasBackground = BgSide (déjà le fond le plus sombre/en retrait,
           utilisé pour les zones "de contenu" comme l'explorateur de fichiers). -->
    <Color x:Key="MotoCardBackground">#202126</Color>
    <Color x:Key="MotoCardBorder">#3A3B40</Color>
    <Color x:Key="MotoSubtleBackground">#2A2C31</Color>
    <Color x:Key="MotoCanvasBackground">#17181C</Color>

    <!-- ★ AJOUT (03/09, réveil de ClaudeShellView) : référencée (DynamicResource)
         par la maquette convertie par Qwen, mais absente d'ici — même famille
         de bug que les 4 couleurs "01/09" ci-dessus (une note l'affirmait déjà
         présente, faux). Valeur reprise de Txt2 (déjà LE jeton "texte
         secondaire/discret" existant), pas une teinte inventée. -->
    <Color x:Key="MotoSubtleText">#9CA3AF</Color>

    <!-- ★ AJOUT (01/09, direction "Hybride Claude") : séparateur doux, blanc
         semi-transparent au lieu d'un gris plat (#3A3B40) — reste cohérent quel
         que soit le fond derrière, principe emprunté à VS Code (editorGroup.border)
         et Zen Browser. Réservé aux panneaux flottants retouchés dans cette passe ;
         BorderCol reste utilisé ailleurs (retouche complète = chantier séparé). -->
    <Color x:Key="BorderSoft">#1AFFFFFF</Color>

    <!-- ★ AJOUT (01/09) : 5 couleurs référencées par une passe visuelle relayée
         par Tom (via une autre IA, "Grok", sur EditorPaneView.xaml et
         StatusBarPanelView.xaml) mais absentes du thème réel — sur 38 couleurs au
         total inventées dans l'archive complète reçue, ces 5 sont les SEULES
         utilisées par les 2 fichiers effectivement adoptés ici (les autres
         fichiers de l'archive, et leurs 33 couleurs manquantes restantes, ne sont
         PAS repris — chantier de réconciliation séparé, bien plus gros). Valeurs
         choisies par analogie avec l'usage réel déjà en place ailleurs :
         - BgChrome = BgSide (même valeur, la barre de statut doit avoir "le même
           fond que la barre de titre" selon le commentaire du fichier reçu — la
           barre de titre utilise déjà #17181C = BgSide).
         - BgEditor = BgApp (l'ancien fond de EditorPaneView était déjà #1E2025 =
           BgApp, avant la passe visuelle).
         - BorderMuted = même valeur que BorderSoft (même esprit : séparateur
           discret, semi-transparent).
         - Error = FF4500 (couleur EXACTE du "OrangeRed" nommé codé en dur utilisé
           avant la passe visuelle pour les badges d'erreur — aucun changement
           visuel réel, juste transformé en token réutilisable).
         - Warning = un ambre distinct de Accent (qui est déjà pris par l'orange
           terracotta de la marque) — nouvelle couleur sémantique, pas de valeur
           préexistante à reprendre. -->
    <Color x:Key="BgChrome">#17181C</Color>
    <Color x:Key="BgEditor">#1E2025</Color>
    <Color x:Key="BorderMuted">#1AFFFFFF</Color>
    <Color x:Key="Error">#FF4500</Color>
    <Color x:Key="Warning">#D9A227</Color>
    <!-- ★ AJOUT (02/09, retouches visuelles) : #DC2626 recopié à la main dans 3
         fichiers (ConfirmationOverlay = bouton "Supprimer" ; DebugPanelProView/
         DebugPanelView = marqueurs de points d'arrêt/rupture) — usage cohérent
         et distinct d'Error (#FF4500, réservé aux badges d'erreur), donc promu
         en vrai jeton sémantique au lieu d'être fondu dans Error. -->
    <Color x:Key="Danger">#DC2626</Color>

    <!-- ★ AJOUT (08/09, chantier visuel — valeurs proposées via /chat de
         l'orchestrateur XENO-SSS∞, relues et une corrigée avant application) :
         Error/Warning/Danger n'avaient pas d'équivalent positif (Success) ni
         neutre-informatif (Info), et Accent (#D97757) n'avait aucune variante
         d'état — chaque bouton/badge accentué devait improviser sa propre
         teinte de survol au lieu de réutiliser un jeton. -->
    <Color x:Key="Success">#60BF60</Color>
    <Color x:Key="Info">#7986CB</Color>
    <Color x:Key="AccentHover">#0062A3</Color>
    <!-- Lavis translucide (15% d'opacité) plutôt qu'une teinte opaque quasi
         identique à Accent (c'est ce que l'orchestrateur avait proposé) — même
         principe que BorderSoft/BorderMuted ci-dessous (alpha, pas une
         nouvelle couleur), pour un fond subtil derrière un badge/pastille
         teinté Accent sans l'aplatir. -->
    <Color x:Key="AccentMuted">#26007ACC</Color>

    <!-- ══════════════════ Espacement ══════════════════ -->
    <!-- ★ AJOUT (01/09, direction "Hybride Claude") : échelle officielle, à
         utiliser pour tout NOUVEAU travail (Spacing/RowSpacing/ColumnSpacing,
         et les Padding/Margin à valeur unique et uniforme). Ne remplace PAS
         rétroactivement les valeurs déjà réglées au pixel près par Tom au fil
         de ses retours (ex. HomeView) — les reprendre casserait un réglage déjà
         approuvé pour un gain de cohérence abstrait. Une passe de nettoyage
         plus large sur le reste du dépôt reste un chantier séparé, à faire
         plus tard si besoin (même logique que les rayons d'arrondi). -->
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceSm">8</x:Double>
    <x:Double x:Key="SpaceMd">16</x:Double>
    <x:Double x:Key="SpaceLg">24</x:Double>
    <x:Double x:Key="SpaceXl">32</x:Double>

    <!-- ══════════════════ Ombres (élévation) ══════════════════ -->
    <!-- ★ AJOUT (01/09, direction "Hybride Claude") : jusqu'ici AUCUNE ombre nulle
         part dans MOTO Editor (vérifié : 0 usage réel) — c'est une grande partie
         de ce qui donnait un rendu "plat"/premier prix. Principe emprunté à VS
         Code/Zen Browser : l'ombre est réservée aux surfaces FLOTTANTES (menus,
         popups, fenêtres modales) — jamais sur le chrome permanent (barre de
         titre, panneaux fixes). Trois paliers, du plus discret au plus marqué. -->
    <Shadow x:Key="ShadowSm" Brush="Black" Offset="0,2" Radius="8" Opacity="0.24" />
    <Shadow x:Key="ShadowMd" Brush="Black" Offset="0,4" Radius="16" Opacity="0.32" />
    <Shadow x:Key="ShadowLg" Brush="Black" Offset="0,8" Radius="28" Opacity="0.40" />

    <!-- ══════════════════ Typographie ══════════════════ -->
    <!-- ★ AJOUT (08/09, chantier visuel) : aucune FontFamily n'était déclarée
         nulle part — chaque contrôle héritait silencieusement de la police par
         défaut de la plateforme, sans jeton contrôlable. Valeurs vérifiées
         contre le vrai code source de VS Code (src/vs/workbench/browser/media/
         style.css, via /chat de l'orchestrateur XENO-SSS∞) puis ADAPTÉES : VS
         Code déclare "Segoe WPC", "Segoe UI", sans-serif (repli façon CSS que
         MAUI ne comprend pas — FontFamily y est une chaîne simple, pas une
         liste) et "Segoe WPC" est un alias interne à l'Electron de VS Code,
         absent d'un vrai poste Windows. "Segoe UI Variable" est la police
         système recommandée pour WinUI 3, la cible principale de MOTO Editor
         (macOS/Linux restent des cibles CI, pas l'usage quotidien réel — voir
         Docs/Moto.Editor.build-pipeline.md). Consolas (police à chasse fixe
         Windows, même source VS Code) sert au code affiché dans les panneaux
         IA (ex. le diff de BeginnerAssistantPage). -->
    <x:String x:Key="FontFamilyUi">Segoe UI Variable</x:String>
    <x:String x:Key="FontFamilyMono">Consolas</x:String>

    <!-- ★ AJOUT (31/08) : demandé par Tom (point 9) — le curseur "taille de police"
         des Réglages ne changeait que le contenu des fichiers ouverts. Ces 2 valeurs
         sont recalculées par SettingsApplier à partir du même réglage
         (buffer_font_size) et réinjectées ici — tout élément qui utilise
         {DynamicResource FontSizeUiText}/{DynamicResource FontSizeUiSmall} au lieu
         d'un FontSize codé en dur suit donc le curseur. Valeurs par défaut ci-dessous
         (utilisées avant la première application des réglages). -->
    <x:Double x:Key="FontSizeUiText">13</x:Double>
    <x:Double x:Key="FontSizeUiSmall">11</x:Double>
    <!-- ★ AJOUT (08/09) : la hiérarchie s'arrêtait à 2 tailles (texte/petit) —
         rien au-dessus pour distinguer un titre de page d'un texte courant.
         Non lié au curseur de Réglages ci-dessus (celui-ci ne concerne que le
         texte courant/petit d'origine) : valeurs fixes pour l'instant. -->
    <x:Double x:Key="FontSizeUiHeading">18</x:Double>
    <x:Double x:Key="FontSizeUiTitle">22</x:Double>

    <!-- ══════════════════════════════════════════════════════════════════
         ★ PHASE 0 DU LANGAGE VISUEL (22/09) — voir
         Docs/design/Langage-visuel-spec.md pour le raisonnement complet.

         Constat mesuré sur les 71 fichiers XAML réellement compilés :
         994 valeurs visuelles codées en dur, 21 tailles de police
         distinctes (dont des demi-pixels), 13 rayons distincts, et les
         jetons ci-dessous (espacements, ombres) utilisés 0 à 2 fois. La
         cause du rendu « cheap » est là : rien ne se répète, donc aucune
         grille ni hiérarchie ne se lit à l'écran.

         ⚠️ CONTRAINTE D'API VÉRIFIÉE (source MAUI 8.0.100) : `FontWeight`
         N'EXISTE PAS. Seule graisse disponible : FontAttributes
         (None/Bold/Italic). La hiérarchie repose donc sur TAILLE + GRAS +
         COULEUR + ESPACEMENT DES LETTRES — jamais sur des graisses 400/500.
         ══════════════════════════════════════════════════════════════════ -->

    <!-- ── Typographie : 21 tailles → 10 rôles ───────────────────────── -->
    <!-- Corps à 13 px (VS Code et JetBrains sont à 13 ; l'app était à 12,
         ce qui se lit « petit » — l'une des causes du jugement « cheap »). -->
    <x:Double x:Key="FontSizeDisplay">28</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeHeading">16</x:Double>
    <x:Double x:Key="FontSizeSubheading">14</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeSmall">12</x:Double>
    <x:Double x:Key="FontSizeMicro">11</x:Double>

    <!-- ── Rayons : 13 valeurs → 5 jetons ────────────────────────────── -->
    <!-- Les valeurs 7, 9, 15, 17 et 75 trouvées dans le code ne sont pas
         des choix, ce sont des résidus d'ajustement à l'œil. -->
    <CornerRadius x:Key="RadiusXs">4</CornerRadius>
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <!-- ★ AJOUT (22/09) : `Button.CornerRadius` est un **int**, alors que
         `RoundRectangle.CornerRadius` attend un `CornerRadius` (struct). Un
         jeton `CornerRadius` ne peut donc PAS servir aux deux : le passer à un
         Button lève `InvalidCastException: Unable to cast 'Microsoft.Maui.
         CornerRadius' to 'System.Int32'` AU DEMARRAGE — le build ne le voit
         pas, c'est le plantage qui l'a révélé. D'où ces variantes entières,
         réservées aux Button (et contrôles à CornerRadius entier). -->
    <x:Int32 x:Key="RadiusSmInt">6</x:Int32>
    <x:Int32 x:Key="RadiusMdInt">8</x:Int32>
    <x:Int32 x:Key="RadiusLgInt">12</x:Int32>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- ── Espacements : Padding/Margin (Thickness) ──────────────────── -->
    <!-- L'échelle SpaceXs..Xl existait déjà en x:Double mais n'était
         utilisable que pour Spacing/RowSpacing : Padding et Margin
         attendent un Thickness. D'où ces doublons de nom, qui rendent
         enfin l'échelle utilisable partout. -->
    <Thickness x:Key="PadXs">4</Thickness>
    <Thickness x:Key="PadSm">8</Thickness>
    <Thickness x:Key="PadMd">16</Thickness>
    <Thickness x:Key="PadLg">24</Thickness>
    <Thickness x:Key="PadXl">32</Thickness>
    <Thickness x:Key="PadRow">10,6</Thickness>
    <!-- Padding des puces (chips) — valeur reprise telle quelle de HomeView,
         où Tom l'avait ajustée (16,10). Promue en jeton pour supprimer deux
         littéraux SANS changer le rendu : l'échelle PadMd (16,16) aurait
         modifié son réglage. -->
    <Thickness x:Key="PadChip">16,10</Thickness>

    <!-- ── Icônes : 4 tailles (aucune n'était normalisée) ────────────── -->
    <x:Double x:Key="IconSm">14</x:Double>
    <x:Double x:Key="IconMd">16</x:Double>
    <x:Double x:Key="IconLg">20</x:Double>
    <x:Double x:Key="IconHero">24</x:Double>

    <!-- ── Focus : anneau clavier (absent partout avant ce jour) ─────── -->
    <Color x:Key="FocusRing">#007ACC</Color>

    <!-- ── Rôles typographiques (opt-in via Style=) ──────────────────── -->
    <!-- TextColor volontairement en Txt1 par défaut : une valeur locale
         sur l'élément (TextColor="...") l'emporte, donc ces styles ne
         cassent aucune couleur déjà posée. -->
    <Style x:Key="TextDisplay" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.22" />
        <Setter Property="TextColor" Value="{StaticResource Txt1}" />
    </Style>
    <Style x:Key="TextTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.25" />
        <Setter Property="TextColor" Value="{StaticResource Txt1}" />
    </Style>
    <Style x:Key="TextHeading" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.3" />
        <Setter Property="TextColor" Value="{StaticResource Txt1}" />
    </Style>
    <Style x:Key="TextSubheading" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubheading}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.35" />
        <Setter Property="TextColor" Value="{StaticResource Txt1}" />
    </Style>
    <Style x:Key="TextBody" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="LineHeight" Value="1.45" />
        <Setter Property="TextColor" Value="{StaticResource Txt1}" />
    </Style>
    <Style x:Key="TextBodyStrong" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.45" />
        <Setter Property="TextColor" Value="{StaticResource Txt1}" />
    </Style>
    <Style x:Key="TextSmall" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="LineHeight" Value="1.4" />
        <Setter Property="TextColor" Value="{StaticResource Txt2}" />
    </Style>
    <!-- ★ Micro : c'est la technique de hiérarchisation rendue nécessaire par
         l'absence de FontWeight — petite capitale espacée, comme les IDE
         modernes pour les étiquettes de section. À réserver aux étiquettes
         et badges : 11 px est trop petit pour du texte courant. -->
    <Style x:Key="TextMicro" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMicro}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0.6" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{StaticResource Txt2}" />
    </Style>
    <Style x:Key="TextMono" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="LineHeight" Value="1.45" />
        <Setter Property="TextColor" Value="{StaticResource Txt1}" />
    </Style>
    <Style x:Key="TextMonoSmall" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="LineHeight" Value="1.4" />
        <Setter Property="TextColor" Value="{StaticResource Txt2}" />
    </Style>

    <!-- ── Style IMPLICITE de Label : corrige le défaut le plus global ── -->
    <!-- Mesuré : seuls 9 fichiers XAML sur 71 déclarent une police, donc
         62 fichiers héritent de la police par défaut de la plateforme —
         DEUX typographies cohabitent dans la même fenêtre. Ce style ne pose
         QUE la police (jamais de taille ni de couleur : un setter de style
         implicite est écrasé par toute valeur locale, donc les 561 FontSize
         et 138 couleurs déjà écrites restent intactes). -->
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <!-- ★ La couleur vient d'ici désormais : un style implicite de Label
             existait AUSSI dans App.xaml, et deux styles implicites du même
             type ne fusionnent pas (l'un écrase l'autre) — la police ne
             s'appliquait donc pas. Style unique, ici. -->
        <Setter Property="TextColor" Value="{StaticResource Txt1}" />
    </Style>

    <!-- ══════════════════ Styles ══════════════════ -->
    <Style x:Key="TxtSecondary" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Txt2}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Styles opt-in (x:Key, pas implicites) pour ne pas entrer en conflit
         avec les styles Button/Entry par défaut déjà posés dans App.xaml. -->
    <Style x:Key="MotoHoverButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Txt1}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMdInt}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Padding" Value="{StaticResource PadRow}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BgHover}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BgPanel}" />
                        </VisualState.Setters>
                    </VisualState>
                    <!-- ★ AJOUT (22/09, Phase 0) : Focused et Disabled étaient
                         ABSENTS de tous les styles de bouton — un bouton
                         inactif était indiscernable d'un bouton actif, et un
                         IDE piloté au clavier n'avait aucun anneau de focus.
                         Focused pose une bordure d'accent de 1 px ; Disabled
                         baisse l'opacité et neutralise le survol. -->
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BorderWidth" Value="1" />
                            <Setter Property="BorderColor" Value="{StaticResource FocusRing}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="TextColor" Value="{StaticResource Txt2}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="MotoHoverEntry" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource BgPanel}" />
        <Setter Property="TextColor" Value="{StaticResource Txt1}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Txt2}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BgHover}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BgHover}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ★ AJOUT (02/09, retouche visuelle "vrai Zed") : d'après le vrai code source
         public de Zed (crates/project_panel/src/project_panel.rs, lu directement
         sur github.com/zed-industries/zed — pas une supposition), les boutons
         d'outils icône-seule et les lignes de liste (fichiers, entrées de menu...)
         y suivent tous les deux le même principe simple : AUCUN chrome natif, et
         un unique changement de fond par état (default/hover/selected), sans
         cadre ni relief. MotoHoverButton existait déjà pour les boutons texte
         normaux ; les 2 styles ci-dessous étendent exactement le même mécanisme
         (déjà éprouvé dans ce projet) à ces deux cas qui ne l'avaient pas :
         boutons compacts d'une barre d'outils (BasedOn, ne change que taille/
         padding) et lignes de liste (nouveau, TargetType Border, à poser en
         wrapper autour du contenu d'un DataTemplate). -->
    <Style x:Key="MotoHoverIconButton" TargetType="Button" BasedOn="{StaticResource MotoHoverButton}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <Style x:Key="MotoHoverRow" TargetType="Border">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BgHover}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

</ResourceDictionary>
