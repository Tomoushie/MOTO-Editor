<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.EvolutionPanelView"
             BackgroundColor="{StaticResource BgSide}">

    <Grid RowDefinitions="Auto,*" Padding="6">

        <Label Grid.Row="0" Text="🧬 ÉVOLUTION PROACTIVE" FontAttributes="Bold" FontSize="{StaticResource FontSizeBody}" />

        <CollectionView Grid.Row="1" x:Name="SuggestionList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource BgPanel}"
                            Padding="8" Margin="0,3">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding Title}" FontSize="{StaticResource FontSizeBody}" FontAttributes="Bold" />
                                <Label Text="{Binding Detail}" FontSize="{StaticResource FontSizeSmall}" Opacity="0.7" />
                                <Label Text="{Binding Kind}" FontSize="{StaticResource FontSizeSmall}" TextColor="LimeGreen" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="✔" FontSize="11" Padding="8,2"
                                    Clicked="OnAcceptClicked" />
                            <Button Grid.Column="2" Text="✘" FontSize="11" Padding="8,2"
                                    Clicked="OnRejectClicked" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentView>
