<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.PerformanceStatusBarView">

    <!-- Item 107 : exposé dans la StatusBar, compact, throttlé -->
    <HorizontalStackLayout Spacing="14" VerticalOptions="Center" Padding="8,2">
        <Label x:Name="MemLabel" Text="💾 — Mo" FontSize="11" Opacity="0.8" />
        <Label x:Name="CpuLabel" Text="⚙ — %" FontSize="11" Opacity="0.8" />
        <Label x:Name="ModeLabel" Text="⚡ —" FontSize="11" Opacity="0.8" />
        <Label x:Name="FpsLabel" Text="🎞 — fps" FontSize="11" Opacity="0.8" />
    </HorizontalStackLayout>
</ContentView>
