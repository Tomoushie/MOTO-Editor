<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.PerformanceStatusBarView">

    <!-- Item 107 : exposé dans la StatusBar, compact, throttlé.
         ★ CORRECTION (02/09, "réveil facile" repris) : "Mode"/"fps" du plan
         d'origine ne correspondent à rien de réel pour un éditeur XAML (pas un
         moteur de jeu, pas de boucle de rendu à mesurer) — inventer un chiffre
         aurait été malhonnête. Remplacés par Threads/GC, deux vraies mesures
         déjà échantillonnées par PerformanceProfiler (SampleMetrics). -->
    <!-- ★ (25/09, passe « moyen → élevé ») : texte seul en gris tertiaire (les emojis 💾 ⚙ 🧵 ♻ donnaient un air de jouet). -->
    <HorizontalStackLayout Spacing="{StaticResource SpaceMd}" VerticalOptions="Center" Padding="8,2">
        <Label x:Name="MemLabel" Text="— Mo" FontSize="11" TextColor="{StaticResource Txt3}" ToolTipProperties.Text="Mémoire utilisée par MOTO Editor" />
        <Label x:Name="CpuLabel" Text="CPU — %" FontSize="11" TextColor="{StaticResource Txt3}" ToolTipProperties.Text="Utilisation CPU (moyenne sur le dernier intervalle)" />
        <Label x:Name="ThreadsLabel" Text="— threads" FontSize="11" TextColor="{StaticResource Txt3}" ToolTipProperties.Text="Nombre de threads actifs" />
        <Label x:Name="GcLabel" Text="GC —" FontSize="11" TextColor="{StaticResource Txt3}" ToolTipProperties.Text="Collectes du ramasse-miettes (génération 0)" />
    </HorizontalStackLayout>
</ContentView>
