<?xml version="1.0" encoding="utf-8" ?>
<!--
  Moto.Editor/Views/SettingsWindowView.xaml
  ★ AJOUT (31/08) : nouvelle fenêtre de Réglages, demandée par Tom sur le
  modèle exact de Zed (capture d'écran fournie) — une fenêtre flottante AU
  MILIEU du logiciel, déplaçable et redimensionnable à la souris, avec une
  liste de catégories à gauche et le détail à droite. Remplace SettingsMenuView
  comme cible du bouton Réglages (devenu une icône ⚙, voir ActivityBarView).
  ★ RETOUCHE (02/09, chantier Réglages 100+) : la fenêtre (chrome flottant,
  glisser/redimensionner) reste inchangée — c'est le CONTENU qui change de
  source. Jusqu'ici : une liste d'environ 95 réglages écrite à la main dans le
  .xaml.cs, distincte du vrai catalogue du logiciel (Moto.Core.Settings.
  SettingsCatalog.All, 297 réglages réels une fois 7 catégories orphelines
  reconnectées — voir SettingsCatalog.Extensions.cs). Rebranché sur le vrai
  catalogue (mêmes types Toggle/Int/Enum/String/Action, réutilise
  Moto.Editor.Settings.SettingItem déjà éprouvé par SettingsPage, page
  jumelle jamais compilée dans l'appli — voir Moto.Editor.csproj). Recherche
  ajoutée (indispensable à cette échelle).
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.SettingsWindowView"
             IsVisible="False">

    <!-- Voile de fond semi-transparent : clic dehors = ne ferme PAS (comme Zed,
         qui garde sa fenêtre de réglages ouverte tant qu'on ne clique pas ✕) ;
         sert juste à assombrir légèrement le reste du logiciel. -->
    <Grid BackgroundColor="#66000000">

        <!-- ★ CORRECTION (31/08) : CAUSE RÉELLE de "la fenêtre de Réglages s'ouvre
             mais rien ne s'affiche + impossible de la fermer". Un Border MAUI n'a
             qu'UN SEUL enfant possible (Content) — cette Border (WindowFrame)
             contenait DEUX enfants directs (le Grid principal ET ResizeGrip). Le
             compilateur XAML ne l'a pas signalé (pas d'erreur de compilation), mais
             à l'exécution le second enfant déclaré écrasait silencieusement le
             premier : SEUL ResizeGrip devenait le contenu réel de WindowFrame — tout
             le reste (barre de titre, ✕, catégories, réglages) était construit en
             mémoire (aucune exception, x:Name valides) mais jamais accroché à
             l'arbre visuel, donc invisible ET jamais atteint par un clic. D'où :
             fenêtre visible (juste la Border + son fond), redimensionnement
             fonctionnel (ResizeGrip, seul vrai contenu), mais aucun texte, aucune
             catégorie, ✕ inopérant. Corrigé en mettant les DEUX dans un Grid
             (qui, lui, supporte plusieurs enfants superposés). -->
        <!-- ★ RETOUCHE (01/09, direction "Hybride Claude") : rayon 10→14 (surface la
             plus grande/prominente de l'appli, échelle harmonisée avec les menus à
             12), bordure adoucie et vraie ombre — jusqu'ici seule la différence de
             teinte plate avec le voile derrière la détachait du reste, aucune
             profondeur (voir l'audit visuel). -->
        <Border x:Name="WindowFrame"
                WidthRequest="900" HeightRequest="620"
                MinimumWidthRequest="560" MinimumHeightRequest="380"
                HorizontalOptions="Center" VerticalOptions="Center"
                BackgroundColor="{StaticResource BgApp}"
                Stroke="{StaticResource BorderSoft}" StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Shadow="{StaticResource ShadowLg}">

            <Grid>
                <Grid RowDefinitions="40,*">

                    <!-- ══ Barre de titre : zone de déplacement + titre + fermer ══ -->
                    <Border x:Name="DragHandle" Grid.Row="0"
                            BackgroundColor="{StaticResource BgSide}" StrokeThickness="0">
                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="14,0">
                            <Label Text="⚙ Réglages" FontAttributes="Bold"
                                   FontSize="{DynamicResource FontSizeUiText}"
                                   TextColor="{StaticResource Txt1}" VerticalOptions="Center" />
                            <!-- ★ AJOUT (02/09, état des lieux) : seul point d'entrée réel vers
                                 la config des providers IA externes (clés API OpenAI/Anthropic/
                                 Mistral, chiffrées, + test de connexion) — le catalogue de
                                 réglages ne fait QUE choisir le provider par défaut
                                 ("default_model"), il n'a aucun champ pour les clés elles-mêmes.
                                 AiSettingsPage (Pages/AiSettingsPage.xaml.cs) existait déjà, mais
                                 n'avait plus aucun moyen de s'ouvrir depuis le 31/08 (ancien menu
                                 Réglages supprimé, voir CLAUDE.md). -->
                            <Button Grid.Column="1" Text="🔑 Clés API" FontSize="{StaticResource FontSizeBody}"
                                    Style="{StaticResource MotoHoverIconButton}"
                                    ToolTipProperties.Text="Configurer les providers IA externes (OpenAI/Anthropic/Mistral)"
                                    Clicked="OnApiKeysClicked" />
                            <Button Grid.Column="2" Text="✕" WidthRequest="32" HeightRequest="32"
                                    Padding="0" BackgroundColor="Transparent"
                                    TextColor="{StaticResource Txt2}" Clicked="OnCloseClicked" />
                        </Grid>
                        <Border.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnDragPanUpdated" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- ══ Corps : catégories (gauche) + détail (droite) ══ -->
                    <Grid Grid.Row="1" ColumnDefinitions="200,*">

                        <!-- ★ AJOUT (02/09, chantier Réglages 100+) : recherche globale,
                             indispensable maintenant que le catalogue réel (297 réglages)
                             a remplacé la liste maison de ~95 — voir OnSearchChanged. -->
                        <Grid Grid.Column="0" RowDefinitions="Auto,*" BackgroundColor="{StaticResource BgSide}">
                            <Entry Grid.Row="0" x:Name="SearchEntry"
                                   Placeholder="Rechercher un réglage…"
                                   Margin="{StaticResource SpaceSm}" FontSize="{DynamicResource FontSizeUiSmall}"
                                   BackgroundColor="Transparent" TextColor="{StaticResource Txt1}"
                                   PlaceholderColor="{StaticResource Txt2}"
                                   TextChanged="OnSearchChanged" />

                            <CollectionView Grid.Row="1" x:Name="CategoryList"
                                            BackgroundColor="Transparent"
                                            SelectionMode="Single"
                                            SelectionChanged="OnCategorySelected">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="Transparent" Padding="14,10" StrokeThickness="0">
                                            <Label Text="{Binding}" FontSize="{DynamicResource FontSizeUiText}"
                                                   TextColor="{StaticResource Txt1}" />
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>

                        <ScrollView Grid.Column="1">
                            <VerticalStackLayout x:Name="DetailHost" Padding="24,18" Spacing="{StaticResource SpaceMd}" />
                        </ScrollView>

                    </Grid>
                </Grid>

                <!-- ══ Poignée de redimensionnement (coin bas-droit) ══ -->
                <Border x:Name="ResizeGrip"
                        WidthRequest="18" HeightRequest="18"
                        HorizontalOptions="End" VerticalOptions="End"
                        BackgroundColor="Transparent" StrokeThickness="0">
                    <Label Text="◢" FontSize="{StaticResource FontSizeSubheading}" TextColor="{StaticResource Txt2}"
                           HorizontalOptions="End" VerticalOptions="End" />
                    <Border.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="OnResizePanUpdated" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

        </Border>
    </Grid>
</ContentView>
