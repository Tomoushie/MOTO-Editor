<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Moto.Editor.Controls"
             x:Class="Moto.Editor.Views.AboutView">

    <Border Background="{DynamicResource MotoCardBackground}"
            Stroke="{DynamicResource MotoCardBorder}" StrokeThickness="1" Padding="24">
        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>

        <ScrollView>
            <VerticalStackLayout x:Name="RootContent" Spacing="14" HorizontalOptions="Center">

                <!-- ★ Halo neon derrière le logo (pulsé en code-behind) -->
                <Grid HorizontalOptions="Center">
                    <Border x:Name="GlowBorder" WidthRequest="150" HeightRequest="150"
                            Background="{DynamicResource MotoAccentBlue}" Opacity="0.25">
                        <Border.StrokeShape><RoundRectangle CornerRadius="75" /></Border.StrokeShape>
                    </Border>
                    <controls:MotoLogoView Size="112" HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>

                <Label Text="MOTO Editor" FontSize="30" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label x:Name="VersionLabel" Text="Version —" FontSize="13" Opacity="0.7" HorizontalOptions="Center" />
                <Label Text="Léger. Rapide. Sans dépendance. Tout fait maison."
                       FontSize="13" Opacity="0.85" HorizontalOptions="Center" />

                <Border Padding="14" WidthRequest="420"
                        Background="{DynamicResource MotoSubtleBackground}"
                        Stroke="{DynamicResource MotoCardBorder}" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="ℹ️ Système" FontSize="14" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="Auto,*" RowSpacing="3" ColumnSpacing="10">
                            <Label Grid.Row="0" Text="OS :" FontSize="12" Opacity="0.7" />
                            <Label Grid.Row="0" Grid.Column="1" x:Name="OsLabel" FontSize="12" />
                            <Label Grid.Row="1" Text="Architecture :" FontSize="12" Opacity="0.7" />
                            <Label Grid.Row="1" Grid.Column="1" x:Name="ArchLabel" FontSize="12" />
                            <Label Grid.Row="2" Text="Runtime :" FontSize="12" Opacity="0.7" />
                            <Label Grid.Row="2" Grid.Column="1" x:Name="RuntimeLabel" FontSize="12" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Button Text="📋 Copier les infos" Clicked="OnCopyInfoClicked" />
                </HorizontalStackLayout>

                <Label Text="© MOTO Editor — 100 % local, sans cloud."
                       FontSize="11" Opacity="0.5" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </Border>
</ContentView>
