<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.PerformanceView"
             BackgroundColor="{StaticResource BgSide}">

    <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource BorderCol}"
            BackgroundColor="{StaticResource BgPanelInner}" WidthRequest="460" Padding="{StaticResource SpaceMd}">

        <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="0" RowSpacing="{StaticResource SpaceSm}">

            <Label Grid.Row="0" Text="⚡ MOTO Performance Engine"
                   FontAttributes="Bold" FontSize="{StaticResource FontSizeSubheading}" />

            <!-- 4 modes -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="{StaticResource SpaceXs}">
                <Button Grid.Column="0" x:Name="BtnEco" Text="🌱 Eco"
                        FontSize="11" Padding="6,6" Clicked="OnModeClicked" />
                <Button Grid.Column="1" x:Name="BtnBalanced" Text="⚖️ Balanced"
                        FontSize="11" Padding="6,6" Clicked="OnModeClicked" />
                <Button Grid.Column="2" x:Name="BtnTurbo" Text="🚀 Turbo"
                        FontSize="11" Padding="6,6" Clicked="OnModeClicked" />
                <Button Grid.Column="3" x:Name="BtnUltra" Text="⚡ Ultra"
                        FontSize="11" Padding="6,6" Clicked="OnModeClicked" />
            </Grid>

            <!-- Preset débutant -->
            <Border Grid.Row="2" StrokeShape="RoundRectangle 8"
                    BackgroundColor="{StaticResource BgPanel}" Padding="{StaticResource SpaceSm}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="🤖 « MOTO fait tout pour moi » (Ultra : analyse continue, auto-linking, doc auto, refactor auto)"
                           FontSize="11" VerticalOptions="Center" />
                    <Switch Grid.Column="1" x:Name="FullAutoSwitch"
                            Toggled="OnFullAutoToggled" />
                </Grid>
            </Border>

            <!-- Détails du profil actuel -->
            <ScrollView Grid.Row="3">
                <Label x:Name="ProfileLabel" FontSize="11" FontFamily="Consolas"
                       Opacity="0.85" />
            </ScrollView>

        </Grid>

    </Border>

</ContentView>
