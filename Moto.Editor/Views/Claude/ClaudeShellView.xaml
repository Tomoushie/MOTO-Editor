<!-- Moto.Editor/Views/Claude/ClaudeShellView.xaml
     Conversion XAML de l'interface HTML v4. Clés réelles MotoTheme + charte uniquement. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:claude="clr-namespace:Moto.Editor.Views.Claude"
             x:Class="Moto.Editor.Views.Claude.ClaudeShellView"
             x:Name="Root">

  <ContentView.Resources>
    <ResourceDictionary>
      <!-- Bouton icône discret (survol gris arrondi, cohérent MotoHoverButton) -->
      <Style x:Key="CcIconBtn" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{StaticResource Txt2}"/>
        <Setter Property="WidthRequest" Value="32"/>
        <Setter Property="HeightRequest" Value="32"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="0"/>
      </Style>
      <!-- Titre serif des pages (WebSite / Personnaliser / Artéfacts) -->
      <Style x:Key="CcSerifTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="Georgia"/>
        <Setter Property="FontSize" Value="27"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource Txt1}"/>
      </Style>
      <!-- Carte standard. ★ CORRIGÉ (03/09) : "CornerRadius" n'existe pas sur
           Border en MAUI (propriété reçue de Qwen, ne compilait pas —
           XFC0001) ; le vrai équivalent est StrokeShape=RoundRectangle, déjà
           utilisé partout ailleurs dans ce même fichier. -->
      <Style x:Key="CcCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
        <Setter Property="Stroke" Value="{DynamicResource BorderCol}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
      </Style>
      <!-- Bouton segmenté -->
      <Style x:Key="CcSegBtn" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{StaticResource Txt2}"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="HeightRequest" Value="30"/>
      </Style>
      <!-- Mono (terminal / diffs) -->
      <Style x:Key="CcMono" TargetType="Label">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
      </Style>

      <claude:ClaudeMsgSelector x:Key="MsgSelector">
        <claude:ClaudeMsgSelector.UserTemplate>
          <DataTemplate>
            <Border Background="{StaticResource BgHover}" StrokeShape="RoundRectangle 12"
                    Padding="14,10" HorizontalOptions="End" MaximumWidthRequest="620">
              <Label Text="{Binding Text}" TextColor="{StaticResource Txt1}" FontSize="{StaticResource FontSizeBody}"/>
            </Border>
          </DataTemplate>
        </claude:ClaudeMsgSelector.UserTemplate>
        <claude:ClaudeMsgSelector.CmdTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource BgSide}" StrokeShape="RoundRectangle 8" Padding="16,8" HorizontalOptions="End">
              <Label Text="{Binding Text}" TextColor="{StaticResource Accent}" FontAttributes="Bold"/>
            </Border>
          </DataTemplate>
        </claude:ClaudeMsgSelector.CmdTemplate>
        <claude:ClaudeMsgSelector.AiTemplate>
          <DataTemplate>
            <StackLayout Spacing="4">
              <Label Text="{Binding Text}" TextColor="{StaticResource Txt1}" FontSize="{StaticResource FontSizeBody}"/>
              <Label Text="⧉ ⚲ 🔊  il y a 4 minutes" TextColor="{DynamicResource MotoSubtleText}" FontSize="11"/>
            </StackLayout>
          </DataTemplate>
        </claude:ClaudeMsgSelector.AiTemplate>
        <claude:ClaudeMsgSelector.BoxTemplate>
          <DataTemplate>
            <Border Stroke="{DynamicResource BorderCol}" StrokeShape="RoundRectangle 12" Padding="16,12">
              <StackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="4">
                <BindableLayout.ItemTemplate>
                  <DataTemplate><Label Text="{Binding .}" TextColor="{StaticResource Txt1}"/></DataTemplate>
                </BindableLayout.ItemTemplate>
              </StackLayout>
            </Border>
          </DataTemplate>
        </claude:ClaudeMsgSelector.BoxTemplate>
        <claude:ClaudeMsgSelector.ActTemplate>
          <DataTemplate>
            <StackLayout Spacing="2">
              <StackLayout Orientation="Horizontal" Spacing="8">
                <Button Text="›" Style="{StaticResource CcIconBtn}" WidthRequest="18" HeightRequest="18"
                        Clicked="OnActChevronClicked" BindingContext="{Binding .}"/>
                <Label Text="{Binding Text}" TextColor="{StaticResource Txt2}" FontSize="{StaticResource FontSizeBody}"/>
                <Label Text="{Binding Add, StringFormat='+{0}'}" Style="{StaticResource CcMono}" TextColor="#7EC699"/>
                <Label Text="{Binding Del, StringFormat='-{0}'}" Style="{StaticResource CcMono}" TextColor="#F28B82"/>
              </StackLayout>
              <Label IsVisible="{Binding ShowDetails}" Style="{StaticResource CcMono}"
                     Text="→ détail : fichier MainPage.Panels.cs · statut ok (0 erreur)"
                     TextColor="{DynamicResource MotoSubtleText}"/>
            </StackLayout>
          </DataTemplate>
        </claude:ClaudeMsgSelector.ActTemplate>
        <claude:ClaudeMsgSelector.SysTemplate>
          <DataTemplate>
            <Label Text="{Binding Text}" HorizontalTextAlignment="Center"
                   TextColor="{DynamicResource MotoSubtleText}" FontSize="11.5"/>
          </DataTemplate>
        </claude:ClaudeMsgSelector.SysTemplate>
      </claude:ClaudeMsgSelector>
    </ResourceDictionary>
  </ContentView.Resources>

  <Grid RowDefinitions="44,*" Background="{DynamicResource BgSide}">

    <!-- ══ TOPBAR ══ -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" Padding="10,0">
      <!-- ★ CORRIGÉ (03/09) : Button.Flyout/MenuFlyout n'existent pas en MAUI
           cross-plateforme (API WinUI native que Qwen a supposée disponible
           telle quelle) — remplacé par DisplayActionSheet, le vrai mécanisme
           de menu déjà utilisé ailleurs dans ce dépôt (MainPage.UI.cs). Voir
           OnMenuClicked dans le code-behind. -->
      <Button Grid.Column="0" Text="☰" Style="{StaticResource CcIconBtn}" Clicked="OnMenuClicked"/>
      <Button Grid.Column="1" Text="▯" Style="{StaticResource CcIconBtn}" Clicked="OnToggleSidebar"/>
      <Button Grid.Column="2" Text="🔍" Style="{StaticResource CcIconBtn}" Clicked="OnSearchClicked"/>
      <Button Grid.Column="3" Text="←" Style="{StaticResource CcIconBtn}"/>
      <Button Grid.Column="4" Text="→" Style="{StaticResource CcIconBtn}"/>
      <Button Grid.Column="6" Text="─" Style="{StaticResource CcIconBtn}" Clicked="OnWindowMinClicked"/>
      <Button Grid.Column="7" Text="□" Style="{StaticResource CcIconBtn}" Clicked="OnWindowMaxClicked"/>
      <Button Grid.Column="8" Text="✕" Style="{StaticResource CcIconBtn}" Clicked="OnWindowCloseClicked"/>
    </Grid>

    <!-- ══ CORPS ══ -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,6,*,Auto">

      <!-- SIDEBAR -->
      <Grid Grid.Column="0" WidthRequest="280" x:Name="SidebarBox"
            RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource BgSide}">
        <Grid Grid.Row="0" ColumnDefinitions="*,*" Padding="12,12,12,6">
          <Button Text="Chat et Cowork" Style="{StaticResource CcSegBtn}" Clicked="OnTabCowork"/>
          <Button Grid.Column="1" Text="&lt;/&gt; Code" Style="{StaticResource CcSegBtn}" Clicked="OnTabCode"/>
        </Grid>
        <!-- Haut onglet Code -->
        <StackLayout Grid.Row="1" x:Name="CodeTop" Spacing="2" Padding="12,0">
          <Button Text="＋ Nouveau" Style="{StaticResource CcSegBtn}" HorizontalOptions="Fill" Clicked="OnMenuNewSession"/>
          <Button Text="🗀 Artéfacts" Style="{StaticResource CcSegBtn}" HorizontalOptions="Fill" Clicked="OnNavArtifacts"/>
          <Button Text="🗃 Personnaliser" Style="{StaticResource CcSegBtn}" HorizontalOptions="Fill" Clicked="OnNavCustomize"/>
        </StackLayout>
        <!-- Haut onglet Cowork -->
        <StackLayout Grid.Row="1" x:Name="CoworkTop" IsVisible="False" Spacing="2" Padding="12,0">
          <Button Text="＋ Nouveau" Style="{StaticResource CcSegBtn}" HorizontalOptions="Fill"/>
          <Button Text="🗀 Projets" Style="{StaticResource CcSegBtn}" HorizontalOptions="Fill" Clicked="OnNavProjects"/>
          <Button Text="🗃 Artéfacts" Style="{StaticResource CcSegBtn}" HorizontalOptions="Fill" Clicked="OnNavArtifacts"/>
          <Button Text="🕐 Programmé" Style="{StaticResource CcSegBtn}" HorizontalOptions="Fill" Clicked="OnNavScheduled"/>
          <Button Text="🗃 Personnaliser" Style="{StaticResource CcSegBtn}" HorizontalOptions="Fill" Clicked="OnNavCustomize"/>
        </StackLayout>
        <ScrollView Grid.Row="2">
          <StackLayout x:Name="SessionsList" BindableLayout.ItemsSource="{Binding Sessions}" Padding="12,4">
            <BindableLayout.ItemTemplate>
              <DataTemplate>
                <StackLayout Spacing="0">
                  <Label Text="{Binding Title}" TextColor="{StaticResource Txt2}"
                         FontSize="{StaticResource FontSizeBody}" Padding="14,6"/>
                </StackLayout>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </StackLayout>
        </ScrollView>
        <StackLayout Grid.Row="3" Padding="10,6" >
          <!-- ★ CORRIGÉ (03/09) : même correctif que le menu ☰ ci-dessus
               (Button.Flyout n'existe pas en MAUI). -->
          <Button Text="T  Tom · Pro ⌄" Style="{StaticResource CcSegBtn}" HorizontalOptions="Start" Clicked="OnUserMenuClicked"/>
        </StackLayout>
      </Grid>

      <!-- POIGNÉE (réduire / redimensionner) -->
      <BoxView Grid.Column="1" x:Name="SidebarHandle" WidthRequest="6" Color="{DynamicResource BorderCol}"
               HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="38">
        <BoxView.GestureRecognizers>
          <PanGestureRecognizer PanUpdated="OnSidebarPanUpdated"/>
        </BoxView.GestureRecognizers>
      </BoxView>

      <!-- ZONE PRINCIPALE -->
      <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">

        <!-- En-tête chat -->
        <StackLayout Grid.Row="0" Orientation="Horizontal" Spacing="9" Padding="16,10"
                     x:Name="ChatHeader">
          <Label Text="💻" />
          <Label Text="MOTO Editor - Part1" FontAttributes="Bold"
                 TextColor="{StaticResource Txt1}"/>
          <Border Stroke="{DynamicResource BorderCol}" Background="{DynamicResource BgPanel}"
                  StrokeShape="RoundRectangle 6" Padding="9,3">
            <Label Text="Projet logiciel" FontSize="11" TextColor="{StaticResource Txt2}"/>
          </Border>
          <StackLayout HorizontalOptions="End" Orientation="Horizontal">
            <Button Text="&gt;_" Style="{StaticResource CcIconBtn}" Clicked="OnToggleTerminal"/>
            <Button Text="▤"  Style="{StaticResource CcIconBtn}" Clicked="OnToggleTasks"/>
            <Button Text="🌐" Style="{StaticResource CcIconBtn}" Clicked="OnToggleBrowser"/>
          </StackLayout>
        </StackLayout>

        <!-- CONTENU commuté -->
        <Grid Grid.Row="1">
          <!-- CHAT -->
          <CollectionView x:Name="ChatList" ItemsSource="{Binding Messages}"
                          ItemTemplate="{StaticResource MsgSelector}" SelectionMode="None"/>
          <!-- ACCUEIL -->
          <ScrollView x:Name="HomePanel" IsVisible="False">
            <StackLayout Padding="30,26" Spacing="14">
              <Label Text="✳ Quoi de prévu, Tom ?" FontSize="{StaticResource FontSizeTitle}" FontAttributes="Bold"
                     TextColor="{StaticResource Txt1}"/>
              <Border Style="{StaticResource CcCard}" Padding="16" MaximumWidthRequest="640">
                <StackLayout Spacing="10">
                  <StackLayout BindableLayout.ItemsSource="{Binding HomeStats}">
                    <BindableLayout.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{DynamicResource BgSide}" Stroke="{DynamicResource BorderCol}"
                                StrokeShape="RoundRectangle 8" Padding="10,8" Margin="3">
                          <StackLayout>
                            <Label Text="{Binding Label}" FontSize="11" TextColor="{StaticResource Txt2}"/>
                            <Label Text="{Binding Value}" FontSize="{StaticResource FontSizeSubheading}" FontAttributes="Bold"
                                   TextColor="{StaticResource Txt1}"/>
                          </StackLayout>
                        </Border>
                      </DataTemplate>
                    </BindableLayout.ItemTemplate>
                  </StackLayout>
                  <GraphicsView x:Name="HeatmapView" HeightRequest="120"/>
                  <Label Text="Vous avez utilisé ~51× plus de tokens que War and Peace."
                         FontSize="11.5" TextColor="{DynamicResource MotoSubtleText}"/>
                </StackLayout>
              </Border>
            </StackLayout>
          </ScrollView>
          <!-- COWORK -->
          <ScrollView x:Name="CoworkPanel" IsVisible="False">
            <StackLayout Padding="40,26" Spacing="12">
              <Label Text="Projets / WebSite" FontSize="{StaticResource FontSizeBody}" TextColor="{StaticResource Txt2}"/>
              <Label Text="{Binding CurrentProject}" Style="{StaticResource CcSerifTitle}"/>
              <Border Style="{StaticResource CcCard}" Padding="0" MaximumWidthRequest="880">
                <StackLayout>
                  <Editor x:Name="CoworkInput" Placeholder="Comment puis-je vous aider ?"
                          AutoSize="TextChanges" MinimumHeightRequest="60" Margin="14,10"
                          BackgroundColor="Transparent"/>
                  <StackLayout Orientation="Horizontal" Padding="12,0,12,10" Spacing="6">
                    <Button Text="＋" Style="{StaticResource CcIconBtn}"/>
                    <Border Background="{DynamicResource BgSide}" StrokeShape="RoundRectangle 8" Padding="2">
                      <StackLayout Orientation="Horizontal">
                        <Button Text="Chat" Style="{StaticResource CcSegBtn}"/>
                        <Button Text="Cowork" Style="{StaticResource CcSegBtn}" Background="{DynamicResource BgPanel}"/>
                      </StackLayout>
                    </Border>
                    <Label HorizontalOptions="End"/>
                    <Button Text="Opus 5" Style="{StaticResource CcSegBtn}"/>
                    <Button Text="Élevé" Style="{StaticResource CcSegBtn}"/>
                  </StackLayout>
                </StackLayout>
              </Border>
              <Label Text="Donnez une tâche à Claude et il récupérera automatiquement le contexte de votre projet."
                     HorizontalTextAlignment="Center" TextColor="{DynamicResource MotoSubtleText}" Margin="0,60,0,0"/>
            </StackLayout>
          </ScrollView>
          <!-- PERSONNALISER -->
          <ScrollView x:Name="CustomizePanel" IsVisible="False">
            <StackLayout Padding="60,30" Spacing="14">
              <Label Text="Personnaliser" Style="{StaticResource CcSerifTitle}"/>
              <StackLayout Orientation="Horizontal" Spacing="8">
                <Button Text="Compétences" Style="{StaticResource CcSegBtn}" Background="{DynamicResource BgPanel}"/>
                <Button Text="Connecteurs" Style="{StaticResource CcSegBtn}"/>
                <Button Text="Plugins" Style="{StaticResource CcSegBtn}"/>
                <Label WidthRequest="20"/>
                <Button Text="Les vôtres" Style="{StaticResource CcSegBtn}" Background="{DynamicResource BgPanel}"/>
                <Button Text="Parcourir" Style="{StaticResource CcSegBtn}"/>
                <Label HorizontalOptions="End"/>
                <Button Text="Ajouter ⌄" Background="#F2F0EC" TextColor="#171512" CornerRadius="{StaticResource RadiusMd}" HeightRequest="34"/>
              </StackLayout>
              <Border Style="{StaticResource CcCard}" Padding="22">
                <StackLayout Spacing="8">
                  <Label Text="Ajoutez vos premières compétences." FontAttributes="Bold"
                         TextColor="{StaticResource Txt1}"/>
                  <Label Text="Les compétences apprennent à Claude comment vous travaillez. Ajoutez-les depuis Discover ou créez les vôtres."
                         TextColor="{StaticResource Txt2}"/>
                  <StackLayout Orientation="Horizontal" Spacing="10">
                    <Button Text="Parcourir Discover" Background="#F2F0EC" TextColor="#171512" CornerRadius="{StaticResource RadiusMd}"/>
                    <Button Text="En savoir plus" Background="{DynamicResource BgPanel}" CornerRadius="{StaticResource RadiusMd}"/>
                  </StackLayout>
                </StackLayout>
              </Border>
              <StackLayout BindableLayout.ItemsSource="{Binding Skills}" Spacing="0">
                <BindableLayout.ItemTemplate>
                  <DataTemplate>
                    <StackLayout Orientation="Horizontal" Padding="4,14" Spacing="12">
                      <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 8"
                              Background="{DynamicResource BgSide}" Stroke="{DynamicResource BorderCol}">
                        <Label Text="📄" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                      </Border>
                      <StackLayout HorizontalOptions="FillAndExpand">
                        <Label Text="{Binding Name}" FontAttributes="Bold"
                               TextColor="{StaticResource Txt1}"/>
                        <Label Text="{Binding Desc}" FontSize="{StaticResource FontSizeBody}" LineBreakMode="TailTruncation"
                               TextColor="{StaticResource Txt2}"/>
                      </StackLayout>
                      <Label Text="{Binding When}" TextColor="{DynamicResource MotoSubtleText}"/>
                      <Button Text="⋮" Style="{StaticResource CcIconBtn}"/>
                    </StackLayout>
                  </DataTemplate>
                </BindableLayout.ItemTemplate>
              </StackLayout>
            </StackLayout>
          </ScrollView>
          <!-- ARTÉFACTS -->
          <ScrollView x:Name="ArtifactsPanel" IsVisible="False">
            <StackLayout Padding="60,30" Spacing="14">
              <StackLayout Orientation="Horizontal">
                <Label Text="Artéfacts" Style="{StaticResource CcSerifTitle}"/>
                <Label HorizontalOptions="End"/>
                <Button Text="🔍" Style="{StaticResource CcIconBtn}"/>
                <Button Text="Nouvel artéfact" Background="#F2F0EC" TextColor="#171512" CornerRadius="{StaticResource RadiusMd}"/>
              </StackLayout>
              <StackLayout Orientation="Horizontal" Spacing="6">
                <Button Text="Tous" Style="{StaticResource CcSegBtn}" Background="{DynamicResource BgPanel}"/>
                <Button Text="Épinglé" Style="{StaticResource CcSegBtn}"/>
                <Button Text="Les vôtres" Style="{StaticResource CcSegBtn}"/>
                <Button Text="Partagé avec vous." Style="{StaticResource CcSegBtn}"/>
              </StackLayout>
              <CollectionView ItemsSource="{Binding Artifacts}" SelectionMode="None"
                              ItemsLayout="HorizontalList">
                <CollectionView.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource CcCard}" WidthRequest="320" Margin="0,0,20,0">
                      <StackLayout Spacing="0">
                        <Border Background="#0F1114" HeightRequest="180" StrokeThickness="0">
                          <Label Text="{Binding Kind}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                 TextColor="{DynamicResource MotoSubtleText}"/>
                        </Border>
                        <StackLayout Padding="16,14">
                          <Label Text="{Binding Title}" FontAttributes="Bold"
                                 TextColor="{StaticResource Txt1}"/>
                          <Label Text="{Binding When}" FontSize="{StaticResource FontSizeBody}" TextColor="{DynamicResource MotoSubtleText}"/>
                        </StackLayout>
                      </StackLayout>
                    </Border>
                  </DataTemplate>
                </CollectionView.ItemTemplate>
              </CollectionView>
            </StackLayout>
          </ScrollView>
        </Grid>

        <!-- ZONE BASSE (chat) -->
        <StackLayout Grid.Row="2" x:Name="BottomZone" Padding="24,0,24,10" MaximumWidthRequest="900">
          <Border Background="{DynamicResource BgSide}" Stroke="{DynamicResource BorderCol}"
                  StrokeShape="RoundRectangle 12" Padding="15,10,46,10">
            <Grid ColumnDefinitions="*,Auto">
              <Entry x:Name="ChatInput" Placeholder="Tapez / pour les commandes."
                     BackgroundColor="Transparent" Completed="OnSendClicked"
                     Text="{Binding InputText, Mode=TwoWay}"/>
              <Button Grid.Column="1" Text="◼" Style="{StaticResource CcIconBtn}" Clicked="OnStopClicked"/>
            </Grid>
          </Border>
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" Padding="0,8,0,0">
            <Button Grid.Column="0" Text="Auto" Style="{StaticResource CcSegBtn}"/>
            <Button Grid.Column="1" Text="＋" Style="{StaticResource CcIconBtn}"/>
            <Button Grid.Column="2" Text="🎙" Style="{StaticResource CcIconBtn}"/>
            <Button Grid.Column="4" Text="Sonnet 5" Style="{StaticResource CcSegBtn}"/>
            <Button Grid.Column="5" Text="Ultracode" Style="{StaticResource CcSegBtn}"/>
            <Border Grid.Column="6" WidthRequest="15" HeightRequest="15" Stroke="{StaticResource Accent}"
                    StrokeThickness="2" StrokeShape="RoundRectangle 6">
              <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnContextTapped"/>
              </Border.GestureRecognizers>
            </Border>
          </Grid>
        </StackLayout>
      </Grid>

      <!-- PANNEAUX DROITS -->
      <Grid Grid.Column="3" x:Name="RightHost" WidthRequest="470" IsVisible="False"
            Background="{DynamicResource BgSide}">
        <!-- Terminal -->
        <Grid x:Name="TermPanel" IsVisible="False" RowDefinitions="Auto,*,Auto">
          <Label Grid.Row="0" Text="Terminal ＋" Padding="14,10" FontAttributes="Bold"
                 TextColor="{StaticResource Txt1}"/>
          <ScrollView Grid.Row="1" x:Name="TermScroll">
            <Label x:Name="TermOut" Style="{StaticResource CcMono}" Padding="14,6"
                   TextColor="{StaticResource Txt2}"/>
          </ScrollView>
          <Entry Grid.Row="2" x:Name="TermIn" Completed="OnTermCommand" Placeholder="PS E:\Corpus\MOTO-Editor>"
                 BackgroundColor="Transparent" Style="{StaticResource CcMono}"/>
        </Grid>
        <!-- Navigateur -->
        <Grid x:Name="BrowserPanel" IsVisible="False" RowDefinitions="Auto,Auto,*">
          <Label Grid.Row="0" Text="Nouvel onglet ＋" Padding="14,10" FontAttributes="Bold"
                 TextColor="{StaticResource Txt1}"/>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Padding="12,0,12,8">
            <Button Grid.Column="0" Text="←" Style="{StaticResource CcIconBtn}"/>
            <Button Grid.Column="1" Text="→" Style="{StaticResource CcIconBtn}"/>
            <Button Grid.Column="2" Text="⟳" Style="{StaticResource CcIconBtn}" Clicked="OnBrowserReload"/>
            <Entry Grid.Column="3" x:Name="BrowserUrl" Placeholder="Saisissez une URL"
                   Background="{DynamicResource BgSide}" Completed="OnBrowserNavigate"/>
            <Button Grid.Column="4" Text="⧉" Style="{StaticResource CcIconBtn}"/>
          </Grid>
          <WebView Grid.Row="2" x:Name="BrowserWeb"/>
        </Grid>
        <!-- Tâches -->
        <Grid x:Name="TasksPanel" IsVisible="False" RowDefinitions="Auto,*,Auto">
          <Label Grid.Row="0" Text="Tâches en arrière-plan" Padding="14,10" FontAttributes="Bold"
                 TextColor="{StaticResource Txt1}"/>
          <ScrollView Grid.Row="1">
            <StackLayout Padding="14,0" Spacing="10">
              <Border Style="{StaticResource CcCard}" Padding="14">
                <StackLayout Spacing="8">
                  <Label Text="moto-modularity-scoping" FontAttributes="Bold"
                         TextColor="{StaticResource Txt1}"/>
                  <Label Text="Workflow 4min 29s · 5 agents · 646.4k tokens" FontSize="{StaticResource FontSizeBody}"
                         TextColor="{StaticResource Txt2}"/>
                  <Label Text="Cartographier la modularité actuelle de MOTO Editor vs Zed/VS Code (panneaux, commandes, réglages, plugins, persistance) pour proposer les prochaines briques homemade"
                         FontSize="{StaticResource FontSizeBody}" TextColor="{StaticResource Txt2}"/>
                  <Label Text="Phases — Cartographier 4/5" FontAttributes="Bold" Margin="0,6,0,0"
                         TextColor="{StaticResource Txt1}"/>
                  <CollectionView ItemsSource="{Binding Agents}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" Padding="4,6">
                          <Label Text="{Binding Name}" TextColor="{StaticResource Txt2}"/>
                          <Label Grid.Column="1" Text="{Binding Model}" WidthRequest="80"
                                 TextColor="{StaticResource Txt2}"/>
                          <Label Grid.Column="2" Text="{Binding Tokens}" WidthRequest="70"
                                 TextColor="{StaticResource Txt2}"/>
                          <Label Grid.Column="3" Text="{Binding Time}" WidthRequest="70"
                                 TextColor="{StaticResource Txt2}"/>
                        </Grid>
                      </DataTemplate>
                    </CollectionView.ItemTemplate>
                  </CollectionView>
                </StackLayout>
              </Border>
            </StackLayout>
          </ScrollView>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Padding="14,10">
            <Button Text="Terminé 51 ›" Style="{StaticResource CcSegBtn}" HorizontalOptions="Start"/>
            <Button Grid.Column="1" Text="Effacer" Style="{StaticResource CcSegBtn}"/>
          </Grid>
        </Grid>
        <!-- Transcription -->
        <ScrollView x:Name="TransPanel" IsVisible="False">
          <StackLayout Padding="20,14" Spacing="10">
            <Label Text="C'était bien moi — corrigé" FontSize="{StaticResource FontSizeHeading}" FontAttributes="Bold"
                   TextColor="{StaticResource Txt1}"/>
            <Label Text="J'ai trouvé et réparé le problème : c'est l'ajout du support MSIX de tout à l'heure qui a cassé le lancement normal (WindowsAppSDKSelfContained en conflit avec le nouveau fichier MSIX)."
                   TextColor="{StaticResource Txt1}"/>
            <Border Background="#171614" StrokeShape="RoundRectangle 8" Padding="14">
              <Label Style="{StaticResource CcMono}" TextColor="#7EC699"
                     Text="dotnet run --project &quot;E:\Corpus\MOTO-Editor\Moto.Editor\Moto.Editor.csproj&quot;"/>
            </Border>
            <!-- Dialogue d'erreur Windows reproduit -->
            <Border Stroke="#1B5E97" StrokeShape="RoundRectangle 6" Padding="0">
              <StackLayout>
                <Label Text="Moto.Editor.exe - This application could not be started   ✕"
                       Background="#0078D7" TextColor="White" FontSize="11.5" Padding="9,5"/>
                <StackLayout Background="#F0F0F0" Padding="16" Spacing="6">
                  <Label Text="❌ This application requires the Windows App Runtime Version 1.5 (MSIX package version >= 5001.214.1843.0). Do you want to install a compatible Windows App Runtime now?"
                         TextColor="#1A1A1A" FontSize="{StaticResource FontSizeBody}"/>
                  <StackLayout Orientation="Horizontal" HorizontalOptions="End" Spacing="8">
                    <Button Text="Oui" Background="#E1E1E1" TextColor="#1A1A1A" WidthRequest="64"/>
                    <Button Text="Non" Background="#E1E1E1" TextColor="#1A1A1A" WidthRequest="64"/>
                  </StackLayout>
                </StackLayout>
              </StackLayout>
            </Border>
          </StackLayout>
        </ScrollView>
      </Grid>
    </Grid>

    <!-- ══ OVERLAYS ══ -->
    <!-- Feedback -->
    <Grid x:Name="FeedbackOverlay" IsVisible="False" Background="#80000000">
      <Border Background="{DynamicResource BgPanel}" Stroke="{DynamicResource BorderCol}"
              StrokeShape="RoundRectangle 12" WidthRequest="560" Padding="22"
              VerticalOptions="Center">
        <StackLayout Spacing="12">
          <Label Text="Envoyer des commentaires" FontAttributes="Bold"
                 TextColor="{StaticResource Txt1}"/>
          <Editor x:Name="FeedbackText" Placeholder="Décrivez le problème" MinimumHeightRequest="120"
                  Background="{DynamicResource BgSide}"/>
          <Label Text="Ce rapport inclura votre description et la transcription de la session en cours. Nous pouvons les utiliser pour déboguer les problèmes associés et améliorer Claude Code."
                 FontSize="{StaticResource FontSizeBody}" TextColor="{StaticResource Txt2}"/>
          <StackLayout Orientation="Horizontal" HorizontalOptions="End" Spacing="9">
            <Button Text="Annuler" Clicked="OnFeedbackCancel" Background="{DynamicResource BgPanel}"/>
            <Button Text="Envoyer" Clicked="OnFeedbackSend" Background="{DynamicResource BgPanel}"/>
          </StackLayout>
        </StackLayout>
      </Border>
    </Grid>

    <!-- Popover contexte -->
    <Border x:Name="ContextPop" IsVisible="False" Background="{DynamicResource BgPanel}"
            Stroke="{DynamicResource BorderCol}" StrokeShape="RoundRectangle 12"
            WidthRequest="360" Padding="16" HorizontalOptions="End" VerticalOptions="End"
            Margin="0,0,24,86">
      <StackLayout Spacing="8">
        <Label Text="Fenêtre de contexte — 583.4k / 1M (58%)"
               TextColor="{StaticResource Txt1}"/>
        <ProgressBar Progress="0.58" ProgressColor="{StaticResource Accent}"/>
        <Label Text="Limite de 5 heures — Réinitialisation dans 1 h 26 min — 63%" FontSize="{StaticResource FontSizeBody}"
               TextColor="{StaticResource Txt2}"/>
        <ProgressBar Progress="0.63" ProgressColor="{StaticResource Accent}"/>
        <Label Text="Hebdomadaire — Réinitialisation sam. 19:00 — 60%" FontSize="{StaticResource FontSizeBody}"
               TextColor="{StaticResource Txt2}"/>
        <ProgressBar Progress="0.60" ProgressColor="{StaticResource Accent}"/>
        <Button Text="Voir la répartition détaillée" Style="{StaticResource CcSegBtn}" HorizontalOptions="Start"/>
      </StackLayout>
    </Border>
  </Grid>
</ContentView>
