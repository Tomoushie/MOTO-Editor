<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Moto.Editor.Views.BenchmarkComparisonView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource MotoBackgroundColor}">

    <Grid RowDefinitions="Auto, *" Padding="16">

        <!-- En-tête -->
        <StackLayout Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <Label Text="📊" FontSize="28" VerticalOptions="Center" />
            <StackLayout>
                <Label Text="Benchmark Comparison" FontSize="20" FontAttributes="Bold"
                       TextColor="{StaticResource MotoAccentColor}" />
                <Label Text="Comparaison de tous les tiers côte à côte"
                       FontSize="12" TextColor="{StaticResource MotoSecondaryTextColor}" />
            </StackLayout>
        </StackLayout>

        <!-- Tableau de comparaison -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="ComparisonContainer" Spacing="12" />
        </ScrollView>

    </Grid>
</ContentView>
