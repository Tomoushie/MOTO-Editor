<!-- Moto.Editor/Views/ThreadListView.xaml -->
<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.ThreadListView"
             BackgroundColor="#141519">

    <Grid RowDefinitions="Auto,Auto,*" Padding="6">

        <!-- Recherche dans les threads -->
        <Entry Grid.Row="0" x:Name="SearchEntry"
               Placeholder="Rechercher les conversations…"
               BackgroundColor="Transparent" FontSize="12"
               TextChanged="OnSearchChanged" />

        <Button Grid.Row="1" Text="＋ Nouvelle conversation"
                FontSize="12" Padding="6,4"
                Clicked="OnNewThreadClicked" />

        <!-- Liste des threads -->
        <CollectionView Grid.Row="2" x:Name="ThreadList" SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="8,6" Spacing="2">
                        <Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold" />
                        <Label Text="{Binding TimeLabel}" FontSize="10" Opacity="0.5" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentView>
