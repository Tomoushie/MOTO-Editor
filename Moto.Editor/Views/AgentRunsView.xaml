<!-- Moto.Editor/Views/AgentRunsView.xaml
     Panneau "Agents en cours" (jalon 3) : première vraie interface du chantier
     agents autonomes (jalon 1/2 n'en avaient aucune, tout passait par le chat).
     Même patron que BackgroundTasksView.xaml (liste live + minuteur), plus une
     petite liste "Messages entre agents" (AgentMessageBus.History) et un accès
     au dossier des journaux NDJSON.
     AJOUT (24/09, agent v2) : l'activité en direct, le résultat d'un run (fichiers
     modifiés, modèle, résumé, avertissement) et le bouton "Annuler les modifications". -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.AgentRunsView"
             BackgroundColor="{DynamicResource BgSide}">

  <Grid RowDefinitions="Auto,2*,Auto,Auto,1*,Auto">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="14,10">
      <Label Text="Agents en cours" FontAttributes="Bold" TextColor="{StaticResource Txt1}"/>
      <Label Grid.Column="1" x:Name="ActiveCountLabel" Text="0 actif(s)"
             TextColor="{DynamicResource MotoSubtleText}" FontSize="{StaticResource FontSizeBody}"/>
    </Grid>

    <CollectionView Grid.Row="1" x:Name="RunList" SelectionMode="None" Margin="10,0">
      <CollectionView.EmptyView>
        <Label Text="Aucun agent pour l'instant. Tape /agent &lt;objectif&gt; dans le chat pour en démarrer un."
               TextColor="{DynamicResource MotoSubtleText}" FontSize="{StaticResource FontSizeBody}"
               Padding="10,20" HorizontalTextAlignment="Center"/>
      </CollectionView.EmptyView>
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Border Background="{DynamicResource BgPanel}" Stroke="{DynamicResource BorderCol}"
                  StrokeShape="RoundRectangle 8" Padding="12,10" Margin="0,0,0,8">
            <!-- Une pile plutôt qu'une grille : une ligne masquée (pas d'activité, pas d'avertissement…) ne laisse pas d'espace vide. -->
            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                <Label Grid.Column="0" Text="{Binding StatusIcon}"
                       TextColor="{StaticResource Accent}" FontSize="{StaticResource FontSizeBody}"/>
                <Label Grid.Column="1" Text="{Binding AgentId}" FontAttributes="Bold"
                       TextColor="{StaticResource Txt1}" FontSize="{StaticResource FontSizeBody}" LineBreakMode="TailTruncation"/>
                <Label Grid.Column="2" Text="{Binding DurationLabel}"
                       TextColor="{DynamicResource MotoSubtleText}" FontSize="{StaticResource FontSizeBody}"/>
              </Grid>

              <Label Text="{Binding Goal}"
                     TextColor="{DynamicResource MotoSubtleText}" FontSize="11.5" LineBreakMode="TailTruncation"/>

              <!-- En cours : ce que l'agent fait à l'instant. -->
              <Label Text="{Binding Activity}" IsVisible="{Binding HasActivity}"
                     TextColor="{StaticResource Accent}" FontSize="11.5" LineBreakMode="TailTruncation"/>

              <!-- Fini : combien de fichiers ont changé, avec quel modèle, puis le résumé du modèle. -->
              <Label Text="{Binding ResultLine}" IsVisible="{Binding HasResultLine}"
                     TextColor="{StaticResource Txt1}" FontSize="11.5" LineBreakMode="TailTruncation"/>
              <Label Text="{Binding Summary}" IsVisible="{Binding HasSummary}"
                     TextColor="{DynamicResource MotoSubtleText}" FontSize="11.5" MaxLines="3" LineBreakMode="TailTruncation"/>
              <Label Text="{Binding Warning, StringFormat='⚠ {0}'}" IsVisible="{Binding HasWarning}"
                     TextColor="{StaticResource Warning}" FontSize="11.5" MaxLines="3" LineBreakMode="TailTruncation"/>

              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                <Label Grid.Column="0" Text="{Binding StatusLabel}" VerticalOptions="Center"
                       TextColor="{DynamicResource MotoSubtleText}" FontSize="11"/>
                <Button Grid.Column="1" Text="Arrêter" FontSize="11" Padding="8,3"
                        IsVisible="{Binding IsActive}"
                        BackgroundColor="Transparent" TextColor="{StaticResource Warning}"
                        Clicked="OnCancelRunClicked" CommandParameter="{Binding Id}"/>
                <Button Grid.Column="2" Text="Annuler les modifications" FontSize="11" Padding="8,3"
                        IsVisible="{Binding CanUndo}"
                        BackgroundColor="Transparent" TextColor="{StaticResource Accent}"
                        Clicked="OnUndoRunClicked" CommandParameter="{Binding Id}"/>
              </Grid>
            </VerticalStackLayout>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>

    <BoxView Grid.Row="2" HeightRequest="1" Color="{DynamicResource BorderCol}" Margin="14,4"/>

    <Label Grid.Row="3" Text="Messages entre agents" FontAttributes="Bold" FontSize="{StaticResource FontSizeBody}"
           TextColor="{StaticResource Txt1}" Padding="14,8,14,4"/>

    <CollectionView Grid.Row="4" x:Name="MessageList" SelectionMode="None" Margin="10,0">
      <CollectionView.EmptyView>
        <Label Text="Aucun échange pour l'instant."
               TextColor="{DynamicResource MotoSubtleText}" FontSize="{StaticResource FontSizeBody}" Padding="10,10"
               HorizontalTextAlignment="Center"/>
      </CollectionView.EmptyView>
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="Auto,*,Auto" Padding="4,3" ColumnSpacing="{StaticResource SpaceXs}">
            <Label Grid.Column="0" Text="{Binding Icon}" FontSize="11.5"/>
            <Label Grid.Column="1" Text="{Binding Label}" FontSize="11.5"
                   TextColor="{DynamicResource MotoSubtleText}" LineBreakMode="TailTruncation"/>
            <Label Grid.Column="2" Text="{Binding TimeLabel}" FontSize="{StaticResource FontSizeSmall}"
                   TextColor="{DynamicResource MotoSubtleText}"/>
          </Grid>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>

    <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Padding="14,8">
      <Label x:Name="BudgetLabel" Text="Budget IA : 0/200" TextColor="{DynamicResource MotoSubtleText}"
             FontSize="{StaticResource FontSizeBody}" VerticalOptions="Center"/>
      <Button Grid.Column="1" Text="Ouvrir le dossier des journaux" FontSize="{StaticResource FontSizeBody}" Padding="8,4"
              BackgroundColor="Transparent" TextColor="{DynamicResource MotoSubtleText}"
              Clicked="OnOpenAuditFolderClicked"/>
    </Grid>
  </Grid>
</ContentView>
