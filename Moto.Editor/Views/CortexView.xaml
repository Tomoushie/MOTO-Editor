<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.CortexView"
             BackgroundColor="#17181C">

    <Border StrokeShape="RoundRectangle 12" Stroke="#3A3B40"
            BackgroundColor="#1A1B1F" WidthRequest="460" Padding="14">

        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8">

            <Label Grid.Row="0" Text="🧠 MOTO Cortex Engine"
                   FontAttributes="Bold" FontSize="14" />

            <!-- Sélecteur de mode -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4">
                <Button Grid.Column="0" x:Name="BtnBeginner" Text="Débutant"
                        FontSize="10" Padding="4,4" Clicked="OnModeClicked" />
                <Button Grid.Column="1" x:Name="BtnBalanced" Text="Balanced"
                        FontSize="10" Padding="4,4" Clicked="OnModeClicked" />
                <Button Grid.Column="2" x:Name="BtnExpert" Text="Expert"
                        FontSize="10" Padding="4,4" Clicked="OnModeClicked" />
                <Button Grid.Column="3" x:Name="BtnTurbo" Text="Turbo"
                        FontSize="10" Padding="4,4" Clicked="OnModeClicked" />
                <Button Grid.Column="4" x:Name="BtnUltra" Text="Ultra"
                        FontSize="10" Padding="4,4" Clicked="OnModeClicked" />
            </Grid>

            <!-- Stats mémoire -->
            <Label Grid.Row="2" x:Name="StatsLabel"
                   Text="Mémoire : 0 habitudes · 0 patterns · 0 corrections"
                   FontSize="11" Opacity="0.7" />

            <!-- Conventions apprises -->
            <Label Grid.Row="3" x:Name="ConventionsLabel"
                   Text="Conventions : aucune apprise pour l'instant."
                   FontSize="11" Opacity="0.8" FontFamily="Consolas" />

            <!-- Suggestions -->
            <CollectionView Grid.Row="4" x:Name="SuggestionsList" HeightRequest="220">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 6" BackgroundColor="#202126"
                                Padding="8" Margin="0,3">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Title}"
                                       FontSize="12" FontAttributes="Bold" />
                                <Label Text="{Binding Description}"
                                       FontSize="10" Opacity="0.7" />
                                <Label Text="{Binding Confidence, StringFormat='Confiance : {0:P0}'}"
                                       FontSize="9" TextColor="LimeGreen" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

    </Border>

</ContentView>
