<?xml version="1.0" encoding="utf-8" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Moto.Editor.Views.SubscriptionOverlay">
    <Grid Background="{StaticResource OverlayBackgroundBrush}" Padding="32">
        <Border Background="{StaticResource PanelBackgroundBrush}"
                CornerRadius="12" Padding="24"
                MaxWidth="500" MaxHeight="400"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="16">
                <TextBlock Text="🚀 Cortex Booster Pro"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>

                <TextBlock Text="Mémoire cognitive avancée + apprentissage du style"
                           FontSize="14"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>

                <Border Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="8" Padding="16" Margin="0,8,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="✓ Souvenirs illimités" Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Text="✓ Apprentissage du style" Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Text="✓ Suggestions contextuelles" Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Text="✓ Support prioritaire" Foreground="{StaticResource PrimaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="2€ / mois"
                           FontSize="32" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center"/>

                <Button Content="💳 S'abonner via Stripe"
                        Click="OnSubscribeClicked"
                        HorizontalAlignment="Stretch"
                        Padding="16,12"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        FontSize="14" FontWeight="SemiBold"/>

                <Button Content="Annuler"
                        Click="OnCancelClicked"
                        HorizontalAlignment="Stretch"
                        Padding="16,8"
                        Background="Transparent"
                        Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
