<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.MarketplaceDashboardView"
             IsVisible="False" BackgroundColor="{StaticResource BgPanel}" WidthRequest="680">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="🛒 Marketplace Phase 3" FontSize="18" FontAttributes="Bold"
                   TextColor="{StaticResource Txt1}" VerticalOptions="Center"/>
            <Button Grid.Column="1" Text="✕" WidthRequest="30" HeightRequest="30"
                    BackgroundColor="Transparent" TextColor="{StaticResource Txt2}"
                    Clicked="OnCloseClicked"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Entry x:Name="SearchEntry" Placeholder="Rechercher un plugin…"
                   BackgroundColor="{StaticResource BgSide}" TextColor="{StaticResource Txt1}"
                   PlaceholderColor="{StaticResource Txt2}" TextChanged="OnSearchChanged"/>
            <Button Grid.Column="1" Text="🔄 Mises à jour" Clicked="OnCheckUpdatesClicked"/>
            <Button Grid.Column="2" Text="🔑 Login" Clicked="OnLoginClicked"/>
        </Grid>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout x:Name="PluginsList" Spacing="8"/>
        </ScrollView>

        <Label Grid.Row="3" x:Name="StatusLabel" Text="Prêt."
               FontSize="11" TextColor="{StaticResource Txt2}"/>
    </Grid>
</ContentView>
