<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.GlobalDashboardView"
             IsVisible="False" BackgroundColor="{StaticResource BgPanel}" WidthRequest="620">
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="📊 Tableau de bord global" FontSize="18" FontAttributes="Bold"
                   TextColor="{StaticResource Txt1}" VerticalOptions="Center"/>
            <Button Grid.Column="1" Text="✕" WidthRequest="30" HeightRequest="30"
                    BackgroundColor="Transparent" TextColor="{StaticResource Txt2}"
                    Clicked="OnCloseClicked"/>
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="ContentArea" Spacing="14"/>
        </ScrollView>
    </Grid>
</ContentView>
