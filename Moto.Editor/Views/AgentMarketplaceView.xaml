<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.AgentMarketplaceView">

    <Border Background="{DynamicResource MotoCardBackground}"
            Stroke="{DynamicResource MotoCardBorder}"
            StrokeThickness="1" Padding="{StaticResource SpaceMd}">
        <Border.StrokeShape><RoundRectangle CornerRadius="{StaticResource RadiusLg}" /></Border.StrokeShape>

        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource SpaceSm}">
            <Label Grid.Row="0" Text="🛒 Marketplace d'agents spécialisés"
                   FontSize="18" FontAttributes="Bold" />

            <CollectionView Grid.Row="1" x:Name="AgentsList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="{StaticResource SpaceSm}" Margin="0,6"
                                Background="{DynamicResource MotoSubtleBackground}"
                                Stroke="{DynamicResource MotoCardBorder}" StrokeThickness="1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="{StaticResource RadiusMd}" /></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}"
                                       FontSize="{StaticResource FontSizeSubheading}" FontAttributes="Bold" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Priority}"
                                       FontSize="11" Opacity="0.6" VerticalOptions="Center" />
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}"
                                       FontSize="{StaticResource FontSizeBody}" Opacity="0.8" Margin="0,4" />
                                <Button Grid.Row="2" Grid.Column="1" Text="Installer"
                                        Clicked="OnInstallClicked" CommandParameter="{Binding Id}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Grid.Row="2" x:Name="StatusLabel" Text="Prêt"
                   FontSize="{StaticResource FontSizeBody}" Opacity="0.6" />
        </Grid>
    </Border>
</ContentView>
