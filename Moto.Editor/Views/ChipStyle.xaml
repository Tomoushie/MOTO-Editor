<!-- Moto.Editor/Views/Home/ChipStyle.xaml (ResourceDictionary) -->
<Style x:Key="HomeChipStyle" TargetType="Border">
    <Setter Property="BackgroundColor" Value="{StaticResource BgPanel}" />
    <Setter Property="Stroke" Value="{StaticResource BgHover}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="StrokeShape">
        <RoundRectangle CornerRadius="8" />
    </Setter>
    <Setter Property="VisualStateManager.VisualStateGroups">
        <VisualStateGroupList>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <!-- PointerOver déclenche le même pattern que l'activity bar -->
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Property="BackgroundColor" Value="{StaticResource BgHover}" />
                        <Setter Property="Stroke" Value="{StaticResource Accent}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateGroupList>
    </Setter>
</Style>
