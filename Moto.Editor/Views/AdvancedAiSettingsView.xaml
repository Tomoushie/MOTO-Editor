<?xml version="1.0" encoding="utf-8" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Moto.Editor.Views.AdvancedAiSettingsView">
    <Grid Background="{StaticResource PanelBackgroundBrush}" Padding="20">
        <ScrollViewer>
            <StackPanel Spacing="16" MaxWidth="700">

                <!-- Header -->
                <StackPanel Spacing="4">
                    <TextBlock Text="⚙️ Optimisations IA avancées"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>
                    <TextBlock Text="Activez/désactivez les optimisations selon vos besoins."
                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Dual Model Routing -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="8" Padding="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔀" FontSize="24" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Dual Model Routing" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="Bascule auto 500M ↔ 7B selon la complexité. Gain latence : -70%."
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="DualStatsText" Text="Statut : --"
                                       FontSize="11" Foreground="{StaticResource AccentBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" x:Name="DualToggle"
                                      Toggled="OnDualToggled" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Speculative Decoding -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="8" Padding="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⚡" FontSize="24" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Speculative Decoding" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="Draft 500M + verify 7B. Gain tokens/s : ×2-3."
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="SpecStatsText" Text="Statut : --"
                                       FontSize="11" Foreground="{StaticResource AccentBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" x:Name="SpecToggle"
                                      Toggled="OnSpecToggled" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Layered Loading -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="8" Padding="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📦" FontSize="24" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Layered Loading + MoE" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="Chargement par couches. Réduit RAM active : -73% (4.5GB → 1.2GB)."
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="LayeredStatsText" Text="Statut : --"
                                       FontSize="11" Foreground="{StaticResource AccentBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" x:Name="LayeredToggle"
                                      Toggled="OnLayeredToggled" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Auto-activation -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="🤖 Auto-activation intelligente" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                        <CheckBox x:Name="AutoDualCheck" Content="Activer Dual Routing par défaut"
                                  Checked="OnAutoSettingsChanged" Unchecked="OnAutoSettingsChanged"/>
                        <CheckBox x:Name="AutoSpecCheck" Content="Activer Speculative si draft disponible"
                                  Checked="OnAutoSettingsChanged" Unchecked="OnAutoSettingsChanged"/>
                        <CheckBox x:Name="AutoLayeredCheck" Content="Activer Layered si RAM &lt; 8 GB"
                                  Checked="OnAutoSettingsChanged" Unchecked="OnAutoSettingsChanged"/>
                    </StackPanel>
                </Border>

                <!-- Benchmark -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="📊 Benchmark comparatif" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Text="Mesure le gain réel de chaque optimisation sur votre machine."
                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                        <Button Content="🏁 Lancer le benchmark" Click="OnBenchmarkClicked"
                                Padding="16,8" HorizontalAlignment="Left"
                                Background="{StaticResource AccentBrush}" Foreground="White"/>
                        <TextBlock x:Name="BenchmarkStatusText" Text=""
                                   FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Téléchargement modèles -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="⬇️ Modèles additionnels" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Text="Pour activer toutes les optimisations, téléchargez les modèles draft/small."
                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="⬇️ Tout télécharger (~1.3 GB)"
                                    Click="OnDownloadAllClicked" Padding="12,6"
                                    Background="{StaticResource AccentBrush}" Foreground="White"/>
                            <TextBlock x:Name="DownloadStatusText" Text=""
                                       FontSize="11" VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
