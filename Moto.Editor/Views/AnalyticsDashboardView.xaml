<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.AnalyticsDashboardView"
             BackgroundColor="{StaticResource BgPanel}"
             WidthRequest="500">

    <!-- ★ CORRECTION (02/09, état des lieux) : en-tête interne (titre "Analytics
         Dashboard" + ✕) retiré — ce panneau est sur AddFloatingPanel
         (MainPage.Panels.cs) depuis sa migration, qui fournit déjà ce même
         en-tête autour de CHAQUE panneau. Le garder ici affichait un double
         titre et deux boutons ✕ fonctionnels l'un sous l'autre (même
         correctif qu'AiChatView et PluginGalleryView). IsVisible retiré aussi
         : AddFloatingPanel gère la visibilité lui-même. -->
    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">

        <!-- Onglets -->
        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Button x:Name="TabTopBtn" Text="🏆 Top commandes"
                    BackgroundColor="{StaticResource Accent}"
                    TextColor="White" Clicked="OnTabTopClicked" />
            <Button x:Name="TabSuggestionsBtn" Text="💡 Suggestions"
                    BackgroundColor="{StaticResource BgSide}"
                    TextColor="{StaticResource Txt1}" Clicked="OnTabSuggestionsClicked" />
            <Button x:Name="TabHeatmapBtn" Text="🔥 Heatmap"
                    BackgroundColor="{StaticResource BgSide}"
                    TextColor="{StaticResource Txt1}" Clicked="OnTabHeatmapClicked" />
            <Button x:Name="TabExportBtn" Text="📤 Export"
                    BackgroundColor="{StaticResource BgSide}"
                    TextColor="{StaticResource Txt1}" Clicked="OnExportClicked" />
        </HorizontalStackLayout>

        <!-- Contenu -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="ContentArea" Spacing="12" />
        </ScrollView>

        <!-- Footer -->
        <Label Grid.Row="2" x:Name="FooterLabel"
               Text="Données en temps réel"
               FontSize="11" TextColor="{StaticResource Txt2}"
               HorizontalOptions="Center" />
    </Grid>
</ContentView>
