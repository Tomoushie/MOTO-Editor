<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.PresentationView"
             BackgroundColor="{StaticResource BgSide}">

    <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource BorderCol}"
            BackgroundColor="{StaticResource BgPanelInner}" WidthRequest="460" Padding="{StaticResource SpaceMd}">

        <VerticalStackLayout Spacing="{StaticResource SpaceSm}">

            <Label Text="🎤 Créer une présentation" FontAttributes="Bold" />

            <Picker x:Name="KindPicker" FontSize="{StaticResource FontSizeBody}">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Présentation projet</x:String>
                        <x:String>Estimation commerciale</x:String>
                        <x:String>Pitch</x:String>
                        <x:String>Slides techniques</x:String>
                        <x:String>Résumé exécutif</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Entry x:Name="ProjectEntry" Placeholder="Nom du projet" FontSize="{StaticResource FontSizeBody}" />
            <Entry x:Name="AuthorEntry" Placeholder="Auteur" FontSize="{StaticResource FontSizeBody}" />
            <Editor x:Name="ContextEditor" Placeholder="Contexte, notes..."
                    HeightRequest="80" FontSize="11" />

            <Button Text="Générer la présentation" Clicked="OnGenerateClicked" />

            <Label x:Name="StatusLabel" FontSize="11" Opacity="0.7" />

        </VerticalStackLayout>

    </Border>

</ContentView>
