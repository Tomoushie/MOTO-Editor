<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.MigrationOverlay"
             IsVisible="False"
             BackgroundColor="Transparent"
             HorizontalOptions="End"
             VerticalOptions="End">

    <Border BackgroundColor="{StaticResource BgPanel}"
            Stroke="{StaticResource Accent}"
            StrokeThickness="1"
            Padding="14"
            Margin="20"
            StrokeShape="RoundRectangle 10">

        <Grid ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto"
              RowSpacing="6">

            <Label Grid.Row="0"
                   Grid.Column="0"
                   Text="🔄"
                   FontSize="22"
                   Margin="0,0,10,0"
                   VerticalOptions="Center" />

            <Label Grid.Row="0"
                   Grid.Column="1"
                   Text="Paramètres migrés"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Txt1}" />

            <Label Grid.Row="1"
                   Grid.Column="1"
                   x:Name="MessageLabel"
                   Text="Migration effectuée."
                   FontSize="12"
                   TextColor="{StaticResource Txt2}" />
        </Grid>
    </Border>
</ContentView>
