<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.MigrationOverlay"
             IsVisible="False"
             BackgroundColor="Transparent"
             HorizontalOptions="End"
             VerticalOptions="End">

    <Border BackgroundColor="{StaticResource BgPanel}"
            Stroke="{StaticResource Accent}"
            StrokeThickness="1"
            Padding="{StaticResource SpaceMd}"
            Margin="{StaticResource SpaceMd}"
            StrokeShape="RoundRectangle 8">

        <Grid ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto"
              RowSpacing="{StaticResource SpaceXs}">

            <Label Grid.Row="0"
                   Grid.Column="0"
                   Text="🔄"
                   FontSize="{StaticResource FontSizeTitle}"
                   Margin="0,0,10,0"
                   VerticalOptions="Center" />

            <Label Grid.Row="0"
                   Grid.Column="1"
                   Text="Paramètres migrés"
                   FontSize="{StaticResource FontSizeSubheading}"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Txt1}" />

            <Label Grid.Row="1"
                   Grid.Column="1"
                   x:Name="MessageLabel"
                   Text="Migration effectuée."
                   FontSize="{StaticResource FontSizeBody}"
                   TextColor="{StaticResource Txt2}" />
        </Grid>
    </Border>
</ContentView>
