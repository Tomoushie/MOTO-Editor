<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.ConfirmationOverlay"
             IsVisible="False"
             BackgroundColor="#99000000">

    <!-- ★ MODIFIÉ (24/09, agent v2) : la zone de détails défile et sa hauteur est bornée d'après la fenêtre (ConfirmationOverlay.xaml.cs).
         Avant, un long texte (un diff, un fichier proposé) allongeait la carte au-delà de l'écran et poussait les boutons
         hors de la fenêtre : impossible de répondre, et la demande suivante restait bloquée derrière celle-ci. -->
    <Border x:Name="Card"
            WidthRequest="480"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            BackgroundColor="{StaticResource BgPanel}"
            Stroke="{StaticResource BgHover}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            Padding="{StaticResource SpaceMd}">

        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource SpaceSm}">

            <!-- Titre -->
            <Label Grid.Row="0"
                   x:Name="TitleLabel"
                   FontSize="{StaticResource FontSizeHeading}"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Txt1}" />

            <!-- Message -->
            <Label Grid.Row="1"
                   x:Name="MessageLabel"
                   FontSize="{StaticResource FontSizeBody}"
                   TextColor="{StaticResource Txt1}" />

            <!-- Détails (défilants) -->
            <Border Grid.Row="2"
                    x:Name="DetailsFrame"
                    BackgroundColor="{StaticResource BgSide}"
                    Stroke="{StaticResource BgHover}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="{StaticResource SpaceXs}">
                <ScrollView x:Name="DetailsScroll" MaximumHeightRequest="360">
                    <VerticalStackLayout x:Name="DetailsHost" Spacing="0" />
                </ScrollView>
            </Border>

            <!-- Boutons (hors de la zone défilante : toujours visibles).
                 ★ (25/09, passe « moyen → élevé ») : styles communs du thème (bouton secondaire + bouton principal, avec
                 survol/appui/focus) ; avant, « Appliquer » ressemblait à du texte surligné, sans marge intérieure. -->
            <HorizontalStackLayout Grid.Row="3"
                                   Spacing="{StaticResource SpaceSm}"
                                   HorizontalOptions="End"
                                   Margin="0,4,0,0">
                <Button x:Name="CancelBtn"
                        Text="Annuler"
                        Style="{StaticResource MotoSecondaryButton}"
                        Clicked="OnCancelClicked" />
                <Button x:Name="ConfirmBtn"
                        Text="Appliquer"
                        Style="{StaticResource MotoPrimaryButton}"
                        Clicked="OnConfirmClicked" />
            </HorizontalStackLayout>
        </Grid>
    </Border>
</ContentView>
