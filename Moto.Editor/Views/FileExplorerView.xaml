<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Moto.Editor.Controls"
             x:Class="Moto.Editor.Views.FileExplorerView">

    <Grid RowDefinitions="Auto,Auto,*" BackgroundColor="{StaticResource BgSide}">

        <!-- Barre d'outils de l'explorateur -->
        <HorizontalStackLayout Grid.Row="0" Padding="8,6" Spacing="{StaticResource SpaceXs}">

            <Label Text="EXPLORATEUR"
                   FontAttributes="Bold"
                   FontSize="{StaticResource FontSizeBody}"
                   VerticalOptions="Center" />

            <!-- ★ CORRECTION (31/08) : emojis → glyphes vectoriels Segoe Fluent Icons
                 (codepoints vérifiés visuellement, voir Controls/MotoIcons.cs) —
                 demandé par Tom ("rendu jouet").
                 ★ CORRECTION (31/08, point 17) : fond gris/blanc natif Windows retiré
                 (BackgroundColor/BorderWidth explicites — un Button MAUI sans ces
                 réglages garde le chrome natif WinUI, contrairement aux Border+Label
                 utilisés partout ailleurs dans ce projet) + zone grise arrondie au
                 survol/clic ajoutée (HoverEffects, voir .xaml.cs), demandé aussi
                 point 1/3. -->
            <!-- ★ CORRECTION (02/09, retouche "vrai Zed") : ces 4 boutons enlevaient déjà
                 le chrome natif Windows (voir commentaire ci-dessus) mais n'avaient
                 toujours AUCUN retour au survol — MotoHoverIconButton (même mécanisme
                 que MotoHoverButton, déjà utilisé ailleurs) leur donne le fond survolé
                 qui manquait, sans changer taille/padding.
                 ★ CORRECTION (02/09, repéré par Tom) : aucun des 4 n'avait de
                 VerticalOptions, contrairement au Label "EXPLORATEUR" juste au-dessus
                 (VerticalOptions="Center") — dans un HorizontalStackLayout, un enfant
                 sans VerticalOptions explicite prend la hauteur par défaut (Fill),
                 donc les boutons s'étiraient sur toute la hauteur du bandeau pendant
                 que le texte restait centré sur sa propre taille naturelle : décalage
                 vertical entre le texte et les icônes. Center ajouté aux 4 pour aligner
                 tout le monde sur le même axe. -->
            <Button x:Name="BtnOpenFolder" Text="{x:Static controls:MotoIcons.Folder}" FontFamily="{x:Static controls:MotoIcons.FontFamily}"
                    ToolTipProperties.Text="Ouvrir un dossier"
                    Clicked="OnOpenFolderClicked"
                    Style="{StaticResource MotoHoverIconButton}" VerticalOptions="Center" />

            <!-- ★ AJOUT (31/08) : "Nouveau fichier" n'avait jamais été construit
                 (confirmé, pas un bug) — demandé par Tom. -->
            <Button x:Name="BtnNewFile" Text="{x:Static controls:MotoIcons.Add}" FontFamily="{x:Static controls:MotoIcons.FontFamily}"
                    ToolTipProperties.Text="Nouveau fichier"
                    Clicked="OnNewFileClicked"
                    Style="{StaticResource MotoHoverIconButton}" VerticalOptions="Center" />

            <Button x:Name="BtnRefresh" Text="{x:Static controls:MotoIcons.Refresh}" FontFamily="{x:Static controls:MotoIcons.FontFamily}"
                    ToolTipProperties.Text="Actualiser"
                    Clicked="OnRefreshClicked"
                    Style="{StaticResource MotoHoverIconButton}" VerticalOptions="Center" />

            <Button x:Name="BtnToggleSide" Text="🡺"
                    ToolTipProperties.Text="Changer de côté"
                    Clicked="OnToggleSideClicked"
                    Style="{StaticResource MotoHoverIconButton}" FontSize="{StaticResource FontSizeBody}" VerticalOptions="Center" />

        </HorizontalStackLayout>

        <!-- ★ AJOUT (31/08, point 8) : nom du projet + branche Git, dès qu'un
             dossier est ouvert. Lu directement dans <dossier>/.git/HEAD (pas de
             dépendance Git installée nécessaire) — masqué si .git n'existe pas
             (dossier sans dépôt Git). -->
        <HorizontalStackLayout Grid.Row="1" x:Name="ProjectInfoBar"
                                Padding="8,0,8,8" Spacing="{StaticResource SpaceXs}" IsVisible="False">
            <Label x:Name="ProjectNameLabel" FontSize="{StaticResource FontSizeBody}" FontAttributes="Bold"
                   TextColor="{StaticResource Txt1}" />
            <Border BackgroundColor="{StaticResource BgSide}" Padding="6,1"
                    StrokeThickness="0" StrokeShape="RoundRectangle 8">
                <Label x:Name="BranchLabel" FontSize="11" TextColor="{StaticResource Txt2}" />
            </Border>
        </HorizontalStackLayout>

        <!-- Arborescence -->
        <!-- ★ CORRECTION (30/08) : sans dossier ouvert, ce panneau ne montrait qu'une
             fine barre d'outils sur fond vide — facile à manquer, donnait l'impression
             que le bouton "Fichiers" n'ouvrait "rien du tout" (repéré par Tom). -->
        <!-- ★ CORRECTION (02/09, repéré par Tom, 3 essais dans CollectionView.EmptyView
             sans effet malgré des mesures confirmant un conteneur pourtant correct
             (260px, X=0 des deux côtés) : le décalage vient donc de la zone interne
             que CollectionView réserve à son EmptyView (viewport natif WinUI, hors
             de portée d'un simple réglage XAML côté MAUI), pas d'un mauvais calcul
             de centrage à ce niveau. Remplacé par un panneau FRÈRE de TreeList, dans
             la MÊME cellule de Grid (Grid.Row="2", superposition normale en MAUI) —
             centré directement sur les dimensions réelles de FileExplorerView, sans
             dépendre du rendu interne de CollectionView. Visibilité pilotée depuis
             le code-behind (RefreshEmptyState, appelée partout où _visibleNodes
             change). -->
        <Grid x:Name="EmptyStatePanel" Grid.Row="2" HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True">
            <VerticalStackLayout Padding="{StaticResource SpaceMd}" Spacing="{StaticResource SpaceSm}"
                                 HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="📂" FontSize="{StaticResource FontSizeDisplay}" HorizontalOptions="Center" Opacity="0.6" />
                <Label Text="Aucun dossier ouvert" FontSize="{StaticResource FontSizeBody}" HorizontalOptions="Center" Opacity="0.8" />
                <Label Text="Clique sur 📁 ci-dessus, ou sur &quot;Projet logiciel&quot; à l'accueil."
                       FontSize="11" HorizontalOptions="Center" Opacity="0.5" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <CollectionView Grid.Row="2"
                        x:Name="TreeList"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- ★ AJOUT (02/09, retouche "vrai Zed") : d'après le vrai code de
                         crates/project_panel/src/project_panel.rs (github.com/zed-industries/zed),
                         chaque ligne de l'arborescence change simplement de fond selon son
                         état (survol/sélection), sans cadre ni relief — aucun équivalent
                         n'existait ici (0 retour visuel au survol jusqu'ici). MotoHoverRow
                         applique le même mécanisme déjà éprouvé (MotoHoverButton/Entry) à
                         ce wrapper Border ; la sélection reste gérée nativement par
                         SelectionMode="Single" ci-dessus, non dupliquée ici pour éviter un
                         double surlignage. -->
                    <Border Style="{StaticResource MotoHoverRow}">
                        <Grid ColumnDefinitions="Auto,Auto,*" Padding="4,2">

                            <!-- Espace d'indentation -->
                            <BoxView Grid.Column="0"
                                     WidthRequest="{Binding Indent}"
                                     Color="Transparent" />

                            <Label Grid.Column="1"
                                   Text="{Binding Icon}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   WidthRequest="44" />

                            <Label Grid.Column="2"
                                   Text="{Binding Name}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   VerticalOptions="Center" />

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentView>
