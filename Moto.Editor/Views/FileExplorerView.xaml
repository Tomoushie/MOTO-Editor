<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.FileExplorerView">

    <Grid RowDefinitions="Auto,*" BackgroundColor="#17181C">

        <!-- Barre d'outils de l'explorateur -->
        <HorizontalStackLayout Grid.Row="0" Padding="8,6" Spacing="6">

            <Label Text="EXPLORATEUR"
                   FontAttributes="Bold"
                   FontSize="12"
                   VerticalOptions="Center" />

            <Button Text="📁"
                    ToolTipProperties.Text="Ouvrir un dossier"
                    Clicked="OnOpenFolderClicked"
                    Padding="6,2" FontSize="12" />

            <Button Text="⟳"
                    ToolTipProperties.Text="Actualiser"
                    Clicked="OnRefreshClicked"
                    Padding="6,2" FontSize="12" />

            <Button Text="🡺"
                    ToolTipProperties.Text="Changer de côté"
                    Clicked="OnToggleSideClicked"
                    Padding="6,2" FontSize="12" />

        </HorizontalStackLayout>

        <!-- Arborescence -->
        <CollectionView Grid.Row="1"
                        x:Name="TreeList"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,Auto,*" Padding="4,2">

                        <!-- Espace d'indentation -->
                        <BoxView Grid.Column="0"
                                 WidthRequest="{Binding Indent}"
                                 Color="Transparent" />

                        <Label Grid.Column="1"
                               Text="{Binding Icon}"
                               FontSize="13"
                               WidthRequest="44" />

                        <Label Grid.Column="2"
                               Text="{Binding Name}"
                               FontSize="13"
                               VerticalOptions="Center" />

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentView>
