<?xml version="1.0" encoding="utf-8" ?>
<!--
  Moto.Editor/Views/TerminalPanelView.xaml
  ★ AJOUT (01/09, chantier "panneaux modulaires" — dock du bas) : le vrai
  moteur (Moto.Core.Services.TerminalService — cmd.exe/bash, sortie en
  direct, envoi de commandes) et tout le câblage ViewModel (TerminalLines,
  TerminalInput, SendTerminalCommand, IsTerminalVisible) existaient déjà et
  tournaient — seul cet écran manquait pour les rendre visibles/utilisables.
  BindingContext hérité de MainPage (_viewModel), jamais fixé ici
  explicitement : ce panneau n'a aucune logique propre, juste afficher/envoyer.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             xmlns:controls="clr-namespace:Moto.Editor.Controls"
             x:Class="Moto.Editor.Views.TerminalPanelView"
             BackgroundColor="{StaticResource BgChrome}">
    <!-- ★ AJOUT (01/10, famille terminal_*) : valeurs par défaut = défauts
         DÉCLARÉS au catalogue (terminal_font_size = 15, terminal_font_family =
         « Consolas »). DynamicResource et non StaticResource : le met à jour en
         direct à chaque changement de réglage (MainPage.ApplyTerminalSettings),
         lignes de sortie ET champ de saisie — un StaticResource figerait la
         valeur au chargement du XAML. -->
    <ContentView.Resources>
        <sys:Double x:Key="TerminalFontSize">15</sys:Double>
        <x:String x:Key="TerminalFontFamily">Consolas</x:String>
    </ContentView.Resources>
    <Grid x:Name="TerminalRoot" RowDefinitions="Auto,*,Auto">

        <!-- ═══ En-tête ═══ -->
        <!-- ★ CORRECTION (01/09, revue croisée) : marge haute 4→8 — la poignée de
             redimensionnement du dock (BottomDockResizeHandle, MainPage.xaml) est
             posée PAR-DESSUS le bord haut de ce panneau (6px) ; sans cette marge,
             elle recouvrait les 2 derniers pixels du bouton ✕ juste en dessous. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="10,8,10,4">
            <!-- ★ (26/09, passe « moyen → élevé ») : titre en petites capitales (comme « EXPLORATEUR »), croix = glyphe du thème. -->
            <Label Text="Terminal" Style="{StaticResource TextMicro}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="{x:Static controls:MotoIcons.Close}"
                    Style="{StaticResource MotoIconButton}" FontSize="10"
                    ToolTipProperties.Text="Fermer le terminal"
                    Clicked="OnCloseClicked" />
        </Grid>
        <BoxView Grid.Row="0" VerticalOptions="End" HeightRequest="1"
                 Color="{StaticResource BorderMuted}" />

        <!-- ═══ Sortie (TerminalLines — alimentée en direct par TerminalService) ═══ -->
        <CollectionView Grid.Row="1" x:Name="LinesList"
                        ItemsSource="{Binding TerminalLines}"
                        BackgroundColor="Transparent" Margin="10,4">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding Text}" FontFamily="{DynamicResource TerminalFontFamily}" FontSize="{DynamicResource TerminalFontSize}"
                           TextColor="{StaticResource Txt1}" LineBreakMode="CharacterWrap">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsError}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource Error}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ═══ Entrée (TerminalInput → SendTerminalCommand → TerminalService.SendInput) ═══ -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Padding="{StaticResource SpaceSm}" ColumnSpacing="{StaticResource SpaceXs}">
            <Entry Grid.Column="0" x:Name="InputEntry" Text="{Binding TerminalInput}"
                   Placeholder="Tapez une commande…" FontFamily="{DynamicResource TerminalFontFamily}" FontSize="{DynamicResource TerminalFontSize}"
                   BackgroundColor="{StaticResource BgPanel}" TextColor="{StaticResource Txt1}"
                   Completed="OnSendClicked" />
            <!-- ★ (26/09) : glyphe Envoyer du thème (comme le chat et la barre IA), au lieu du caractère ➤ sur aplat bleu. -->
            <Button Grid.Column="1" Text="{x:Static controls:MotoIcons.Send}"
                    Style="{StaticResource MotoIconButton}"
                    TextColor="{StaticResource AccentText}"
                    VerticalOptions="Center"
                    ToolTipProperties.Text="Envoyer la commande"
                    Clicked="OnSendClicked" />
        </Grid>
    </Grid>
</ContentView>
