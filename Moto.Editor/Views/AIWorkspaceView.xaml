<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.AIWorkspaceView"
             BackgroundColor="{StaticResource BgSide}">

    <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource BorderCol}"
            BackgroundColor="{StaticResource BgPanelInner}" WidthRequest="480" Padding="{StaticResource SpaceMd}">

        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{StaticResource SpaceSm}">

            <Label Grid.Row="0" Text="🏗 MOTO AI Workspace"
                   FontAttributes="Bold" FontSize="{StaticResource FontSizeSubheading}" />

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceXs}">
                <Label Grid.Column="0" x:Name="SummaryLabel"
                       Text="Workspace IA — analyse en cours…"
                       FontSize="11" Opacity="0.7" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="🔄 Ré-analyser"
                        FontSize="{StaticResource FontSizeSmall}" Padding="8,2"
                        Clicked="OnReanalyzeClicked" />
            </Grid>

            <CollectionView Grid.Row="2" x:Name="SuggestionsList" HeightRequest="320">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource BgPanel}"
                                Padding="{StaticResource SpaceSm}" Margin="0,4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                                <Label Grid.Column="0" Text="{Binding Kind}"
                                       FontSize="{StaticResource FontSizeHeading}" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding Title}"
                                           FontSize="{StaticResource FontSizeBody}" FontAttributes="Bold" />
                                    <Label Text="{Binding Description}"
                                           FontSize="{StaticResource FontSizeSmall}" Opacity="0.7" />
                                    <Label Text="{Binding FilePath}"
                                           FontSize="{StaticResource FontSizeSmall}" Opacity="0.5"
                                           FontFamily="Consolas" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="Apply"
                                        FontSize="{StaticResource FontSizeSmall}" Padding="8,2"
                                        Clicked="OnApplyClicked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Grid.Row="3" x:Name="StatusFooter"
                   Text="💡 Le workspace IA apprend en continu pendant que tu codes."
                   FontSize="{StaticResource FontSizeSmall}" Opacity="0.6" FontAttributes="Italic" />

        </Grid>

    </Border>

</ContentView>
