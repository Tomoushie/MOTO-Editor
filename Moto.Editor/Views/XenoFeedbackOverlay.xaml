<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.XenoFeedbackOverlay"
             IsVisible="False"
             BackgroundColor="#80000000">
    <Border BackgroundColor="{StaticResource BgPanel}"
            Stroke="{StaticResource BgHover}" StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            Padding="{StaticResource SpaceMd}" WidthRequest="520"
            HorizontalOptions="Center" VerticalOptions="Center">
        <VerticalStackLayout Spacing="{StaticResource SpaceSm}">

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="🧠 XENO-SSS∞ — Suggestions" FontSize="{StaticResource FontSizeHeading}" FontAttributes="Bold"
                       TextColor="{StaticResource Txt1}"/>
                <Button Grid.Column="1" Text="✕" WidthRequest="30" HeightRequest="30"
                        BackgroundColor="Transparent" TextColor="{StaticResource Txt2}"
                        Clicked="OnCloseClicked"/>
            </Grid>

            <Label x:Name="SummaryLabel" Text="—" FontSize="{StaticResource FontSizeBody}"
                   TextColor="{StaticResource Txt2}"/>

            <ScrollView HeightRequest="320">
                <VerticalStackLayout x:Name="FindingsContainer" Spacing="{StaticResource SpaceSm}"/>
            </ScrollView>

            <Label x:Name="FeedbackLabel" Text="Vos feedbacks améliorent XENO au fil du temps."
                   FontSize="{StaticResource FontSizeSmall}" TextColor="{StaticResource Txt2}"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </Border>
</ContentView>
