<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.DebugPanelProView"
             IsVisible="False"
             BackgroundColor="{StaticResource BgPanel}"
             WidthRequest="440">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" Padding="12" RowSpacing="8">

        <!-- Contrôles de debug -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
            <Label Text="🐞 Debugger Pro" FontSize="14" FontAttributes="Bold"
                   TextColor="{StaticResource Txt1}" VerticalOptions="Center"/>
            <Button Grid.Column="1" x:Name="ContinueBtn" Text="▶" WidthRequest="32" HeightRequest="32"
                    BackgroundColor="{StaticResource Accent}" TextColor="White"
                    Clicked="OnContinueClicked" IsEnabled="False"/>
            <Button Grid.Column="2" x:Name="StepOverBtn" Text="⏭" WidthRequest="32" HeightRequest="32"
                    BackgroundColor="{StaticResource BgSide}" TextColor="{StaticResource Txt1}"
                    Clicked="OnStepOverClicked" IsEnabled="False"/>
            <Button Grid.Column="3" x:Name="StepIntoBtn" Text="⏬" WidthRequest="32" HeightRequest="32"
                    BackgroundColor="{StaticResource BgSide}" TextColor="{StaticResource Txt1}"
                    Clicked="OnStepIntoClicked" IsEnabled="False"/>
            <Button Grid.Column="4" x:Name="StepOutBtn" Text="⏫" WidthRequest="32" HeightRequest="32"
                    BackgroundColor="{StaticResource BgSide}" TextColor="{StaticResource Txt1}"
                    Clicked="OnStepOutClicked" IsEnabled="False"/>
            <Button Grid.Column="5" x:Name="StopBtn" Text="⏹" WidthRequest="32" HeightRequest="32"
                    BackgroundColor="#DC2626" TextColor="White"
                    Clicked="OnStopClicked" IsEnabled="False"/>
        </Grid>

        <!-- Onglets -->
        <HorizontalStackLayout Grid.Row="1" Spacing="6">
            <Button x:Name="TabVariablesBtn" Text="Variables" FontSize="11"
                    BackgroundColor="{StaticResource Accent}" TextColor="White" Clicked="OnTabVariablesClicked"/>
            <Button x:Name="TabWatchBtn" Text="Watch" FontSize="11"
                    BackgroundColor="{StaticResource BgSide}" TextColor="{StaticResource Txt1}" Clicked="OnTabWatchClicked"/>
            <Button x:Name="TabCallStackBtn" Text="Call Stack" FontSize="11"
                    BackgroundColor="{StaticResource BgSide}" TextColor="{StaticResource Txt1}" Clicked="OnTabCallStackClicked"/>
            <Button x:Name="TabBreakpointsBtn" Text="Breakpoints" FontSize="11"
                    BackgroundColor="{StaticResource BgSide}" TextColor="{StaticResource Txt1}" Clicked="OnTabBreakpointsClicked"/>
        </HorizontalStackLayout>

        <!-- Contenu -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout x:Name="ContentArea" Spacing="4"/>
        </ScrollView>

        <!-- Watch input -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <Entry x:Name="WatchEntry" Placeholder="Expression à évaluer…"
                   BackgroundColor="{StaticResource BgSide}" TextColor="{StaticResource Txt1}"
                   PlaceholderColor="{StaticResource Txt2}" FontSize="11"/>
            <Button Grid.Column="1" Text="+" WidthRequest="30" HeightRequest="30"
                    BackgroundColor="{StaticResource Accent}" TextColor="White"
                    Clicked="OnAddWatchClicked"/>
        </Grid>

        <!-- Console output -->
        <Border Grid.Row="4" BackgroundColor="{StaticResource BgSide}"
                Stroke="{StaticResource BgHover}" StrokeThickness="1"
                StrokeShape="RoundRectangle 6" Padding="8">
            <Label x:Name="OutputLabel" Text="Console de debug" FontSize="10"
                   TextColor="{StaticResource Txt2}" MaxLines="5"/>
        </Border>

        <!-- Status -->
        <Label Grid.Row="5" x:Name="StatusLabel" Text="Prêt." FontSize="11"
               TextColor="{StaticResource Txt2}"/>
    </Grid>
</ContentView>
