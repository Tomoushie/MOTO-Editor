<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.DebugPanelView"
             IsVisible="False"
             BackgroundColor="{StaticResource BgPanel}"
             WidthRequest="400">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="12" RowSpacing="10">

        <!-- Header + contrôles -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
            <Label Text="🐞 Debug"
                   FontSize="14" FontAttributes="Bold"
                   TextColor="{StaticResource Txt1}"
                   VerticalOptions="Center" />

            <Button Grid.Column="2" x:Name="ContinueBtn" Text="▶"
                    WidthRequest="32" HeightRequest="32"
                    BackgroundColor="{StaticResource Accent}"
                    TextColor="White" Clicked="OnContinueClicked" IsEnabled="False" />
            <Button Grid.Column="3" x:Name="StepOverBtn" Text="⏭"
                    WidthRequest="32" HeightRequest="32"
                    BackgroundColor="{StaticResource BgSide}"
                    TextColor="{StaticResource Txt1}" Clicked="OnStepOverClicked" IsEnabled="False" />
            <Button Grid.Column="4" x:Name="StepIntoBtn" Text="⏬"
                    WidthRequest="32" HeightRequest="32"
                    BackgroundColor="{StaticResource BgSide}"
                    TextColor="{StaticResource Txt1}" Clicked="OnStepIntoClicked" IsEnabled="False" />
            <Button Grid.Column="5" x:Name="StopBtn" Text="⏹"
                    WidthRequest="32" HeightRequest="32"
                    BackgroundColor="#DC2626"
                    TextColor="White" Clicked="OnStopClicked" IsEnabled="False" />
        </Grid>

        <!-- Breakpoints -->
        <Label Grid.Row="1" Text="📍 Breakpoints"
               FontSize="12" FontAttributes="Bold"
               TextColor="{StaticResource Accent}" />

        <!-- Stack trace -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="8">
                <Label Text="📚 Call Stack"
                       FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource Accent}" />
                <VerticalStackLayout x:Name="CallStackList" Spacing="4" />

                <Label Text="🔍 Variables"
                       FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource Accent}"
                       Margin="0,8,0,0" />
                <VerticalStackLayout x:Name="VariablesList" Spacing="4" />

                <Label Text="📋 Output"
                       FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource Accent}"
                       Margin="0,8,0,0" />
                <Label x:Name="OutputLabel"
                       Text="En attente…"
                       FontSize="11"
                       TextColor="{StaticResource Txt2}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Watch -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <Entry x:Name="WatchEntry"
                   Placeholder="Ajouter une watch expression…"
                   BackgroundColor="{StaticResource BgSide}"
                   TextColor="{StaticResource Txt1}"
                   PlaceholderColor="{StaticResource Txt2}"
                   FontSize="11" />
            <Button Grid.Column="1" Text="+"
                    WidthRequest="30" HeightRequest="30"
                    BackgroundColor="{StaticResource Accent}"
                    TextColor="White" Clicked="OnAddWatchClicked" />
        </Grid>

        <!-- Status -->
        <Label Grid.Row="4" x:Name="StatusLabel"
               Text="Prêt."
               FontSize="11"
               TextColor="{StaticResource Txt2}" />
    </Grid>
</ContentView>
