<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Moto.Editor.Controls"
             x:Class="Moto.Editor.Views.AiCommandBarView">

    <!-- Barre IA flottante, style Claude / Zen.
         ★ (25/09, passe « moyen → élevé ») : surface « flottante » (BgElevated) pour qu'elle se détache du code, étoile en
         bleu lisible, glyphe Envoyer du thème (au lieu du caractère ➤). Pas d'ombre portée : essayée, les panneaux posés
         ensuite par-dessus l'éditeur (confirmation, palette) cessaient d'être redessinés (vérifié sur captures). -->
    <Border StrokeShape="RoundRectangle 12"
            Stroke="{StaticResource BorderCol}"
            BackgroundColor="{StaticResource BgElevated}"
            Padding="14,6"
            WidthRequest="560">

        <Grid ColumnDefinitions="Auto,*,Auto">

            <Label Grid.Column="0"
                   Text="✦"
                   FontSize="16"
                   TextColor="{StaticResource AccentText}"
                   VerticalOptions="Center"
                   Margin="0,0,8,0" />

            <Entry Grid.Column="1"
                   x:Name="InputEntry"
                   Placeholder="Comment puis-je vous aider aujourd'hui ?"
                   BackgroundColor="Transparent"
                   FontSize="{StaticResource FontSizeSubheading}"
                   Completed="OnSubmitted" />

            <Button Grid.Column="2"
                    Text="{x:Static controls:MotoIcons.Send}"
                    Style="{StaticResource MotoIconButton}"
                    TextColor="{StaticResource AccentText}"
                    VerticalOptions="Center"
                    ToolTipProperties.Text="Envoyer"
                    Clicked="OnSubmitted" />

        </Grid>

    </Border>

</ContentView>
