<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Moto.Editor.Controls"
             x:Class="Moto.Editor.Views.AboutProView">

    <Border Background="{DynamicResource MotoCardBackground}"
            Stroke="{DynamicResource MotoCardBorder}" StrokeThickness="1" Padding="24">
        <Border.StrokeShape><RoundRectangle CornerRadius="{StaticResource RadiusLg}" /></Border.StrokeShape>

        <ScrollView>
            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                <controls:MotoLogoView Size="96" HorizontalOptions="Center" />
                <Label Text="MOTO Editor Pro" FontSize="{StaticResource FontSizeDisplay}" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label x:Name="VersionLabel" Text="Version —" FontSize="{StaticResource FontSizeBody}" Opacity="0.7" HorizontalOptions="Center" />

                <!-- Badges Pro -->
                <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Center">
                    <Border Padding="10,5" Margin="4" Background="{DynamicResource MotoSubtleBackground}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="{StaticResource RadiusLg}" /></Border.StrokeShape>
                        <Label Text="⭐ Pro" FontSize="{StaticResource FontSizeBody}" />
                    </Border>
                    <Border Padding="10,5" Margin="4" Background="{DynamicResource MotoSubtleBackground}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="{StaticResource RadiusLg}" /></Border.StrokeShape>
                        <Label Text="🤖 IA locale" FontSize="{StaticResource FontSizeBody}" />
                    </Border>
                    <Border Padding="10,5" Margin="4" Background="{DynamicResource MotoSubtleBackground}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="{StaticResource RadiusLg}" /></Border.StrokeShape>
                        <Label Text="🧠 XENO-SSS∞" FontSize="{StaticResource FontSizeBody}" />
                    </Border>
                </FlexLayout>

                <!-- Modules IA -->
                <Border Padding="14" WidthRequest="440"
                        Background="{DynamicResource MotoSubtleBackground}"
                        Stroke="{DynamicResource MotoCardBorder}" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="{StaticResource RadiusLg}" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="🧩 Modules IA actifs" FontSize="{StaticResource FontSizeSubheading}" FontAttributes="Bold" />
                        <CollectionView x:Name="ModulesList" HeightRequest="180">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding}" FontSize="{StaticResource FontSizeBody}" Padding="0,2" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Stats -->
                <Border Padding="14" WidthRequest="440"
                        Background="{DynamicResource MotoSubtleBackground}"
                        Stroke="{DynamicResource MotoCardBorder}" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="{StaticResource RadiusLg}" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="📊 Statistiques" FontSize="{StaticResource FontSizeSubheading}" FontAttributes="Bold" />
                        <Label x:Name="StatsLabel" FontSize="{StaticResource FontSizeBody}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Border>
</ContentView>
