<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.DocPanelView"
             BackgroundColor="{StaticResource BgSide}">

    <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource BorderCol}"
            BackgroundColor="{StaticResource BgPanelInner}" WidthRequest="440" Padding="14">

        <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="0" RowSpacing="8">

            <!-- ★ AJOUT (03/09, signalé par Tom : "impossible de refermer le menu"
                 après avoir ouvert "Documentation" depuis la palette) : ce panneau
                 était le seul overlay du dock IA/panneaux sans bouton ✕ — la seule
                 façon de le refermer était de rouvrir la palette et de resélectionner
                 "Documentation" pour rebasculer IsVisible. Même patron que
                 CommandPaletteView/ProactiveActionsView. -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="📚 MOTO Doc Engine" FontAttributes="Bold" FontSize="14" />
                <Button Grid.Column="1" Text="✕" FontSize="12" Padding="0"
                        WidthRequest="24" HeightRequest="24" CornerRadius="12"
                        BackgroundColor="Transparent" TextColor="{StaticResource Txt2}"
                        Clicked="OnCloseClicked" />
            </Grid>

            <Label Grid.Row="1" x:Name="SummaryLabel"
                   Text="Documentation du projet" FontSize="11" Opacity="0.7" />

            <CollectionView Grid.Row="2" x:Name="FilesList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource BgPanel}"
                                Padding="10" Margin="0,4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="📄" FontSize="16" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding FileName}" FontSize="12" FontAttributes="Bold" />
                                    <Label Text="{Binding LineCount, StringFormat='{0} lignes'}"
                                           FontSize="10" Opacity="0.6" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="Ouvrir"
                                        FontSize="10" Padding="8,2"
                                        Clicked="OnOpenClicked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="🔄 Régénérer tout"
                        FontSize="11" Padding="8,4"
                        Clicked="OnRegenerateClicked" />
                <Button Grid.Column="1" Text="📂 Ouvrir le dossier"
                        FontSize="11" Padding="8,4"
                        Clicked="OnOpenFolderClicked" />
            </Grid>

        </Grid>

    </Border>

</ContentView>
