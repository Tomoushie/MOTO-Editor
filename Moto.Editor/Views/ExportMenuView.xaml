<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.ExportMenuView"
             BackgroundColor="#17181C">

    <Border StrokeShape="RoundRectangle 12" Stroke="#3A3B40"
            BackgroundColor="#1A1B1F" WidthRequest="340" Padding="14">

        <VerticalStackLayout Spacing="8">

            <!-- ★ CORRECTION (30/08) : bouton fermer ✕ ajouté — le seul moyen de
                 fermer ce panneau était de recliquer sur le bouton Exporter de la
                 barre d'outils (repéré par Tom). -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="⬇ Exporter le fichier" FontAttributes="Bold" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="✕" WidthRequest="28" HeightRequest="24" FontSize="12"
                        Padding="0" BackgroundColor="Transparent" Clicked="OnCloseClicked" />
            </Grid>

            <Picker x:Name="FormatPicker" FontSize="12">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>TXT (.txt)</x:String>
                        <x:String>Markdown (.md)</x:String>
                        <x:String>HTML (.html)</x:String>
                        <x:String>PDF imprimable (.html @page)</x:String>
                        <x:String>Word (.docx)</x:String>
                        <x:String>LibreOffice (.odt)</x:String>
                        <x:String>RTF (.rtf)</x:String>
                        <x:String>JSON (.json)</x:String>
                        <x:String>CSV (.csv)</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Entry x:Name="AuthorEntry" Placeholder="Auteur (optionnel)" FontSize="11" />

            <Button Text="Exporter" Clicked="OnExportClicked" />

            <Label x:Name="StatusLabel" FontSize="11" Opacity="0.7" />

        </VerticalStackLayout>

    </Border>

</ContentView>
