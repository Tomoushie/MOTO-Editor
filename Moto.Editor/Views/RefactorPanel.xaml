<?xml version="1.0" encoding="utf-8" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Moto.Editor.Views.RefactorPanel">
    <Grid Background="{StaticResource PanelBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="16" Background="{StaticResource HeaderBackgroundBrush}">
            <StackPanel>
                <TextBlock Text="🔧 AutoRefactor Pro"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock x:Name="SuggestionCountText"
                           Text="0 suggestions"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Liste des suggestions -->
        <ListView Grid.Row="1"
                  x:Name="SuggestionsList"
                  SelectionMode="Single"
                  Background="Transparent"
                  BorderThickness="0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12"
                            Margin="8,4"
                            CornerRadius="8"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Description -->
                            <TextBlock Grid.Row="0"
                                       Text="{Binding Description}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       TextWrapping="Wrap"/>

                            <!-- Score + Catégorie -->
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Margin="0,8,0,0">
                                <Border Background="{StaticResource AccentBrush}"
                                        CornerRadius="4"
                                        Padding="6,2">
                                    <TextBlock Text="{Binding Category}"
                                               FontSize="11"
                                               Foreground="White"/>
                                </Border>
                                <TextBlock Text="{Binding Score, StringFormat='Score: {0:P0}'}"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Preview du diff -->
                            <Border Grid.Row="2"
                                    Margin="0,8,0,0"
                                    Padding="8"
                                    Background="{StaticResource CodeBackgroundBrush}"
                                    CornerRadius="4">
                                <TextBlock Text="{Binding Diff}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="{StaticResource CodeTextBrush}"
                                           TextWrapping="Wrap"
                                           MaxHeight="100"/>
                            </Border>

                            <!-- Boutons d'action -->
                            <StackPanel Grid.Row="3"
                                        Orientation="Horizontal"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Right">
                                <Button Content="👍"
                                        Tag="{Binding Id}"
                                        Click="OnLikeClicked"
                                        Width="32"
                                        Height="32"
                                        Margin="0,0,4,0"
                                        ToolTipService.ToolTip="Approuver"/>
                                <Button Content="👎"
                                        Tag="{Binding Id}"
                                        Click="OnDislikeClicked"
                                        Width="32"
                                        Height="32"
                                        Margin="0,0,4,0"
                                        ToolTipService.ToolTip="Rejeter"/>
                                <Button Content="✏️"
                                        Tag="{Binding Id}"
                                        Click="OnEditClicked"
                                        Width="32"
                                        Height="32"
                                        Margin="0,0,4,0"
                                        ToolTipService.ToolTip="Modifier"/>
                                <Button Content="Appliquer"
                                        Tag="{Binding Id}"
                                        Click="OnApplyClicked"
                                        Padding="12,6"
                                        Background="{StaticResource SuccessBrush}"
                                        Foreground="White"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
