<!-- Moto.Editor/Views/RemoteConnectView.xaml -->
<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.RemoteConnectView"
             BackgroundColor="#17181C">

    <Border StrokeShape="RoundRectangle 12" Stroke="#3A3B40"
            BackgroundColor="#1A1B1F" WidthRequest="380" Padding="14">

        <VerticalStackLayout Spacing="8">

            <Label Text="🌐 Connexion distante (VS Code-style)" FontAttributes="Bold" />

            <Picker x:Name="KindPicker" FontSize="12">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>WebSocket (PC/serveur distant)</x:String>
                        <x:String>SSH (Remote-SSH)</x:String>
                        <x:String>Serveur RAG</x:String>
                        <x:String>Serveur VS Code</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Entry x:Name="HostEntry" Placeholder="Hôte (ex: 192.168.1.10)" FontSize="12" />
            <Entry x:Name="PortEntry" Placeholder="Port" Keyboard="Numeric"
                   Text="8080" FontSize="12" />
            <Entry x:Name="UserEntry" Placeholder="Utilisateur (optionnel)" FontSize="12" />
            <Entry x:Name="TokenEntry" Placeholder="Token / mot de passe"
                   IsPassword="True" FontSize="12" />

            <Button Text="Connecter" Clicked="OnConnectClicked" />

            <Label x:Name="StatusLabel" FontSize="11" Opacity="0.7" />

        </VerticalStackLayout>

    </Border>

</ContentView>
