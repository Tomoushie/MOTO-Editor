<!-- Moto.Editor/Views/NeuralView.xaml -->
<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.NeuralView"
             BackgroundColor="#17181C">

    <Border StrokeShape="RoundRectangle 12" Stroke="#3A3B40"
            BackgroundColor="#1A1B1F" WidthRequest="440" Padding="14">

        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">

            <Label Grid.Row="0" Text="🧬 MOTO Neural Mode"
                   FontAttributes="Bold" FontSize="14" />

            <Label Grid.Row="1" x:Name="StatusLabel"
                   Text="Mini-modèle IA local — entraîné sur ton projet."
                   FontSize="11" Opacity="0.7" />

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <Entry Grid.Column="0" x:Name="IntentEntry"
                       Placeholder="Ex : génère-moi un système de combat"
                       FontSize="12" BackgroundColor="#202126"
                       Completed="OnGenerateClicked" />
                <Button Grid.Column="1" Text="✨ Générer"
                        FontSize="11" Padding="10,4"
                        Clicked="OnGenerateClicked" />
            </Grid>

            <!-- Résultat de génération -->
            <Border Grid.Row="3" StrokeShape="RoundRectangle 8"
                    BackgroundColor="#0F1013" Padding="10">
                <ScrollView>
                    <Label x:Name="ResultLabel"
                           Text="(en attente d'une demande)"
                           FontSize="12" FontFamily="Consolas"
                           Opacity="0.9" />
                </ScrollView>
            </Border>

            <Button Grid.Row="4" Text="🔄 Ré-entraîner le modèle"
                    FontSize="11" Padding="8,4"
                    Clicked="OnRetrainClicked" />

        </Grid>

    </Border>

</ContentView>
