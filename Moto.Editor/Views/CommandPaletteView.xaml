<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.CommandPaletteView"
             IsVisible="False"
             BackgroundColor="#99000000">

    <Border WidthRequest="640"
            MaximumHeightRequest="480"
            HorizontalOptions="Center"
            VerticalOptions="Start"
            Margin="0,80,0,0"
            BackgroundColor="{StaticResource BgPanel}"
            Stroke="{StaticResource BgHover}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            Padding="{StaticResource SpaceSm}">

        <Grid RowDefinitions="Auto,*" RowSpacing="{StaticResource SpaceSm}">

            <!-- Barre de recherche + fermer -->
            <!-- ★ AJOUT (02/09) : bouton ✕ demandé par Tom — jusqu'ici, le seul moyen
                 de refermer cette palette était de refaire Ctrl+Maj+P. Échap ajouté
                 en plus, voir MainPage.Extensions.cs/OnWindowsPreviewKeyDown. -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                <Border Grid.Column="0"
                        BackgroundColor="{StaticResource BgSide}"
                        Stroke="{StaticResource BgHover}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="{StaticResource SpaceSm}">
                    <Entry x:Name="SearchEntry"
                           Placeholder="Rechercher une commande…"
                           BackgroundColor="Transparent"
                           TextColor="{StaticResource Txt1}"
                           PlaceholderColor="{StaticResource Txt2}"
                           FontSize="{StaticResource FontSizeSubheading}"
                           TextChanged="OnSearchTextChanged"
                           Completed="OnSearchCompleted" />
                </Border>
                <Button Grid.Column="1" Text="✕" WidthRequest="36" HeightRequest="36"
                        Padding="0" BackgroundColor="Transparent"
                        TextColor="{StaticResource Txt2}" Clicked="OnCloseClicked" />
            </Grid>

            <!-- Résultats -->
            <ScrollView Grid.Row="1" HeightRequest="380">
                <VerticalStackLayout x:Name="ResultsList" Spacing="{StaticResource SpaceXs}" />
            </ScrollView>
        </Grid>
    </Border>
</ContentView>
