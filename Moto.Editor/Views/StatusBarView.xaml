<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.StatusBarView"
             BackgroundColor="#101114" HeightRequest="26">

    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" Padding="8,0">

        <Label Grid.Column="0" Text="⚡ MOTO AI" FontSize="11" VerticalOptions="Center" />

        <Label Grid.Column="1" x:Name="ErrorsLabel" Text="0 err"
               TextColor="OrangeRed" FontSize="11" Margin="10,0,0,0"
               VerticalOptions="Center" />

        <Label Grid.Column="2" x:Name="WarningsLabel" Text="0 warn"
               TextColor="Gold" FontSize="11" Margin="8,0,0,0"
               VerticalOptions="Center" />

        <Label Grid.Column="3" x:Name="StatusLabel" Text="Prêt."
               FontSize="11" Opacity="0.7" HorizontalOptions="Center"
               VerticalOptions="Center" />

        <Label Grid.Column="4" x:Name="SandboxLabel" Text=""
               FontSize="11" VerticalOptions="Center" />

        <Label Grid.Column="5" x:Name="LockLabel" Text=""
               FontSize="11" VerticalOptions="Center" />

        <Label Grid.Column="6" x:Name="ProviderLabel" Text="MOTO interne"
               FontSize="11" Opacity="0.7" Margin="8,0" VerticalOptions="Center" />

        <Label Grid.Column="7" x:Name="HealthLabel" Text=""
               FontSize="11" VerticalOptions="Center" />

    </Grid>

</ContentView>
