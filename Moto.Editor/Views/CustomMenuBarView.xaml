<?xml version="1.0" encoding="utf-8" ?>
<!--
  Moto.Editor/Views/CustomMenuBarView.xaml
  Barre de titre custom : nav (Fichiers/Recherche/Collab) + zone de drag +
  badge de mise à jour + avatar + engrenage + boutons fenêtre, TOUT sur UNE
  seule ligne. C'est LA vraie barre utilisée par MainPage (x:Name="MenuBar",
  balise <views:CustomMenuBarView>) — voir l'avertissement dans
  Controls/CustomMenuBarView.xaml(.cs) : NE PAS confondre avec ce fichier-là.

  ★ CORRECTION (31/08) : Tom demande que "Fichiers, Recherche, IA, Cortex,
  Collab" soit sur la MÊME ligne que l'engrenage/Réduire/Agrandir/Fermer,
  au lieu d'une 2e ligne en dessous (ActivityBarView, désormais retirée de
  MainPage.xaml — son code C# reste dans Controls/ActivityBarView.xaml(.cs)
  pour référence mais n'est plus instancié).
  ★ RETRAIT (31/08, point 5 de Tom) : "IA" et "Cortex" ont ensuite déménagé
  d'ici vers la nouvelle barre sous la zone de saisie de l'Accueil
  (Controls/AiComposerBarView), demandé explicitement ("bouger... et le
  mettre... dans la même ligne" que le "+"/effort/micro). Reste : Fichiers,
  Recherche, Collab. Colonnes renumérotées en conséquence.
  Ces items lèvent MenuCommanded avec les mêmes id qu'avant
  ("explorer","search","collab") ; MainPage.Routing.cs les route vers
  OnActivitySelected (code inchangé).
  ★ CORRECTION (31/08) : boutons agrandis (46→52px, police 12/14→14/16) et
  survol/clic ajoutés (AttachButtonFeedback) — demandé par Tom, gris neutre
  pour Réduire/Plein écran, rouge pour Fermer.
  ★ CORRECTION (31/08) : Label "MOTO Editor" supprimé (point 4 de Tom).
  ★ AJOUT (31/08) : avatar (placeholder) + engrenage ⚙, tous deux ouvrent le
  même petit menu déroulant (GearMenuView, câblé par MainPage) — point 1
  (engrenage déplacé ici), point 11 (avatar). Chaque tap lève
  MenuCommanded("gear.toggle") : un seul point d'entrée, MainPage bascule
  GearMenu.IsVisible.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Moto.Editor.Controls"
             x:Class="Moto.Editor.Views.CustomMenuBarView"
             HeightRequest="38"
             BackgroundColor="#17181C">
    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">

        <!-- Nav (ex-ActivityBarView, maintenant sur la même ligne) -->
        <Border Grid.Column="0" Padding="12,6" Margin="14,0,0,0" StrokeThickness="0" BackgroundColor="Transparent">
            <Label Text="Fichiers" FontSize="{DynamicResource FontSizeUiText}" FontFamily="Segoe UI Variable Text"
                   TextColor="{StaticResource Txt1}" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnNavTapped" CommandParameter="explorer" />
            </Border.GestureRecognizers>
        </Border>

        <Border Grid.Column="1" Padding="12,6" StrokeThickness="0" BackgroundColor="Transparent">
            <Label Text="Recherche" FontSize="{DynamicResource FontSizeUiText}" FontFamily="Segoe UI Variable Text"
                   TextColor="{StaticResource Txt1}" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnNavTapped" CommandParameter="search" />
            </Border.GestureRecognizers>
        </Border>

        <Border Grid.Column="2" Padding="12,6" StrokeThickness="0" BackgroundColor="Transparent">
            <Label Text="Collab" FontSize="{DynamicResource FontSizeUiText}" FontFamily="Segoe UI Variable Text"
                   TextColor="{StaticResource Txt1}" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnNavTapped" CommandParameter="collab" />
            </Border.GestureRecognizers>
        </Border>

        <!-- Zone de drag (tout l'espace libre) -->
        <Border x:Name="TitleBarDragZone" x:FieldModifier="Public" Grid.Column="3"
                BackgroundColor="Transparent"
                HorizontalOptions="Fill" VerticalOptions="Fill" />

        <!-- ★ Bouton Update (visible seulement si MAJ disponible) -->
        <Border Grid.Column="4" x:Name="UpdateBadge"
                BackgroundColor="{StaticResource Accent}"
                Stroke="Transparent" StrokeThickness="0"
                StrokeShape="RoundRectangle 12"
                Padding="8,4" Margin="0,0,8,0"
                IsVisible="False">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnUpdateClicked"/>
            </Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="4">
                <Label Text="🔄" FontSize="11"/>
                <Label x:Name="UpdateLabel" Text="MAJ" FontSize="11"
                       TextColor="White" FontAttributes="Bold"/>
            </HorizontalStackLayout>
        </Border>

        <!-- Avatar (placeholder photo utilisateur) — point 11. Remplacé par du
             texte plutôt qu'une icône ambiguë (🙂 seul ne disait rien — repéré
             par Tom) : label court "Moi" au lieu d'un émoji visage. -->
        <!-- ★ REFONTE (31/08, point 14) : "Moi" (texte) → avatar rond avec
             placeholder (glyphe silhouette) — Tom veut un vrai rond, pas une
             pastille rectangulaire. Une vraie photo personnalisable (via les
             Réglages) serait la suite logique — pas construite dans cette passe
             (upload/persistance d'image), signalé à Tom plutôt que bâclé. -->
        <Border Grid.Column="5" WidthRequest="30" HeightRequest="30" Margin="0,0,4,0" StrokeThickness="0"
                BackgroundColor="{StaticResource BgSide}"
                StrokeShape="RoundRectangle 15" VerticalOptions="Center">
            <Label Text="{x:Static controls:MotoIcons.Person}" FontFamily="{x:Static controls:MotoIcons.FontFamily}"
                   FontSize="14" TextColor="{StaticResource Txt1}"
                   HorizontalOptions="Center" VerticalOptions="Center" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnGearOrAvatarTapped" />
            </Border.GestureRecognizers>
        </Border>

        <!-- ★ CORRECTION (31/08) : icône ⚙ remplacée par le texte "Paramètres" —
             demandé par Tom après coup ("ce sera mieux"). -->
        <Border Grid.Column="6" Padding="10,6"
                Margin="0,0,4,0" StrokeThickness="0" BackgroundColor="Transparent">
            <Label Text="Paramètres" FontSize="{DynamicResource FontSizeUiText}"
                   TextColor="{StaticResource Txt1}"
                   HorizontalOptions="Center" VerticalOptions="Center" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnGearOrAvatarTapped" />
            </Border.GestureRecognizers>
        </Border>

        <!-- Boutons fenêtre -->
        <Border x:Name="BtnMin" x:FieldModifier="Public" Grid.Column="7" WidthRequest="52"
                BackgroundColor="Transparent" StrokeThickness="0">
            <Label Text="─" HorizontalOptions="Center" VerticalOptions="Center"
                   FontSize="14" TextColor="{StaticResource Txt1}" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMinClicked" />
            </Border.GestureRecognizers>
        </Border>

        <Border x:Name="BtnMax" x:FieldModifier="Public" Grid.Column="8" WidthRequest="52"
                BackgroundColor="Transparent" StrokeThickness="0">
            <Label Text="□" HorizontalOptions="Center" VerticalOptions="Center"
                   FontSize="14" TextColor="{StaticResource Txt1}" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMaxClicked" />
            </Border.GestureRecognizers>
        </Border>

        <Border x:Name="BtnClose" x:FieldModifier="Public" Grid.Column="9" WidthRequest="52"
                BackgroundColor="Transparent" StrokeThickness="0">
            <Label Text="×" HorizontalOptions="Center" VerticalOptions="Center"
                   FontSize="16" TextColor="{StaticResource Txt1}" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseClicked" />
            </Border.GestureRecognizers>
        </Border>

    </Grid>
</ContentView>
