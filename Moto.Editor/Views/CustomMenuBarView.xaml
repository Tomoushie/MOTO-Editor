<?xml version="1.0" encoding="utf-8" ?>
<!--
  Moto.Editor/Views/CustomMenuBarView.xaml
  Barre de titre custom : nav (Fichiers/Recherche/Collab) + zone de drag +
  badge de mise à jour + avatar + engrenage + boutons fenêtre, TOUT sur UNE
  seule ligne. C'est LA vraie barre utilisée par MainPage (x:Name="MenuBar",
  balise <views:CustomMenuBarView>) — voir l'avertissement dans
  Controls/CustomMenuBarView.xaml(.cs) : NE PAS confondre avec ce fichier-là.

  ★ CORRECTION (31/08) : Tom demande que "Fichiers, Recherche, IA, Cortex,
  Collab" soit sur la MÊME ligne que l'engrenage/Réduire/Agrandir/Fermer,
  au lieu d'une 2e ligne en dessous (ActivityBarView, désormais retirée de
  MainPage.xaml — son code C# reste dans Controls/ActivityBarView.xaml(.cs)
  pour référence mais n'est plus instancié).
  ★ RETRAIT (31/08, point 5 de Tom) : "IA" et "Cortex" ont ensuite déménagé
  d'ici vers la nouvelle barre sous la zone de saisie de l'Accueil
  (Controls/AiComposerBarView), demandé explicitement ("bouger... et le
  mettre... dans la même ligne" que le "+"/effort/micro). Reste : Fichiers,
  Recherche, Collab. Colonnes renumérotées en conséquence.
  Ces items lèvent MenuCommanded avec les mêmes id qu'avant
  ("explorer","search","collab") ; MainPage.Routing.cs les route vers
  OnActivitySelected (code inchangé).
  ★ CORRECTION (31/08) : boutons agrandis (46→52px, police 12/14→14/16) et
  survol/clic ajoutés (AttachButtonFeedback) — demandé par Tom, gris neutre
  pour Réduire/Plein écran, rouge pour Fermer.
  ★ CORRECTION (31/08) : Label "MOTO Editor" supprimé (point 4 de Tom).
  ★ AJOUT (31/08) : avatar (placeholder) + engrenage ⚙, tous deux ouvrent le
  même petit menu déroulant (GearMenuView, câblé par MainPage) — point 1
  (engrenage déplacé ici), point 11 (avatar). Chaque tap lève
  MenuCommanded("gear.toggle") : un seul point d'entrée, MainPage bascule
  GearMenu.IsVisible.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Moto.Editor.Controls"
             x:Class="Moto.Editor.Views.CustomMenuBarView"
             HeightRequest="38"
             BackgroundColor="{StaticResource BgSide}">
    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">

        <!-- ★ AJOUT (01/10) : conteneur des 5 items de navigation (Fichiers, Recherche,
             Collaboration, Terminal, Assistant). Ils étaient posés à plat sur les
             colonnes 0-4 du Grid — pour que le réglage tb_menus (« Afficher les menus »,
             famille Fenêtre & Layout / Title Bar) puisse les masquer d'un seul geste,
             ils sont regroupés dans un seul élément. Colonnes et contenu INTERNES
             inchangés : les items occupent toujours les colonnes 0 à 4 de la barre, le
             conteneur ne fait que recevoir la propriété IsVisible.
             ⚠️ IsVisible=False fait bien disparaître l'élément du layout MAUI
             (contribution 0,0) — patron déjà utilisé ailleurs dans MainPage.xaml. -->
        <HorizontalStackLayout x:Name="NavMenus" Grid.Column="0" Grid.ColumnSpan="5" Spacing="0">

        <!-- Nav (ex-ActivityBarView, maintenant sur la même ligne) -->
        <Border Padding="12,6" Margin="14,0,0,0" StrokeThickness="0" BackgroundColor="Transparent">
            <Label Text="Fichiers" FontSize="{DynamicResource FontSizeUiText}" FontFamily="Segoe UI Variable Text"
                   TextColor="{StaticResource Txt1}" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnNavTapped" CommandParameter="explorer" />
            </Border.GestureRecognizers>
        </Border>

        <Border Padding="12,6" StrokeThickness="0" BackgroundColor="Transparent">
            <Label Text="Recherche" FontSize="{DynamicResource FontSizeUiText}" FontFamily="Segoe UI Variable Text"
                   TextColor="{StaticResource Txt1}" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnNavTapped" CommandParameter="search" />
            </Border.GestureRecognizers>
        </Border>

        <Border Padding="12,6" StrokeThickness="0" BackgroundColor="Transparent">
            <Label Text="Collaboration" FontSize="{DynamicResource FontSizeUiText}" FontFamily="Segoe UI Variable Text"
                   TextColor="{StaticResource Txt1}" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnNavTapped" CommandParameter="collab" />
            </Border.GestureRecognizers>
        </Border>

        <!-- ★ AJOUT (03/09, demandé par Tom : "pouvoir ouvrir le terminal
             directement depuis la barre de tâche du logiciel, et non pas
             uniquement via les actions suggérées"). Même patron que les 3
             items ci-dessus — CommandParameter="view.terminal" est déjà une
             vraie commande enregistrée (RegisterMenuCommands, MainPage.Routing.cs)
             qui bascule _viewModel.IsTerminalVisible ; réutilisée telle quelle,
             aucune nouvelle logique de routage nécessaire. -->
        <Border Padding="12,6" StrokeThickness="0" BackgroundColor="Transparent">
            <Label Text="Terminal" FontSize="{DynamicResource FontSizeUiText}" FontFamily="Segoe UI Variable Text"
                   TextColor="{StaticResource Txt1}" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnNavTapped" CommandParameter="view.terminal" />
            </Border.GestureRecognizers>
        </Border>

        <!-- ★ AJOUT (08/09) : Beginner Assistant (Orchestrateur) — point d'entrée UI
             direct vers Pages/BeginnerAssistantPage, routed via ai.beginnerassistant
             (MainPage.Routing.cs). Même patron que les items ci-dessus. -->
        <Border Padding="12,6" StrokeThickness="0" BackgroundColor="Transparent">
            <Label Text="Assistant" FontSize="{DynamicResource FontSizeUiText}" FontFamily="Segoe UI Variable Text"
                   TextColor="{StaticResource Txt1}" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnNavTapped" CommandParameter="ai.beginnerassistant" />
            </Border.GestureRecognizers>
        </Border>

        </HorizontalStackLayout>

        <!-- ★ AJOUT (01/10) : nom du projet et branche git courante — réglages
             tb_project_items (« Hôte et nom du projet ») et tb_branch_name
             (« Nom de branche dans la titlebar »), famille Fenêtre & Layout / Title Bar.
             Mêmes DONNÉES RÉELLES que le haut de l'explorateur (FileExplorerView) :
             nom du dossier racine ouvert, et lecture de .git/HEAD via
             FileExplorerView.ReadGitBranchShared (lecture partagée, pas dupliquée).
             Les deux badges sont masqués tant qu'aucun dossier n'est ouvert ou que le
             dossier n'est pas un dépôt git — aucune valeur inventée n'est affichée.
             Colonne 4 (stable) : juste avant la colonne élastique qui pousse le reste
             vers la droite ; ApplySettings peut la déplacer pour tb_button_layout. -->
        <HorizontalStackLayout x:Name="ProjectBadges" Grid.Column="4" Spacing="{StaticResource SpaceSm}"
                               Margin="8,0,8,0" VerticalOptions="Center" IsVisible="False">
            <Label x:Name="ProjectHostLabel" FontSize="{DynamicResource FontSizeUiSmall}"
                   TextColor="{StaticResource Txt3}" VerticalOptions="Center" />
            <Label x:Name="ProjectNameLabel" FontSize="{DynamicResource FontSizeUiSmall}"
                   TextColor="{StaticResource Txt2}" VerticalOptions="Center" />
            <Border x:Name="BranchBadge" StrokeThickness="0" Padding="6,2"
                    BackgroundColor="{StaticResource BgHover}"
                    StrokeShape="RoundRectangle 6" VerticalOptions="Center" IsVisible="False">
                <Label x:Name="BranchLabel" FontSize="{DynamicResource FontSizeUiSmall}"
                       TextColor="{StaticResource Txt2}" VerticalOptions="Center" />
            </Border>
        </HorizontalStackLayout>

        <!-- Zone de drag + contrôles de fenêtre, regroupés dans UN SEUL élément posé
             sur la colonne élastique (5). ★ AJOUT (01/10) : ce regroupement est ce qui
             permet au réglage tb_button_layout de basculer les contrôles à gauche ou à
             droite — un seul HorizontalOptions à changer au lieu de renégocier 11
             colonnes. Le bouton de mise à jour et l'avatar restent, eux, ancrés à droite
             (colonnes 6/7) : le réglage ne concerne QUE les 3 contrôles système, comme
             l'annonce le libellé « Position des contrôles de fenêtre ».
             La zone de drag ne prend que la place restante (HorizontalOptions=Fill sur
             une colonne "*") : cliquer dessus déplace la fenêtre, comportement inchangé. -->
        <Grid x:Name="WindowButtons" Grid.Column="5" ColumnDefinitions="*,Auto,Auto,Auto"
              HorizontalOptions="Fill">
            <Border x:Name="TitleBarDragZone" x:FieldModifier="Public" Grid.Column="0"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Fill" VerticalOptions="Fill" />

            <!-- Boutons fenêtre -->
            <Border x:Name="BtnMin" x:FieldModifier="Public" Grid.Column="1" WidthRequest="52"
                    BackgroundColor="Transparent" StrokeThickness="0">
                <Label Text="─" HorizontalOptions="Center" VerticalOptions="Center"
                       FontSize="{StaticResource FontSizeSubheading}" TextColor="{StaticResource Txt1}" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMinClicked" />
                </Border.GestureRecognizers>
            </Border>

            <Border x:Name="BtnMax" x:FieldModifier="Public" Grid.Column="2" WidthRequest="52"
                    BackgroundColor="Transparent" StrokeThickness="0">
                <Label Text="□" HorizontalOptions="Center" VerticalOptions="Center"
                       FontSize="{StaticResource FontSizeSubheading}" TextColor="{StaticResource Txt1}" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMaxClicked" />
                </Border.GestureRecognizers>
            </Border>

            <Border x:Name="BtnClose" x:FieldModifier="Public" Grid.Column="3" WidthRequest="52"
                    BackgroundColor="Transparent" StrokeThickness="0">
                <Label Text="×" HorizontalOptions="Center" VerticalOptions="Center"
                       FontSize="{StaticResource FontSizeHeading}" TextColor="{StaticResource Txt1}" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseClicked" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!-- ★ Bouton Update (visible seulement si MAJ disponible) -->
        <Border Grid.Column="6" x:Name="UpdateBadge"
                BackgroundColor="{StaticResource Accent}"
                Stroke="Transparent" StrokeThickness="0"
                StrokeShape="RoundRectangle 12"
                Padding="8,4" Margin="0,0,8,0"
                IsVisible="False">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnUpdateClicked"/>
            </Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="{StaticResource SpaceXs}">
                <Label Text="🔄" FontSize="11"/>
                <Label x:Name="UpdateLabel" Text="MAJ" FontSize="11"
                       TextColor="White" FontAttributes="Bold"/>
            </HorizontalStackLayout>
        </Border>

        <!-- Avatar (placeholder photo utilisateur) — point 11. Remplacé par du
             texte plutôt qu'une icône ambiguë (🙂 seul ne disait rien — repéré
             par Tom) : label court "Moi" au lieu d'un émoji visage. -->
        <!-- ★ REFONTE (31/08, point 14) : "Moi" (texte) → avatar rond avec
             placeholder (glyphe silhouette) — Tom veut un vrai rond, pas une
             pastille rectangulaire. Une vraie photo personnalisable (via les
             Réglages) serait la suite logique — pas construite dans cette passe
             (upload/persistance d'image), signalé à Tom plutôt que bâclé. -->
        <Border Grid.Column="7" WidthRequest="30" HeightRequest="30" Margin="0,0,4,0" StrokeThickness="0"
                BackgroundColor="{StaticResource BgSide}"
                StrokeShape="RoundRectangle 12" VerticalOptions="Center">
            <Label Text="{x:Static controls:MotoIcons.Person}" FontFamily="{x:Static controls:MotoIcons.FontFamily}"
                   FontSize="{StaticResource FontSizeSubheading}" TextColor="{StaticResource Txt1}"
                   HorizontalOptions="Center" VerticalOptions="Center" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnGearOrAvatarTapped" />
            </Border.GestureRecognizers>
        </Border>

        <!-- ★ RETRAIT (31/08, point 9) : bouton texte "Paramètres" supprimé — il
             ouvrait le même menu que l'avatar rond juste à côté (doublon inutile,
             repéré par Tom). L'avatar seul suffit désormais comme point d'entrée. -->

    </Grid>
</ContentView>
