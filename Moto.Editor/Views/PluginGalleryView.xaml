<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.PluginGalleryView"
             BackgroundColor="{StaticResource BgPanel}"
             WidthRequest="420">

    <!-- ★ CORRECTION (02/09, état des lieux) : en-tête interne (titre "Galerie de
         plugins" + ✕) retiré — ce panneau est sur AddFloatingPanel
         (MainPage.Panels.cs) depuis sa migration, qui fournit déjà ce même
         en-tête autour de CHAQUE panneau. Le garder ici affichait un double
         titre et deux boutons ✕ fonctionnels l'un sous l'autre. IsVisible/
         HorizontalOptions/VerticalOptions/Margin (ancien positionnement en
         coin, avant migration) retirés aussi : AddFloatingPanel gère la
         visibilité et le placement lui-même (même traitement qu'AiChatView). -->
    <Grid RowDefinitions="Auto,*,Auto"
          Padding="14"
          RowSpacing="10">

        <Entry Grid.Row="0"
               x:Name="SearchEntry"
               Placeholder="Rechercher un plugin…"
               BackgroundColor="{StaticResource BgSide}"
               TextColor="{StaticResource Txt1}"
               PlaceholderColor="{StaticResource Txt2}"
               Completed="OnSearchCompleted" />

        <ScrollView Grid.Row="1"
                    HeightRequest="420">
            <VerticalStackLayout x:Name="PluginsList"
                                 Spacing="8" />
        </ScrollView>

        <Label Grid.Row="2"
               x:Name="StatusLabel"
               Text="Prêt."
               FontSize="11"
               TextColor="{StaticResource Txt2}" />
    </Grid>
</ContentView>
