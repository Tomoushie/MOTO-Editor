<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.GitPanelView">

    <Border Background="{DynamicResource MotoCardBackground}"
            Stroke="{DynamicResource MotoCardBorder}" StrokeThickness="1" Padding="{StaticResource SpaceMd}">
        <Border.StrokeShape><RoundRectangle CornerRadius="{StaticResource RadiusLg}" /></Border.StrokeShape>

        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{StaticResource SpaceSm}">

            <!-- En-tête : branche + actions rapides -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto">
                <Label Text="🔀" FontSize="18" VerticalOptions="Center" />
                <Label Grid.Column="1" x:Name="BranchLabel" Text="branche : —"
                       FontSize="{StaticResource FontSizeSubheading}" FontAttributes="Bold" VerticalOptions="Center" Margin="8,0" />
                <Button Grid.Column="2" Text="⟳ Fetch" Clicked="OnFetchClicked" FontSize="{StaticResource FontSizeBody}" Padding="8,4" />
                <Button Grid.Column="3" Text="⬇ Pull" Clicked="OnPullClicked" FontSize="{StaticResource FontSizeBody}" Padding="8,4" Margin="6,0,0,0" />
            </Grid>

            <!-- Message de commit + bouton -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                <Entry Grid.Column="0" x:Name="CommitMessageEntry"
                       Placeholder="Message de commit…" />
                <Button Grid.Column="1" Text="✔ Commit" Clicked="OnCommitClicked" />
            </Grid>

            <!-- Listes staged / unstaged / untracked -->
            <!-- ★ MODIFIÉ (01/10, chantier gp_*) : le ScrollView est nommé pour que le réglage
                 gp_scrollbar puisse réellement piloter sa barre de défilement (Auto/Always/Never).
                 Sans nom, le réglage n'aurait aucune prise : c'est le SEUL défilement du panneau. -->
            <ScrollView Grid.Row="2" x:Name="ChangesScroll"
                        VerticalScrollBarVisibility="Default" HorizontalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="{StaticResource SpaceSm}">

                    <Label Text="📌 Staged" FontSize="{StaticResource FontSizeBody}" FontAttributes="Bold" Opacity="0.7" />
                    <CollectionView x:Name="StagedList" HeightRequest="80" SelectionMode="Single" SelectionChanged="OnChangeSelected">
                        <CollectionView.ItemTemplate>
                            <!-- ★ MODIFIÉ (01/10, chantier gp_*) : les lignes sont des GitChangeNode
                                 (et non plus des string) pour que l'affichage de statut, les stats de
                                 diff et le clic soient réellement pilotables par les réglages. Le
                                 libellé reste le chemin COMPLET renvoyé par git (rien n'est retiré de
                                 ce que le panneau affichait). -->
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="{StaticResource SpaceXs}">
                                    <Label Text="{Binding Path}" FontSize="{StaticResource FontSizeBody}" />
                                    <Label Grid.Column="1" Text="{Binding DiffStats}"
                                           WidthRequest="{Binding StatsColumnWidth}"
                                           TextColor="{StaticResource Success}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           VerticalOptions="Center" Margin="6,0" />
                                    <Button Grid.Column="2" Text="−" FontSize="11" Padding="6,0"
                                            Clicked="OnUnstageClicked" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="✏️ Unstaged" FontSize="{StaticResource FontSizeBody}" FontAttributes="Bold" Opacity="0.7" />
                    <CollectionView x:Name="UnstagedList" HeightRequest="80" SelectionMode="Single" SelectionChanged="OnChangeSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="{StaticResource SpaceXs}">
                                    <Label Text="{Binding Path}" FontSize="{StaticResource FontSizeBody}" />
                                    <Label Grid.Column="1" Text="{Binding DiffStats}"
                                           WidthRequest="{Binding StatsColumnWidth}"
                                           TextColor="{StaticResource Danger}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           VerticalOptions="Center" Margin="6,0" />
                                    <Button Grid.Column="2" Text="+" FontSize="11" Padding="6,0"
                                            Clicked="OnStageClicked" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- ★ MODIFIÉ (01/10) : groupe nommé pour que gp_collapse_untracked puisse
                         réellement replier cette section (titre ET liste), et pas seulement la liste. -->
                    <VerticalStackLayout x:Name="UntrackedGroup" Spacing="{StaticResource SpaceSm}">
                        <Label Text="❓ Untracked" FontSize="{StaticResource FontSizeBody}" FontAttributes="Bold" Opacity="0.7" />
                        <CollectionView x:Name="UntrackedList" HeightRequest="60" SelectionMode="Single" SelectionChanged="OnChangeSelected">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Padding="{StaticResource SpaceXs}">
                                        <Label Text="{Binding Path}" FontSize="{StaticResource FontSizeBody}" />
                                        <Button Grid.Column="1" Text="+" FontSize="11" Padding="6,0"
                                                Clicked="OnStageClicked" CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- ★ AJOUT (01/10) : diff RÉEL du projet (GitService.GetDiffAsync, git CLI),
                         déplié au clic sur un fichier quand gp_click_behavior vaut « Project Diff »
                         (défaut). Aucune donnée inventée : un bloc par fichier, avec les lignes
                         réellement ajoutées/retirées renvoyées par git. -->
                    <VerticalStackLayout x:Name="ProjectDiffGroup" Spacing="{StaticResource SpaceXs}" IsVisible="False">
                        <Label Text="Diff du projet" FontSize="{StaticResource FontSizeBody}" FontAttributes="Bold" Opacity="0.7" />
                        <CollectionView x:Name="DiffList" HeightRequest="220" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="2" Padding="{StaticResource SpaceXs}">
                                        <Label Text="{Binding FilePath}" FontSize="{StaticResource FontSizeBody}" FontAttributes="Bold" />
                                        <Label Text="{Binding Summary}" FontSize="{StaticResource FontSizeBody}" TextColor="{StaticResource Txt2}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Barre d'actions secondaires + statut -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="{StaticResource SpaceXs}">
                <Button Text="⬆ Push" Clicked="OnPushClicked" FontSize="{StaticResource FontSizeBody}" Padding="8,4" />
                <Button Grid.Column="1" Text="🌿 Branches" Clicked="OnBranchesClicked" FontSize="{StaticResource FontSizeBody}" Padding="8,4" />
                <Button Grid.Column="2" Text="📜 Log" Clicked="OnLogClicked" FontSize="{StaticResource FontSizeBody}" Padding="8,4" />
                <Label Grid.Column="3" x:Name="StatusLabel" Text="Prêt"
                       FontSize="11" Opacity="0.6" HorizontalOptions="End" VerticalOptions="Center" />
            </Grid>
        </Grid>
    </Border>
</ContentView>
