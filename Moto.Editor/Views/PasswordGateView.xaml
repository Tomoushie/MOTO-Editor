<!-- Moto.Editor/Views/PasswordGateView.xaml -->
<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.PasswordGateView">

    <Border StrokeShape="RoundRectangle 12"
            Stroke="#3A3B40"
            BackgroundColor="#1A1B1F"
            WidthRequest="320" Padding="20">

        <VerticalStackLayout Spacing="12">

            <Label Text="🔒 Projet verrouillé" FontSize="18" FontAttributes="Bold" />
            <Label Text="Ce projet est protégé par mot de passe." FontSize="12" Opacity="0.7" />

            <Entry x:Name="PasswordEntry"
                   IsPassword="True"
                   Placeholder="Mot de passe"
                   Completed="OnUnlockClicked" />

            <Button Text="Déverrouiller" Clicked="OnUnlockClicked" />

            <Label x:Name="ErrorLabel" TextColor="OrangeRed" FontSize="11" IsVisible="False" />

        </VerticalStackLayout>

    </Border>

</ContentView>
