<?xml version="1.0" encoding="utf-8" ?>
<!--
  Moto.Editor/Views/HomeView.xaml
  Corrigé : ContentView n'accepte qu'un seul enfant direct, or ce fichier en
  avait trois côte à côte (un MotoLogoView de 36px visiblement destiné à
  SidebarView d'après son propre commentaire "à insérer EN HAUT de la barre
  latérale" — retiré d'ici — puis un VerticalStackLayout et un ScrollView
  jamais réunis). Regroupés dans un seul Grid (en-tête + contenu déroulant).
  xmlns:controls manquait aussi (MotoLogoView est dans Moto.Editor.Controls).
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Moto.Editor.Controls"
             x:Class="Moto.Editor.Views.HomeView">

    <!-- ★ CORRECTION (31/08) : léger dégradé au lieu d'un fond plat — proposé par
         Qwen, syntaxe MAUI standard vérifiée (LinearGradientBrush/GradientStop
         existent dans l'espace de noms par défaut, contrairement à Ellipse/formes
         qui en ont un séparé — non utilisé ici pour rester prudent sur un premier
         essai). Très subtil : mêmes teintes que BgApp, juste une variation légère. -->
    <ContentView.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#171B21" Offset="0" />
            <GradientStop Color="#111419" Offset="1" />
        </LinearGradientBrush>
    </ContentView.Background>

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,40,0,0"
                              HorizontalOptions="Center" VerticalOptions="Start">
            <!-- ★ AJOUT (31/08) : halo doux derrière le logo (effet "spotlight" façon
                 Zed/Qwen) — un Border circulaire semi-transparent plutôt qu'un
                 dégradé radial (RadialGradientBrush non testé dans ce fichier,
                 préféré rester sur des éléments déjà éprouvés dans ce projet). -->
            <Grid HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="160" HeightRequest="160">
                <Border WidthRequest="160" HeightRequest="160" StrokeThickness="0"
                        BackgroundColor="{StaticResource Accent}" Opacity="0.12"
                        StrokeShape="RoundRectangle 80" HorizontalOptions="Center" VerticalOptions="Center" />
                <controls:MotoLogoView Size="112" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
            <Label Text="MOTO Editor"
                   FontSize="30" FontAttributes="Bold"
                   HorizontalOptions="Center" />
            <Label Text="Léger. Rapide. Sans dépendance. Tout fait maison."
                   FontSize="13" Opacity="0.7"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                                 Spacing="22" Padding="40" MaximumWidthRequest="760">

                <!-- Greeting style Claude Code -->
                <Label x:Name="GreetingLabel" Text="Quoi de prévu, Tom ?"
                       FontSize="26" HorizontalOptions="Center" />

                <!-- Stats (sessions, messages, tokens…) -->
                <!-- ★ CORRECTION (30/08) : WidthRequest fixe ajouté — sans largeur
                     explicite, ce Border (et celui de la saisie juste en dessous) se
                     redimensionnait au contenu (le texte tapé dans PromptEntry
                     l'élargissait visiblement) au lieu de rester stable, repéré par Tom. -->
                <Border Stroke="{StaticResource BorderCol}" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource BgPanel}" Padding="16" WidthRequest="560">
                    <Grid x:Name="StatsGrid" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="10" RowSpacing="10" />
                </Border>

                <!-- Input central style ChatGPT/Claude -->
                <Border Stroke="{StaticResource BorderCol}" StrokeShape="RoundRectangle 24"
                        BackgroundColor="{StaticResource BgPanel}" Padding="6,2" WidthRequest="560">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Text="＋" WidthRequest="36"
                                Clicked="OnAttachClicked" />
                        <Entry Grid.Column="1" x:Name="PromptEntry"
                               Placeholder="Décris une tâche ou pose une question."
                               BackgroundColor="Transparent"
                               Completed="OnPromptSubmitted" />
                        <Button Grid.Column="2" Text="➤" WidthRequest="36"
                                Clicked="OnPromptSubmitted" />
                    </Grid>
                </Border>

                <!-- Chips contexte (Local / Projet / +) -->
                <!-- ★ CORRECTION (31/08, point 3) : chips agrandies (Padding 10,4→16,10,
                     FontSize 11→13 — Tom les trouvait trop petites). "📁 Projet logiciel"
                     renommé "🔍 Rechercher projet" : ce bouton ouvre en réalité le
                     sélecteur de dossier (OnImportClicked, voir MainPage.xaml.cs) — ce
                     n'est PAS un raccourci vers un projet précis nommé "Projet logiciel"
                     déjà sélectionné par défaut, contrairement à ce que le texte laissait
                     penser (repéré par Tom). -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                    <!-- ★ CORRECTION (31/08) : emojis → glyphes vectoriels (Segoe Fluent
                         Icons, codepoints vérifiés visuellement) — FormattedText/Span
                         nécessaire pour mélanger la police d'icône et le texte normal
                         dans un même Label. -->
                    <Border Stroke="{StaticResource BorderCol}" StrokeShape="RoundRectangle 10"
                            Padding="16,10" BackgroundColor="{StaticResource BgPanel}">
                        <Label FontSize="13">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static controls:MotoIcons.Devices}" FontFamily="{x:Static controls:MotoIcons.FontFamily}" />
                                    <Span Text="  Local" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLocalChipTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Border Stroke="{StaticResource BorderCol}" StrokeShape="RoundRectangle 10"
                            Padding="16,10" BackgroundColor="{StaticResource BgPanel}">
                        <Label FontSize="13">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static controls:MotoIcons.Search}" FontFamily="{x:Static controls:MotoIcons.FontFamily}" />
                                    <Span Text="  Rechercher projet" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProjectChipTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentView>