<?xml version="1.0" encoding="utf-8" ?>
<!--
  Moto.Editor/Views/HomeView.xaml
  Corrigé : ContentView n'accepte qu'un seul enfant direct, or ce fichier en
  avait trois côte à côte (un MotoLogoView de 36px visiblement destiné à
  SidebarView d'après son propre commentaire "à insérer EN HAUT de la barre
  latérale" — retiré d'ici — puis un VerticalStackLayout et un ScrollView
  jamais réunis). Regroupés dans un seul Grid (en-tête + contenu déroulant).
  xmlns:controls manquait aussi (MotoLogoView est dans Moto.Editor.Controls).
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Moto.Editor.Controls"
             x:Class="Moto.Editor.Views.HomeView">

    <!-- ★ CORRECTION (31/08) : léger dégradé au lieu d'un fond plat — proposé par
         Qwen, syntaxe MAUI standard vérifiée (LinearGradientBrush/GradientStop
         existent dans l'espace de noms par défaut, contrairement à Ellipse/formes
         qui en ont un séparé — non utilisé ici pour rester prudent sur un premier
         essai). Très subtil : mêmes teintes que BgApp, juste une variation légère. -->
    <ContentView.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#171B21" Offset="0" />
            <GradientStop Color="#111419" Offset="1" />
        </LinearGradientBrush>
    </ContentView.Background>

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,40,0,0"
                              HorizontalOptions="Center" VerticalOptions="Start">
            <!-- ★ RETRAIT (31/08, point 7) : le halo ajouté au tour précédent était
                 perçu par Tom comme le même "fond gris/noir derrière le logo" qu'il
                 avait déjà fait enlever une fois (MotoLogoBackground, un tour encore
                 plus tôt) — retiré pour de bon, fond transparent, sans exception. -->
            <controls:MotoLogoView Size="112" HorizontalOptions="Center" />
            <Label Text="MOTO Editor"
                   FontSize="30" FontAttributes="Bold"
                   HorizontalOptions="Center" />
            <Label Text="Léger. Rapide. Sans dépendance. Tout fait maison."
                   FontSize="13" Opacity="0.7"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- ★ CORRECTION (31/08, point 6) : padding haut réduit (40→15) — Tom voulait
             tout le contenu à partir de "Quoi de prévu" remonté de ~20-30px, sans
             bouger le logo (Row 0, inchangé). -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                                 Spacing="22" Padding="40,15,40,40" MaximumWidthRequest="760">

                <!-- Greeting style Claude Code -->
                <Label x:Name="GreetingLabel" Text="Quoi de prévu, Tom ?"
                       FontSize="26" HorizontalOptions="Center" />

                <!-- Stats (sessions, messages, tokens…) -->
                <!-- ★ CORRECTION (30/08) : WidthRequest fixe ajouté — sans largeur
                     explicite, ce Border (et celui de la saisie juste en dessous) se
                     redimensionnait au contenu (le texte tapé dans PromptEntry
                     l'élargissait visiblement) au lieu de rester stable, repéré par Tom.
                     ★ CORRECTION (31/08, point 1) : légèrement plus compacte
                     (Padding 16→13,12, ColumnSpacing/RowSpacing 10→8). -->
                <Border Stroke="{StaticResource BorderCol}" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource BgPanel}" Padding="13,12" WidthRequest="555">
                    <Grid x:Name="StatsGrid" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="8" RowSpacing="8" />
                </Border>

                <!-- ★ RÉORGANISÉ (31/08, points 3/4 de Tom) : ordre calqué sur la
                     référence Claude Code — chips AU-DESSUS de la saisie (petit
                     écart), barre de contrôles (+/micro/IA/Cortex/modèle/Puissance/
                     budget) COLLÉE juste EN DESSOUS. Regroupés dans leur propre
                     VerticalStackLayout à espacement réduit (10, au lieu des 22 du
                     reste de la page) — ces 3 blocs forment un seul ensemble visuel. -->
                <VerticalStackLayout Spacing="10">

                    <!-- Chips contexte (Local / Rechercher projet / dossier) -->
                    <!-- ★ CORRECTION (31/08, point 3 précédent) : chips agrandies,
                         "📁 Projet logiciel" renommé "🔍 Rechercher projet" : ce
                         bouton ouvre en réalité le sélecteur de dossier — ce n'est
                         PAS un raccourci vers un projet précis déjà sélectionné par
                         défaut, contrairement à ce que le texte laissait penser.
                         ★ AJOUT (31/08, point 4) : 3e chip "dossier" (icône seule,
                         même action que "Rechercher projet" — pas d'autre
                         comportement précisé par Tom pour l'instant).
                         ★ CORRECTION (31/08, point 1) : LocationMenu (Emplacement
                         d'exécution) ancré juste AU-DESSUS de la chip "Local". -->
                    <!-- ★ CORRECTION (31/08, point 9) : HeightRequest FIXE sur ce Grid
                         (juste assez pour la ligne de chips) — sans ça, ce Grid grandit
                         avec LocationMenu quand elle s'ouvre (hauteur "Auto" par défaut,
                         basée sur le plus grand enfant), ce qui repoussait la saisie et
                         la barre du dessous (repéré par Tom : "changera la taille du
                         reste"). Un Grid MAUI n'est PAS automatiquement rogné à ses
                         limites : avec une hauteur fixe, LocationMenu peut déborder
                         par-dessus sans agrandir ce Grid ni rien pousser en dessous. -->
                    <!-- ★ CORRECTION (31/08, point 4) : 48→44 (les chips avaient quelques
                         px de trop en bas) + VerticalOptions="Center" explicite sur la
                         ligne de chips (sans ça, l'alignement par défaut du Grid pouvait
                         laisser un espace résiduel en bas plutôt que centrer). -->
                    <Grid HeightRequest="44">
                        <controls:ExecutionLocationMenu x:Name="LocationMenu"
                                                         HorizontalOptions="Start" VerticalOptions="End"
                                                         Margin="0,0,0,46" IsVisible="False" />
                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                            <!-- ★ CORRECTION (31/08) : emojis → glyphes vectoriels (Segoe
                                 Fluent Icons, codepoints vérifiés visuellement) —
                                 FormattedText/Span nécessaire pour mélanger la police
                                 d'icône et le texte normal dans un même Label. -->
                            <Border Stroke="{StaticResource BorderCol}" StrokeShape="RoundRectangle 10"
                                    Padding="16,10" BackgroundColor="{StaticResource BgPanel}">
                                <Label FontSize="13">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static controls:MotoIcons.Devices}" FontFamily="{x:Static controls:MotoIcons.FontFamily}" />
                                            <Span Text="  Local" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLocalChipTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                            <Border Stroke="{StaticResource BorderCol}" StrokeShape="RoundRectangle 10"
                                    Padding="16,10" BackgroundColor="{StaticResource BgPanel}">
                                <Label FontSize="13">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static controls:MotoIcons.Search}" FontFamily="{x:Static controls:MotoIcons.FontFamily}" />
                                            <Span Text="  Rechercher projet" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnProjectChipTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                            <!-- ★ AJOUT (31/08, point 11) : petit "+" superposé sur le
                                 dossier (glyphes Folder+Add, tous deux déjà vérifiés). -->
                            <Border Stroke="{StaticResource BorderCol}" StrokeShape="RoundRectangle 10"
                                    Padding="12,10" BackgroundColor="{StaticResource BgPanel}">
                                <Grid>
                                    <Label Text="{x:Static controls:MotoIcons.Folder}" FontFamily="{x:Static controls:MotoIcons.FontFamily}"
                                           FontSize="13" TextColor="{StaticResource Txt1}" />
                                    <!-- ★ CORRECTION (31/08, point 3) : repositionné en haut à
                                         droite, marge minimale (1px) comme demandé. -->
                                    <Label Text="{x:Static controls:MotoIcons.Add}" FontFamily="{x:Static controls:MotoIcons.FontFamily}"
                                           FontSize="7" TextColor="{StaticResource Txt1}"
                                           HorizontalOptions="End" VerticalOptions="Start" Margin="0,1,1,0" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnProjectChipTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Input central style ChatGPT/Claude -->
                    <!-- ★ RETRAIT (31/08, point 5) : "+" à l'intérieur de la saisie
                         supprimé — doublon avec le "+" de la barre de contrôles
                         juste en dessous (ComposerBar). -->
                    <Border Stroke="{StaticResource BorderCol}" StrokeShape="RoundRectangle 24"
                            BackgroundColor="{StaticResource BgPanel}" Padding="14,2,6,2" WidthRequest="560">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Grid.Column="0" x:Name="PromptEntry"
                                   Placeholder="Décris une tâche ou pose une question."
                                   BackgroundColor="Transparent"
                                   Completed="OnPromptSubmitted" />
                            <!-- ★ AJOUT (31/08, point 2) : fond + animation au survol
                                 (voir .xaml.cs, HoverEffects + ScaleTo). -->
                            <Border x:Name="SendArrowHost" Grid.Column="1"
                                    WidthRequest="34" HeightRequest="34"
                                    BackgroundColor="Transparent" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 17">
                                <Label x:Name="SendArrowLabel" Text="➤" FontSize="14" TextColor="{StaticResource Txt1}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSendArrowTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ★ AJOUT (31/08, points 2/3/4/5 de Tom) : barre façon Claude Code
                         collée sous la zone de saisie — voir Controls/AiComposerBarView. -->
                    <controls:AiComposerBarView x:Name="ComposerBar" WidthRequest="560" />

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentView>