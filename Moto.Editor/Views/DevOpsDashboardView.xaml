<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.DevOpsDashboardView">

    <Border Background="{DynamicResource MotoCardBackground}"
            Stroke="{DynamicResource MotoCardBorder}" StrokeThickness="1" Padding="16">
        <Border.StrokeShape><RoundRectangle CornerRadius="{StaticResource RadiusLg}" /></Border.StrokeShape>

        <Grid RowDefinitions="Auto,*" RowSpacing="12">
            <Label Grid.Row="0" Text="📊 DevOps Dashboard" FontSize="18" FontAttributes="Bold" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="12">

                    <!-- PerfGate -->
                    <Border Padding="12" Background="{DynamicResource MotoSubtleBackground}"
                            Stroke="{DynamicResource MotoCardBorder}" StrokeThickness="1">
                        <Border.StrokeShape><RoundRectangle CornerRadius="{StaticResource RadiusMd}" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="⚡ Perf Gate" FontSize="{StaticResource FontSizeSubheading}" FontAttributes="Bold" />
                            <Label x:Name="StartupLabel" Text="Startup : —" FontSize="{StaticResource FontSizeBody}" />
                            <Label x:Name="MemoryLabel" Text="Mémoire : —" FontSize="{StaticResource FontSizeBody}" />
                            <Label x:Name="GateStatusLabel" Text="Gate : —" FontSize="{StaticResource FontSizeBody}" FontAttributes="Italic" />
                            <Button Text="Capturer métriques" Clicked="OnCaptureMetricsClicked" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Crash Triage -->
                    <Border Padding="12" Background="{DynamicResource MotoSubtleBackground}"
                            Stroke="{DynamicResource MotoCardBorder}" StrokeThickness="1">
                        <Border.StrokeShape><RoundRectangle CornerRadius="{StaticResource RadiusMd}" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="💥 Crash Triage" FontSize="{StaticResource FontSizeSubheading}" FontAttributes="Bold" />
                            <Label x:Name="CrashCountLabel" Text="Groupes de crash : —" FontSize="{StaticResource FontSizeBody}" />
                            <Label x:Name="CrashHintLabel" Text="" FontSize="11" Opacity="0.7" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Feature Flags -->
                    <Border Padding="12" Background="{DynamicResource MotoSubtleBackground}"
                            Stroke="{DynamicResource MotoCardBorder}" StrokeThickness="1">
                        <Border.StrokeShape><RoundRectangle CornerRadius="{StaticResource RadiusMd}" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="🚩 Feature Flags" FontSize="{StaticResource FontSizeSubheading}" FontAttributes="Bold" />
                            <CollectionView x:Name="FlagsList">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto" Padding="2">
                                            <Label Text="{Binding Name}" FontSize="{StaticResource FontSizeBody}" VerticalOptions="Center" />
                                            <Switch Grid.Column="1" IsToggled="{Binding IsEnabled}"
                                                    Toggled="OnFlagToggled" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Border>
</ContentView>
