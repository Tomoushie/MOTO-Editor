<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.ProactiveActionsView"
             IsVisible="False"
             BackgroundColor="Transparent"
             HorizontalOptions="End"
             VerticalOptions="End">

    <Border WidthRequest="320"
            Margin="20"
            BackgroundColor="{StaticResource BgPanel}"
            Stroke="{StaticResource BgHover}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            Padding="12">

        <Grid RowDefinitions="Auto,*" RowSpacing="8">

            <!-- ★ AJOUT (03/09, demandé par Tom) : en-tête devenu une poignée de
                 déplacement (PanGestureRecognizer, voir le code-behind) — clic-glissé
                 n'importe où dans le bandeau titre déplace tout le panneau, comme une
                 mini barre de titre. Bouton ✕ à droite pour le fermer : ferme
                 immédiatement et ne réapparaît PAS tant que les suggestions restent
                 les mêmes (UpdateActions plus bas compare à la dernière liste montrée) ;
                 redevient visible dès qu'un contexte différent produit de nouvelles
                 suggestions, sans action requise de Tom. -->
            <Grid ColumnDefinitions="*,Auto">
                <Grid.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnHeaderPanUpdated" />
                </Grid.GestureRecognizers>

                <Label Text="💡 Actions suggérées"
                       FontSize="{StaticResource FontSizeBody}"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Accent}"
                       InputTransparent="True" />

                <Button Grid.Column="1"
                        Text="✕"
                        FontSize="{StaticResource FontSizeBody}"
                        Padding="0"
                        WidthRequest="24"
                        HeightRequest="24"
                        CornerRadius="{StaticResource RadiusLg}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Txt2}"
                        Clicked="OnCloseClicked" />
            </Grid>

            <ScrollView Grid.Row="1"
                        HeightRequest="180">
                <VerticalStackLayout x:Name="ActionsList"
                                     Spacing="6" />
            </ScrollView>
        </Grid>
    </Border>
</ContentView>
