<?xml version="1.0" encoding="utf-8" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Moto.Editor.Views.ModelConsentDialog">
    <Grid Background="{StaticResource OverlayBackgroundBrush}">
        <Border Background="{StaticResource PanelBackgroundBrush}"
                CornerRadius="12" Padding="24"
                MaxWidth="520" MaxHeight="500"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <ScrollViewer>
                <StackPanel Spacing="16">
                    <TextBlock Text="⬇️ Télécharger un modèle IA"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>

                    <!-- Tier sélectionné -->
                    <Border Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="8" Padding="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="ModelNameText" Text="Qwen2.5-7B Q4_K_M"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"/>
                                <TextBlock x:Name="ModelDescText" Text="Modèle 7B quantizé"
                                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="ModelSizeText" Text="4.5 GB"
                                       Grid.Column="1" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Espace disque requis -->
                    <Border Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="8" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="💾 Espace disque requis" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock x:Name="DiskSpaceText"
                                       Text="Espace disponible : calcul en cours..."
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBlock x:Name="DiskSpaceWarning" Text=""
                                       FontSize="12" Foreground="{StaticResource ErrorBrush}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Confidentialité -->
                    <Border Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="8" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="🔒 Confidentialité" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="✅ Aucune donnée envoyée hors de votre machine"
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBlock Text="✅ Modèle stocké localement et vérifié par checksum SHA256"
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBlock Text="✅ Téléchargement via HTTPS avec vérification d'intégrité"
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Opt-in télémétrie -->
                    <CheckBox x:Name="TelemetryOptInCheck"
                              Content="Autoriser la télémétrie anonyme (opt-in, désactivé par défaut)"
                              FontSize="12"
                              Foreground="{StaticResource SecondaryTextBrush}"
                              IsChecked="False"/>

                    <!-- Progression (masquée par défaut) -->
                    <StackPanel x:Name="ProgressPanel" Spacing="8" Visibility="Collapsed">
                        <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Value="0" Height="8"/>
                        <TextBlock x:Name="ProgressText" Text="0%" FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <!-- Boutons -->
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                        <Button Content="Annuler" Click="OnCancelClicked" Padding="16,8"
                                Background="Transparent"
                                Foreground="{StaticResource SecondaryTextBrush}"/>
                        <Button x:Name="DownloadBtn" Content="⬇️ Télécharger et vérifier"
                                Click="OnDownloadClicked" Padding="16,8"
                                Background="{StaticResource AccentBrush}" Foreground="White"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
