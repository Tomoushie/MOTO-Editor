<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Moto.Editor.Views"
             x:Class="Moto.Editor.Views.AiChatView"
             BackgroundColor="{StaticResource BgSide}">

    <ContentView.Resources>
        <ResourceDictionary>
            <!-- ★ AJOUT (03/09, bouton "copier" manquant sur le code) : distingue
                 texte normal / bloc de code dans une réponse IA (ChatMessage.Segments). -->
            <local:ChatSegmentSelector x:Key="SegmentSelector">
                <local:ChatSegmentSelector.TextTemplate>
                    <DataTemplate>
                        <Label Text="{Binding Text}" FontSize="{StaticResource FontSizeBody}" TextColor="White" />
                    </DataTemplate>
                </local:ChatSegmentSelector.TextTemplate>
                <local:ChatSegmentSelector.CodeTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 6" Stroke="{StaticResource BorderCol}"
                                BackgroundColor="#171614" Padding="8,6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding Text}" FontFamily="Consolas"
                                       FontSize="11.5" TextColor="#C9C4BC" LineBreakMode="CharacterWrap" />
                                <Button Grid.Column="1" Text="Copier" FontSize="{StaticResource FontSizeSmall}" Padding="6,2"
                                        VerticalOptions="Start" BackgroundColor="Transparent"
                                        TextColor="{StaticResource Txt2}"
                                        Clicked="OnCopyCodeClicked" BindingContext="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </local:ChatSegmentSelector.CodeTemplate>
            </local:ChatSegmentSelector>
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Padding="{StaticResource SpaceXs}">

        <!-- ★ CORRECTION (02/09, réveil de ce panneau) : ancien en-tête (glisser +
             titre "MOTO AI" + ⇄ changer de côté + ✕ fermer) retiré — ce panneau
             est maintenant branché comme tous les autres panneaux IA (Cortex,
             Neural, Workspace...) via AddFloatingPanel (MainPage.Panels.cs), qui
             fournit DÉJÀ ce même en-tête (titre + ✕) autour de CHAQUE panneau,
             plus le glisser-déposer pour réordonner/changer de dock. Le garder
             ici aurait doublé titre/fermeture/glisser. Seules les 2 actions
             propres à CE panneau (nouvelle conversation / vider) restent, en
             petite barre d'actions. -->
        <HorizontalStackLayout Grid.Row="0" Spacing="{StaticResource SpaceXs}" Padding="0,0,0,4">

            <Button Text="＋" FontSize="11"
                    Style="{StaticResource MotoHoverIconButton}"
                    ToolTipProperties.Text="Nouvelle conversation"
                    Clicked="OnNewThreadClicked" />

            <Button Text="🗑" FontSize="11"
                    Style="{StaticResource MotoHoverIconButton}"
                    ToolTipProperties.Text="/clear"
                    Clicked="OnClearClicked" />

        </HorizontalStackLayout>

        <!-- Messages -->
        <CollectionView Grid.Row="1" x:Name="MessageList" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- ★ CORRECTION (02/09, retouche "vrai Zed") : cette bulle n'avait
                         aucune bordure (Stroke absent malgré StrokeShape défini) — un pur
                         aplat de couleur sans définition. Le vrai code de Zed (agent_ui/
                         message_editor.rs, message list / thread view) ne mise jamais sur
                         un simple bloc de couleur : les surfaces s'appuient sur des jetons
                         de thème + une bordure fine, jamais un aplat isolé. Stroke ajouté
                         (BorderSoft, déjà utilisé pour les séparateurs discrets du thème),
                         rayon réduit 10→8 pour rester cohérent avec le reste de l'appli
                         (MotoHoverButton/boutons d'icône utilisent déjà 8). -->
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{StaticResource BorderSoft}" StrokeThickness="1"
                            BackgroundColor="{Binding BubbleColor}"
                            Padding="10,6" Margin="4,3"
                            MaximumWidthRequest="420"
                            HorizontalOptions="{Binding Alignment}">
                        <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                            <!-- ★ CORRIGÉ (03/09) : Label plat unique remplacé par un rendu
                                 par segments (Segments, voir ChatMessage.cs) — permet de
                                 distinguer un bloc de code (police mono + bouton copier) du
                                 reste, ce qu'un seul Label ne pouvait pas faire. -->
                            <VerticalStackLayout Spacing="{StaticResource SpaceXs}"
                                                 BindableLayout.ItemsSource="{Binding Segments}"
                                                 BindableLayout.ItemTemplateSelector="{StaticResource SegmentSelector}" />
                            <Label Text="{Binding TimeLabel}" FontSize="{StaticResource FontSizeSmall}"
                                   TextColor="{StaticResource Txt2}" HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Contexte attaché -->
        <CollectionView Grid.Row="2" x:Name="ContextList"
                        HeightRequest="28" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="{StaticResource SpaceXs}" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource BgPanel}" Stroke="{StaticResource BorderCol}" Padding="8,2">
                        <Label Text="{Binding Label}" FontSize="{StaticResource FontSizeSmall}" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Suggestions slash -->
        <ListView Grid.Row="3" x:Name="SlashList" HeightRequest="100"
                  IsVisible="False" BackgroundColor="{StaticResource BgPanel}"
                  ItemSelected="OnSlashSelected" />

        <!-- Zone de saisie + barre mode/modèle (structure type agent) -->
        <Border Grid.Row="4" StrokeShape="RoundRectangle 8"
                Stroke="{StaticResource BorderCol}" BackgroundColor="{StaticResource BgApp}" Padding="{StaticResource SpaceXs}">

            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">

                <Entry Grid.Row="0" Grid.ColumnSpan="3" x:Name="InputEntry"
                       Placeholder="Message MOTO AI, @ pour le contexte, / pour les commandes"
                       BackgroundColor="Transparent" FontSize="{StaticResource FontSizeBody}"
                       TextChanged="OnInputTextChanged"
                       Completed="OnSendClicked" />

                <Button Grid.Row="1" Grid.Column="0" Text="📎" FontSize="11"
                        Style="{StaticResource MotoHoverIconButton}"
                        ToolTipProperties.Text="Attacher fichier / sélection"
                        Clicked="OnAttachClicked" />

                <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="{StaticResource SpaceXs}">

                    <Picker x:Name="ModePicker" FontSize="{StaticResource FontSizeSmall}" WidthRequest="120">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Chat</x:String>
                                <x:String>Chat &amp; Write</x:String>
                                <x:String>Agent</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>

                    <Picker x:Name="ModelPicker" FontSize="{StaticResource FontSizeSmall}" WidthRequest="150"
                            SelectedIndexChanged="OnModelChanged">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>MOTO interne</x:String>
                                <x:String>Ollama (qwen2.5-coder:7b)</x:String>
                                <x:String>OpenAI</x:String>
                                <x:String>Anthropic</x:String>
                                <x:String>Mistral</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>

                </HorizontalStackLayout>

                <Button Grid.Row="1" Grid.Column="2" Text="➤"
                        Style="{StaticResource MotoHoverIconButton}" Padding="8,2"
                        Clicked="OnSendClicked" />

            </Grid>

        </Border>

    </Grid>

</ContentView>
