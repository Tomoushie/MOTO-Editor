<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             xmlns:local="clr-namespace:Moto.Editor.Views"
             xmlns:controls="clr-namespace:Moto.Editor.Controls"
             x:Class="Moto.Editor.Views.AiChatView"
             BackgroundColor="{StaticResource BgSide}">

    <ContentView.Resources>
        <ResourceDictionary>
            <!-- ★ AJOUT (01/10, lot agent_*) : police du texte du panneau IA
                 (réglage agent_font_size, défaut déclaré 13 = valeur de
                 FontSizeBody → aucun pixel ne bouge tant que Tom n'y touche pas).
                 La valeur est ensuite RECRITE par
                 MainPage.ApplyAgentAndCollabPanelSettings (ressource posée sur la
                 vue, en DynamicResource ci-dessous) — même filet + mécanisme que
                 TerminalFontSize du dock du bas. Le Double statique ici garantit
                 qu'une clé existe TOUJOURS (jamais de DynamicResource orphelin). -->
            <sys:Double x:Key="AgentFontSize">13</sys:Double>
            <!-- ★ AJOUT (03/09, bouton "copier" manquant sur le code) : distingue
                 texte normal / bloc de code dans une réponse IA (ChatMessage.Segments). -->
            <local:ChatSegmentSelector x:Key="SegmentSelector">
                <local:ChatSegmentSelector.TextTemplate>
                    <DataTemplate>
                        <Label Text="{Binding Text}" FontSize="{DynamicResource AgentFontSize}" TextColor="{StaticResource Txt1}" LineHeight="1.15" />
                    </DataTemplate>
                </local:ChatSegmentSelector.TextTemplate>
                <local:ChatSegmentSelector.CodeTemplate>
                    <DataTemplate>
                        <!-- ★ CHANGÉ (24/09, chat en flux) : en-tête « langage · fichier » au-dessus du code (le nom de fichier annoncé par le
                             modèle n'est plus mélangé à la première ligne du code), bouton Copier à droite de cet en-tête. -->
                        <!-- ★ AJOUT (25/09, « Appliquer ») : bouton qui pose ce bloc dans le fichier affiché — diff et confirmation dans la
                             fenêtre principale, « ↩ Annuler » ensuite dans le bandeau IA. Absent sur un bloc coupé ou écrit par l'utilisateur.
                             Sous le code, une ligne dit ce qu'a donné le dernier clic (appliqué, refusé, ou pourquoi rien n'a été fait). -->
                        <!-- ★ (25/09, passe « moyen → élevé ») : bloc de code aux couleurs de l'éditeur (fond BgEditor, texte clair
                             neutre) au lieu d'un noir chaud qui jurait avec le reste ; « Appliquer » en bleu lisible (AccentText). -->
                        <Border StrokeShape="RoundRectangle 6" Stroke="{StaticResource BorderCol}"
                                BackgroundColor="{StaticResource BgEditor}" Padding="8,4,8,6">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Header}" FontFamily="Consolas"
                                       FontSize="10.5" TextColor="{StaticResource Txt2}" VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                                <Button Grid.Row="0" Grid.Column="1" Text="Appliquer" FontSize="{StaticResource FontSizeSmall}" Padding="6,2"
                                        VerticalOptions="Start" BackgroundColor="Transparent"
                                        TextColor="{StaticResource AccentText}" IsVisible="{Binding CanApply}"
                                        ToolTipProperties.Text="Poser ce code dans le fichier affiché : tu vois le diff et tu décides. Pour choisir l'endroit, sélectionne dans l'éditeur le passage à remplacer (ou clique là où insérer) avant."
                                        Clicked="OnApplyCodeClicked" />
                                <Button Grid.Row="0" Grid.Column="2" Text="Copier" FontSize="{StaticResource FontSizeSmall}" Padding="6,2"
                                        VerticalOptions="Start" BackgroundColor="Transparent"
                                        TextColor="{StaticResource Txt2}"
                                        Clicked="OnCopyCodeClicked" BindingContext="{Binding .}" />
                                <Label Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Text}" FontFamily="Consolas"
                                       FontSize="11.5" TextColor="#D4D4D4" LineBreakMode="CharacterWrap" />
                                <Label Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding ApplyStatus}" IsVisible="{Binding HasApplyStatus}"
                                       FontSize="{StaticResource FontSizeSmall}" TextColor="{StaticResource Txt1}" Margin="0,4,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </local:ChatSegmentSelector.CodeTemplate>
            </local:ChatSegmentSelector>
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Padding="{StaticResource SpaceXs}">

        <!-- ★ CORRECTION (02/09, réveil de ce panneau) : ancien en-tête (glisser +
             titre "MOTO AI" + ⇄ changer de côté + ✕ fermer) retiré — ce panneau
             est maintenant branché comme tous les autres panneaux IA (Cortex,
             Neural, Workspace...) via AddFloatingPanel (MainPage.Panels.cs), qui
             fournit DÉJÀ ce même en-tête (titre + ✕) autour de CHAQUE panneau,
             plus le glisser-déposer pour réordonner/changer de dock. Le garder
             ici aurait doublé titre/fermeture/glisser. Seules les 2 actions
             propres à CE panneau (nouvelle conversation / vider) restent, en
             petite barre d'actions. -->
        <HorizontalStackLayout Grid.Row="0" Spacing="{StaticResource SpaceXs}" Padding="0,0,0,4">

            <!-- ★ (25/09) : glyphes du thème (＋ et 🗑 étaient des caractères texte/emoji). -->
            <Button Text="{x:Static controls:MotoIcons.Add}" FontSize="12"
                    Style="{StaticResource MotoIconButton}"
                    ToolTipProperties.Text="Nouvelle conversation"
                    Clicked="OnNewThreadClicked" />

            <Button Text="{x:Static controls:MotoIcons.Delete}" FontSize="12"
                    Style="{StaticResource MotoIconButton}"
                    ToolTipProperties.Text="Vider la conversation (/clear)"
                    Clicked="OnClearClicked" />

        </HorizontalStackLayout>

        <!-- Messages -->
        <!-- ★ CHANGÉ (25/09, chat en flux) : CollectionView → zone qui défile + pile de bulles. Sous Windows, « faire défiler la
             CollectionView jusqu'au bout » se calculait sur l'ANCIENNE hauteur de la bulle en train de s'écrire : les 2-3
             dernières lignes restaient sous le bord (vu en capture, même avec un 2e essai retardé). Ici, la pile signale
             elle-même sa nouvelle hauteur et la zone défile exactement jusqu'en bas. Pas de virtualisation : sans importance
             pour une conversation (quelques dizaines de bulles). -->
        <ScrollView Grid.Row="1" x:Name="MessageScroller"
                    Scrolled="OnMessagesScrolled" SizeChanged="OnMessagesSizeChanged">
            <VerticalStackLayout x:Name="MessagesStack" SizeChanged="OnMessagesSizeChanged">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <!-- ★ CORRECTION (02/09, retouche "vrai Zed") : cette bulle n'avait
                             aucune bordure (Stroke absent malgré StrokeShape défini) — un pur
                             aplat de couleur sans définition. Le vrai code de Zed (agent_ui/
                             message_editor.rs, message list / thread view) ne mise jamais sur
                             un simple bloc de couleur : les surfaces s'appuient sur des jetons
                             de thème + une bordure fine, jamais un aplat isolé. Stroke ajouté
                             (BorderSoft, déjà utilisé pour les séparateurs discrets du thème),
                             rayon réduit 10→8 pour rester cohérent avec le reste de l'appli
                             (MotoHoverButton/boutons d'icône utilisent déjà 8). -->
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{StaticResource BorderSoft}" StrokeThickness="1"
                                BackgroundColor="{Binding BubbleColor}"
                                Padding="10,6" Margin="4,3"
                                MaximumWidthRequest="420"
                                HorizontalOptions="{Binding Alignment}">
                            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                                <!-- ★ AJOUT (24/09, chat en flux) : pendant que le modèle écrit, un simple texte qui grandit (avec un curseur ▍) ;
                                     le découpage texte / blocs de code ci-dessous n'est fait qu'une fois, à la fin — le refaire dix fois par
                                     seconde reconstruirait chaque cadre et chaque bouton. -->
                                <Label Text="{Binding StreamingText}" IsVisible="{Binding IsStreaming}"
                                       FontSize="{DynamicResource AgentFontSize}" TextColor="{StaticResource Txt1}" LineHeight="1.15" />
                                <!-- ★ CORRIGÉ (03/09) : Label plat unique remplacé par un rendu
                                     par segments (Segments, voir ChatMessage.cs) — permet de
                                     distinguer un bloc de code (police mono + bouton copier) du
                                     reste, ce qu'un seul Label ne pouvait pas faire. -->
                                <VerticalStackLayout Spacing="{StaticResource SpaceXs}" IsVisible="{Binding IsDone}"
                                                     BindableLayout.ItemsSource="{Binding Segments}"
                                                     BindableLayout.ItemTemplateSelector="{StaticResource SegmentSelector}" />
                                <!-- ★ AJOUT (24/09) : modèle, durée, ce que le modèle a lu, ce qui n'a pas été envoyé. -->
                                <Label Text="{Binding Footnote}" IsVisible="{Binding HasFootnote}"
                                       FontSize="{StaticResource FontSizeSmall}" TextColor="{StaticResource Txt2}" />
                                <Label Text="{Binding TimeLabel}" FontSize="{StaticResource FontSizeSmall}"
                                       TextColor="{StaticResource Txt2}" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Contexte attaché -->
        <CollectionView Grid.Row="2" x:Name="ContextList"
                        HeightRequest="28" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="{StaticResource SpaceXs}" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource BgPanel}" Stroke="{StaticResource BorderCol}" Padding="8,2">
                        <Label Text="{Binding Label}" FontSize="{StaticResource FontSizeSmall}" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Suggestions slash -->
        <ListView Grid.Row="3" x:Name="SlashList" HeightRequest="100"
                  IsVisible="False" BackgroundColor="{StaticResource BgPanel}"
                  ItemSelected="OnSlashSelected" />

        <!-- Zone de saisie + barre mode/modèle (structure type agent) -->
        <Border Grid.Row="4" StrokeShape="RoundRectangle 12"
                Stroke="{StaticResource BorderCol}" BackgroundColor="{StaticResource BgApp}" Padding="{StaticResource SpaceXs}">

            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">

                <Entry Grid.Row="0" Grid.ColumnSpan="3" x:Name="InputEntry"
                       Placeholder="Message MOTO AI, @ pour le contexte, / pour les commandes"
                       BackgroundColor="Transparent" FontSize="{DynamicResource AgentFontSize}"
                       TextChanged="OnInputTextChanged"
                       Completed="OnInputCompleted" />

                <Button Grid.Row="1" Grid.Column="0" Text="{x:Static controls:MotoIcons.Attach}" FontSize="13"
                        Style="{StaticResource MotoIconButton}"
                        VerticalOptions="Center"
                        ToolTipProperties.Text="Attacher fichier / sélection"
                        Clicked="OnAttachClicked" />

                <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="{StaticResource SpaceXs}">

                    <!-- ★ BRANCHÉ (24/09) : « Chat » = seulement ce qui est joint (📎) ; « Chat & Write » = le fichier affiché et la
                         sélection partent aussi (vers le modèle local uniquement). « Agent » : pour l'instant comme « Chat & Write ». -->
                    <Picker x:Name="ModePicker" FontSize="{StaticResource FontSizeSmall}" WidthRequest="120"
                            SelectedIndexChanged="OnModeChanged">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Chat</x:String>
                                <x:String>Chat &amp; Write</x:String>
                                <x:String>Agent</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>

                    <Picker x:Name="ModelPicker" FontSize="{StaticResource FontSizeSmall}" WidthRequest="150"
                            SelectedIndexChanged="OnModelChanged">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>MOTO interne</x:String>
                                <x:String>Ollama (qwen2.5-coder:7b)</x:String>
                                <x:String>OpenAI</x:String>
                                <x:String>Anthropic</x:String>
                                <x:String>Mistral</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>

                </HorizontalStackLayout>

                <!-- ★ CHANGÉ (24/09) : devient ■ pendant que la réponse s'écrit — un clic l'arrête. -->
                <!-- ★ (25/09) : glyphes Envoyer / Arrêter (MotoIcons.Send / Stop) au lieu des caractères ➤ / ■. -->
                <Button Grid.Row="1" Grid.Column="2" x:Name="SendButton" Text="{x:Static controls:MotoIcons.Send}"
                        Style="{StaticResource MotoIconButton}" FontSize="14"
                        TextColor="{StaticResource AccentText}"
                        VerticalOptions="Center"
                        ToolTipProperties.Text="Envoyer"
                        Clicked="OnSendButtonClicked" />

            </Grid>

        </Border>

    </Grid>

</ContentView>
