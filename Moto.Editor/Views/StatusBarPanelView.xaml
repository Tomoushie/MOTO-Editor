<?xml version="1.0" encoding="utf-8" ?>
<!--
  StatusBarPanelView — passe visuelle MOTO Dark (01/09)
  Chrome type Zed: même fond que la title bar (BgChrome), chips denses,
  séparateurs discrets, accent pour les états actifs.
  ★ Relayée par Tom via une autre IA ("Grok") — adoptée après vérification
  contre le vrai code (5 couleurs manquantes ajoutées à MotoTheme.xaml, voir
  ce fichier ; le .cs derrière n'a pas changé, confirmé identique au dépôt).
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.StatusBarPanelView"
             HeightRequest="28"
             BackgroundColor="{StaticResource BgChrome}">
    <Grid ColumnDefinitions="*,Auto" Padding="10,0">

        <Label Grid.Column="0" x:Name="StatusLabel" Text="Prêt."
               FontSize="{DynamicResource FontSizeUiSmall}" VerticalOptions="Center"
               TextColor="{StaticResource Txt2}" LineBreakMode="TailTruncation" />

        <!-- ★ AJOUT (02/09, "réveil facile" de l'état des lieux) : PerformanceStatusBarView
             (Mémoire/CPU/Mode/FPS) insérée en code-behind, tout au début de cette
             pile — voir StatusBarPanelView.xaml.cs. x:Name ajouté pour pouvoir
             l'y insérer par-devant les autres puces. -->
        <HorizontalStackLayout x:Name="RightChips" Grid.Column="1" Spacing="0" VerticalOptions="Center">

            <BoxView WidthRequest="1" Color="{StaticResource BorderMuted}" Margin="8,6" />

            <!-- ★ AJOUT (01/10) : nom du fichier affiché, piloté par le réglage
                 « Fenêtre & Layout / Status Bar » sb_active_file (défaut déclaré :
                 false, donc MASQUÉ par défaut — comportement actuel inchangé tant
                 que Tom ne l'active pas). Donnée RÉELLE : MainViewModel.SelectedDocument,
                 posée par SetActiveFile(). Masqué tant qu'aucun fichier n'est ouvert
                 (pas de valeur inventée). -->
            <Label x:Name="ActiveFileLabel" Text=""
                   FontSize="{DynamicResource FontSizeUiSmall}"
                   TextColor="{StaticResource Txt3}"
                   VerticalOptions="Center"
                   Margin="0,0,8,0"
                   LineBreakMode="TailTruncation"
                   MaximumWidthRequest="260"
                   IsVisible="False" />

            <!-- ★ AJOUT (01/10, décision C item 1 tranche 2) : puce « CRLF » / « LF »
                 pilotée par sb_line_endings. Donnée RÉELLE : détectée depuis
                 EditorDocument.Text (le texte chargé, fins de ligne préservées par
                 File.ReadAllText), posée par SetLineEndings(). Masquée tant qu'aucun
                 fichier n'est ouvert OU que le fichier n'a aucun retour à la ligne
                 (jamais de valeur inventée). -->
            <Label x:Name="LineEndingsLabel" Text=""
                   FontSize="{DynamicResource FontSizeUiSmall}"
                   TextColor="{StaticResource Txt3}"
                   VerticalOptions="Center"
                   Margin="0,0,8,0"
                   IsVisible="False" />

            <!-- ★ AJOUT (01/10, décision C item 1 tranche 2) : puce « Langage » pilotée
                 par sb_language. Donnée RÉELLE : CodeEditorView.LanguageDisplayName(path),
                 nom lisible depuis l'extension (C#, Java, Python…). Masquée si réglage
                 off, aucun fichier, ou extension inconnue (jamais de nom inventé). -->
            <Label x:Name="LanguageLabel" Text=""
                   FontSize="{DynamicResource FontSizeUiSmall}"
                   TextColor="{StaticResource Txt3}"
                   VerticalOptions="Center"
                   Margin="0,0,8,0"
                   IsVisible="False" />

            <Label x:Name="ErrorsLabel" Text="0 erreur"
                   FontSize="{DynamicResource FontSizeUiSmall}"
                   TextColor="{StaticResource Txt2}"
                   VerticalOptions="Center"
                   Margin="8,0" />

            <Label x:Name="WarningsLabel" Text="0 avertissement"
                   FontSize="{DynamicResource FontSizeUiSmall}"
                   TextColor="{StaticResource Warning}"
                   VerticalOptions="Center"
                   Margin="0,0,8,0"
                   IsVisible="False" />

            <!-- ★ (25/09) : sandbox + verrou regroupés avec LEUR séparateur et masqués ensemble (voir UpdateStateChips) :
                 avant, deux traits verticaux restaient collés quand les deux étiquettes étaient cachées. -->
            <HorizontalStackLayout x:Name="StateChips" Spacing="0" VerticalOptions="Center" IsVisible="False">
                <BoxView WidthRequest="1" Color="{StaticResource BorderMuted}" Margin="0,6" />

                <Label x:Name="SandboxLabel" Text="Sandbox"
                       FontSize="{DynamicResource FontSizeUiSmall}"
                       TextColor="{StaticResource Accent}"
                       VerticalOptions="Center"
                       Margin="8,0"
                       IsVisible="False" />

                <Label x:Name="LockedLabel" Text="Verrouillé"
                       FontSize="{DynamicResource FontSizeUiSmall}"
                       TextColor="{StaticResource Warning}"
                       VerticalOptions="Center"
                       Margin="8,0"
                       IsVisible="False" />
            </HorizontalStackLayout>

            <!-- ★ AJOUT (01/10, décision C item 1) : 7 boutons d'action de la barre de statut.
                 Jusqu'ici les réglages sb_project_panel/sb_terminal/sb_search/sb_debugger,
                 gp_button, cp_button et ap_button étaient inertes : ils prétendent configurer
                 « un bouton dans la barre de statut » qui n'existait pas. Chaque bouton suit le
                 patron éprouvé du bouton « Infos »/« Monitoring IA » (Border transparent +
                 Label + TapGestureRecognizer), et chaque bouton est REGROUPÉ avec SON séparateur
                 dans un conteneur dont on bascule la visibilité (patron du StateChips plus haut) :
                 masquer un bouton ne laisse donc jamais un trait vertical orphelin. -->

            <HorizontalStackLayout x:Name="ProjectPanelChip" Spacing="0" VerticalOptions="Center">
                <BoxView WidthRequest="1" Color="{StaticResource BorderMuted}" Margin="0,6" />
                <Border BackgroundColor="Transparent" Padding="8,0" StrokeThickness="0"
                        ToolTipProperties.Text="Projet — afficher/masquer l'explorateur">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProjectPanelTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="Projet"
                           FontSize="{DynamicResource FontSizeUiSmall}"
                           TextColor="{StaticResource Txt2}"
                           VerticalOptions="Center" />
                </Border>
            </HorizontalStackLayout>

            <HorizontalStackLayout x:Name="TerminalChip" Spacing="0" VerticalOptions="Center">
                <BoxView WidthRequest="1" Color="{StaticResource BorderMuted}" Margin="0,6" />
                <Border BackgroundColor="Transparent" Padding="8,0" StrokeThickness="0"
                        ToolTipProperties.Text="Terminal — afficher/masquer le dock bas">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTerminalTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="Terminal"
                           FontSize="{DynamicResource FontSizeUiSmall}"
                           TextColor="{StaticResource Txt2}"
                           VerticalOptions="Center" />
                </Border>
            </HorizontalStackLayout>

            <HorizontalStackLayout x:Name="SearchChip" Spacing="0" VerticalOptions="Center">
                <BoxView WidthRequest="1" Color="{StaticResource BorderMuted}" Margin="0,6" />
                <Border BackgroundColor="Transparent" Padding="8,0" StrokeThickness="0"
                        ToolTipProperties.Text="Recherche — afficher/masquer le panneau de recherche">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="Recherche"
                           FontSize="{DynamicResource FontSizeUiSmall}"
                           TextColor="{StaticResource Txt2}"
                           VerticalOptions="Center" />
                </Border>
            </HorizontalStackLayout>

            <HorizontalStackLayout x:Name="DebuggerChip" Spacing="0" VerticalOptions="Center">
                <BoxView WidthRequest="1" Color="{StaticResource BorderMuted}" Margin="0,6" />
                <Border BackgroundColor="Transparent" Padding="8,0" StrokeThickness="0"
                        ToolTipProperties.Text="Débogueur — ouvrir la fenêtre Debug">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDebuggerTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="Debug"
                           FontSize="{DynamicResource FontSizeUiSmall}"
                           TextColor="{StaticResource Txt2}"
                           VerticalOptions="Center" />
                </Border>
            </HorizontalStackLayout>

            <HorizontalStackLayout x:Name="GitChip" Spacing="0" VerticalOptions="Center">
                <BoxView WidthRequest="1" Color="{StaticResource BorderMuted}" Margin="0,6" />
                <Border BackgroundColor="Transparent" Padding="8,0" StrokeThickness="0"
                        ToolTipProperties.Text="Git — ouvrir le panneau Git">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGitTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="Git"
                           FontSize="{DynamicResource FontSizeUiSmall}"
                           TextColor="{StaticResource Txt2}"
                           VerticalOptions="Center" />
                </Border>
            </HorizontalStackLayout>

            <HorizontalStackLayout x:Name="CollabChip" Spacing="0" VerticalOptions="Center">
                <BoxView WidthRequest="1" Color="{StaticResource BorderMuted}" Margin="0,6" />
                <Border BackgroundColor="Transparent" Padding="8,0" StrokeThickness="0"
                        ToolTipProperties.Text="Collaboration — afficher/masquer le panneau de collaboration">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCollabTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="Collab"
                           FontSize="{DynamicResource FontSizeUiSmall}"
                           TextColor="{StaticResource Txt2}"
                           VerticalOptions="Center" />
                </Border>
            </HorizontalStackLayout>

            <HorizontalStackLayout x:Name="AiPanelChip" Spacing="0" VerticalOptions="Center">
                <BoxView WidthRequest="1" Color="{StaticResource BorderMuted}" Margin="0,6" />
                <Border BackgroundColor="Transparent" Padding="8,0" StrokeThickness="0"
                        ToolTipProperties.Text="IA — afficher/masquer le panneau de chat IA">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAiPanelTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="IA"
                           FontSize="{DynamicResource FontSizeUiSmall}"
                           TextColor="{StaticResource Txt2}"
                           VerticalOptions="Center" />
                </Border>
            </HorizontalStackLayout>

            <BoxView WidthRequest="1" Color="{StaticResource BorderMuted}" Margin="0,6" />

            <Border BackgroundColor="Transparent" Padding="8,0" StrokeThickness="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnInfoTapped" />
                </Border.GestureRecognizers>
                <Label Text="Infos"
                       FontSize="{DynamicResource FontSizeUiSmall}"
                       TextColor="{StaticResource Txt2}"
                       VerticalOptions="Center" />
            </Border>

            <BoxView WidthRequest="1" Color="{StaticResource BorderMuted}" Margin="0,6" />

            <Border BackgroundColor="Transparent" Padding="8,0" StrokeThickness="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAiMonitorTapped" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="{StaticResource SpaceXs}"
                                       ToolTipProperties.Text="Monitoring IA — Cliquez pour ouvrir">
                    <Label x:Name="AiStatusLabel" Text="Monitoring : Idle"
                           FontSize="{DynamicResource FontSizeUiSmall}"
                           TextColor="{StaticResource Txt2}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </HorizontalStackLayout>

    </Grid>
</ContentView>
