<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Views.ThemePreviewView"
             IsVisible="False"
             BackgroundColor="#80000000">
    <Border BackgroundColor="{StaticResource BgPanel}"
            Stroke="{StaticResource BgHover}" StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            Padding="20" WidthRequest="600" HeightRequest="500"
            HorizontalOptions="Center" VerticalOptions="Center">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <Label x:Name="ThemeNameLabel" Text="🎨 Preview Thème" FontSize="18" FontAttributes="Bold"
                       TextColor="{StaticResource Txt1}"/>
                <Button Grid.Column="1" Text="✕" WidthRequest="30" HeightRequest="30"
                        BackgroundColor="Transparent" TextColor="{StaticResource Txt2}"
                        Clicked="OnCloseClicked"/>
            </Grid>

            <!-- Preview zone -->
            <Border Grid.Row="1" x:Name="PreviewContainer"
                    BackgroundColor="{StaticResource BgSide}"
                    Stroke="{StaticResource BgHover}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Aperçu du thème" FontSize="14" FontAttributes="Bold"
                           x:Name="PreviewTitle"/>
                    <Label Text="Ceci est un texte normal avec la couleur Txt1"
                           FontSize="12" x:Name="PreviewText1"/>
                    <Label Text="Texte secondaire avec la couleur Txt2"
                           FontSize="11" x:Name="PreviewText2"/>

                    <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                        <Button Text="Bouton Accent" x:Name="PreviewBtnAccent"
                                BackgroundColor="{StaticResource Accent}" TextColor="White"/>
                        <Button Text="Bouton Side" x:Name="PreviewBtnSide"
                                BackgroundColor="{StaticResource BgSide}" TextColor="{StaticResource Txt1}"/>
                    </HorizontalStackLayout>

                    <Border Margin="0,8,0,0" Padding="8"
                            x:Name="PreviewCodeBlock">
                        <Label Text="// Exemple de code&#10;var x = 42;&#10;Console.WriteLine(x);"
                               FontFamily="Monospace" FontSize="11"
                               x:Name="PreviewCode"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Actions -->
            <HorizontalStackLayout Grid.Row="2" Spacing="8" HorizontalOptions="End">
                <Button Text="Annuler" BackgroundColor="{StaticResource BgSide}"
                        TextColor="{StaticResource Txt1}" Clicked="OnCancelClicked"/>
                <Button Text="✅ Appliquer ce thème" BackgroundColor="{StaticResource Accent}"
                        TextColor="White" Clicked="OnApplyClicked"/>
            </HorizontalStackLayout>
        </Grid>
    </Border>
</ContentView>
