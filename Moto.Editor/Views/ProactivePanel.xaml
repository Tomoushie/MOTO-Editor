<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Moto.Editor.Controls"
             x:Class="Moto.Editor.Views.ProactivePanel"
             IsVisible="False"
             BackgroundColor="Transparent"
             HorizontalOptions="End"
             VerticalOptions="End">

    <Border WidthRequest="300"
            Margin="{StaticResource SpaceMd}"
            BackgroundColor="{StaticResource BgPanel}"
            Stroke="{StaticResource BgHover}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            Padding="{StaticResource SpaceSm}">

        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource SpaceSm}">

            <!-- Header. ★ (25/09, passe « moyen → élevé ») : glyphe ampoule + titre neutre, croix = glyphe du thème. -->
            <Grid ColumnDefinitions="*,Auto">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center" Padding="4,0,0,0">
                    <Label Text="{x:Static controls:MotoIcons.Bulb}" Style="{StaticResource MotoGlyph}"
                           TextColor="{StaticResource AccentText}" />
                    <Label Text="Suggestions"
                           FontSize="{StaticResource FontSizeBody}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Txt1}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Button Grid.Column="1"
                        Text="{x:Static controls:MotoIcons.Close}"
                        Style="{StaticResource MotoIconButton}"
                        FontSize="10"
                        ToolTipProperties.Text="Fermer"
                        Clicked="OnCloseClicked" />
            </Grid>

            <!-- Liste des suggestions -->
            <ScrollView Grid.Row="1" HeightRequest="200">
                <VerticalStackLayout x:Name="SuggestionsList" Spacing="{StaticResource SpaceXs}" />
            </ScrollView>

            <!-- Footer -->
            <Label Grid.Row="2"
                   x:Name="FooterLabel"
                   Text="Mises à jour toutes les 30 s"
                   FontSize="{StaticResource FontSizeSmall}"
                   TextColor="{StaticResource Txt3}"
                   HorizontalOptions="Center" />
        </Grid>
    </Border>
</ContentView>
