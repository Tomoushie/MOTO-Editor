<Project Sdk="Microsoft.NET.Sdk">

  <!-- ══════════════ Ciblage : Windows par défaut, macOS si build sur macOS ══════════════ -->
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net8.0-maccatalyst</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Moto.Editor</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- ══ Métadonnées application + identité MSIX (fusionnées, une seule fois) ══ -->
    <ApplicationTitle>MOTO Editor</ApplicationTitle>
    <ApplicationId>com.moto.editor</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <PublisherDisplayName>MOTO</PublisherDisplayName>
    <PackageDescription>MOTO Editor — éditeur IA 100 % local</PackageDescription>

    <!-- ══ Plateformes supportées ══ -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>

    <!--
      Non empaquetée par défaut (pas de MSIX) : la plus simple pour dev/test local
      (dotnet run / F5). Un Package.appxmanifest existe quand même (Platforms/Windows/)
      pour pouvoir produire un MSIX à la demande — passer WindowsPackageType=UAP en
      ligne de commande (ou via "Publier → Associer au Store" dans Visual Studio)
      sans toucher ce fichier, ex. :
        dotnet publish -f net8.0-windows10.0.19041.0 -p:WindowsPackageType=MSIX -p:RuntimeIdentifierOverride=win10-x64
      La condition ci-dessous ne fixe "None" que si rien n'a été précisé ailleurs.
      (Valeurs acceptées par WindowsPackageType : None, MSIX, Sparse — pas "UAP".)
    -->
    <WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' AND '$(WindowsPackageType)' == ''">None</WindowsPackageType>

    <!--
      ★ CORRECTION (30/08, après coup) : WindowsAppSDKSelfContained=true — ajouté
      pendant la tentative net10.0 — casse le build unpackaged (WindowsPackageType=None)
      dès qu'un Package.appxmanifest existe : la cible GenerateAppManifestFromAppx
      (Microsoft.WindowsAppSDK.SelfContained.targets) tourne toujours dès que cette
      propriété est "true", et suppose un obj\...\MsixContent\AppxManifest.xml qui
      n'est généré qu'en mode réellement empaqueté — DirectoryNotFoundException sinon.
      Pas nécessaire sur net8 (contrairement à net10, où le paquet Windows App
      Runtime installé sur cette machine était incomplet pour la version demandée) :
      retiré ici. Un futur build MSIX explicite peut le repasser à true seulement
      si besoin (-p:WindowsAppSDKSelfContained=true), inutile par défaut.
    -->

    <!--
      30/08 : repli sur net8.0 (retour arrière depuis net10.0) — après une longue
      session de diagnostic, l'appli non empaquetée ne dépassait jamais le tout
      début du bootstrap WinUI sur net10.0-windows (breakpoint dans MauiProgram.
      CreateMauiApp() jamais atteint, aucune exception, code de sortie 0), un
      problème documenté et non résolu de .NET MAUI + net10.0 en mode non
      empaquetée (dotnet/maui#28373 et proches). net8.0 + MAUI 8.0.100 est la
      combinaison la plus éprouvée pour ce mode de lancement précis.
      MauiVersion : épingle sur le workload maui-windows 8.0.100 installé pour
      la bande de SDK 8.0.4xx (voir global.json), pour éviter tout écart entre
      les paquets NuGet et les cibles de build du workload.
    -->
    <MauiVersion>8.0.100</MauiVersion>

    <!--
      Icône/splash/logos : pas encore livrés dans le dépôt (Resources/ et
      Platforms/Windows/appicon.ico n'existent pas). MAUI utilisera son icône
      par défaut en attendant — voir assets/icon/ + scripts/generate-icons.ps1
      pour les générer quand le choix du logo sera fait.
    -->
  </PropertyGroup>

  <!-- ══════════════ Packages NuGet ══════════════ -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <!-- FolderPicker.Default (FileExplorerView/MainPage.UI : ouvrir un dossier) -->
    <PackageReference Include="CommunityToolkit.Maui" Version="9.1.0" />
    <!--
      ★ CORRECTION (30/08, après coup) : le commentaire précédent affirmait que
      Microsoft.Maui.Controls 8.0.100 tirait ~1.4.x en transitif "sans souci" —
      FAUX, vérifié directement : il tire en réalité 1.5.240802000
      (obj/project.assets.json), qui n'est PAS ce que Tom a d'installé en version
      complète sur sa machine (Framework 1.5 présent, mais pas les paquets
      Main/Singleton/DDLM correspondants — seule la 1.8 a le jeu complet, voir
      diagnostic net10.0 précédent, Get-AppxPackage). Résultat : exactement le
      même code d'erreur qu'en net10.0 (0x80670016, "Package dependency criteria
      could not be resolved") + la boîte de dialogue Windows "This application
      requires the Windows App Runtime Version 1.5 ... install a compatible
      Windows App Runtime now?" — cliquer "Oui" renvoie vers la page de
      téléchargement du SDK, pas un vrai installeur du runtime 1.5 exact.
      Fix : épingler explicitement sur 1.8.260804001, la version dont Tom a le
      jeu complet et fonctionnel installé.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
  </ItemGroup>

  <!-- ══════════════ Références projets ══════════════ -->
  <ItemGroup>
    <ProjectReference Include="..\Moto.Core\Moto.Core.csproj" />
    <ProjectReference Include="..\Snake2000.Engine\Snake2000.Engine.csproj" />
  </ItemGroup>

  <!--
    Mis de côté pour cette passe (rien n'est perdu, juste exclu de la compilation) :
    CommandPaletteService (4 fichiers "additions" sans classe de base, jamais
    instanciée nulle part dans le code réel — voir Moto.Core.csproj pour le
    même genre d'exclusions côté Core).
  -->
  <ItemGroup>
    <Compile Remove="Services\CommandPaletteService.cs" />
    <Compile Remove="Services\CommandPaletteService.AdaptiveRanking.cs" />
    <Compile Remove="Services\CommandPaletteService.Extensions.cs" />
    <Compile Remove="Services\CommandPaletteService.Ranking.cs" />
    <!-- CollabView (curseurs CRDT temps réel) : fragment "AJOUTS" sans classe de base,
         jamais referencee ailleurs dans le code reel -->
    <Compile Remove="Views\CollabView.xaml.cs" />
    <MauiXaml Remove="Views\CollabView.xaml" />
    <!-- Vues liées au cluster IA embarquée / marketplace / refactor Roslyn / voix,
         tous mis de côté côté Moto.Core (voir Moto.Core.csproj) -->
    <Compile Remove="Views\AdvancedAiSettingsView.xaml.cs" />
    <MauiXaml Remove="Views\AdvancedAiSettingsView.xaml" />
    <Compile Remove="Views\BenchmarkComparisonView.xaml.cs" />
    <MauiXaml Remove="Views\BenchmarkComparisonView.xaml" />
    <Compile Remove="Views\MarketplaceDashboardView.xaml.cs" />
    <MauiXaml Remove="Views\MarketplaceDashboardView.xaml" />
    <Compile Remove="Views\ModelConsentDialog.xaml.cs" />
    <MauiXaml Remove="Views\ModelConsentDialog.xaml" />
    <Compile Remove="Views\ModelManagerView.xaml.cs" />
    <MauiXaml Remove="Views\ModelManagerView.xaml" />
    <Compile Remove="Views\RefactorPanel.xaml.cs" />
    <MauiXaml Remove="Views\RefactorPanel.xaml" />
    <Compile Remove="Controls\VoiceButton.xaml.cs" />
    <MauiXaml Remove="Controls\VoiceButton.xaml" />
    <Compile Remove="Controls\EditorPaneView.Lsp.cs" />

    <!--
      XAML au format WinUI (UserControl, xmlns winfx/2006) glissé par erreur dans
      Views/Controls MAUI (xmlns dotnet/2021/maui) : le compilateur XAML MAUI ne
      sait pas les interpréter ("method or operation is not implemented"). Aucun
      n'est instancié dans le code réel (AdminDashboardView : jamais implémentée
      d'après son propre commentaire dans MotoServiceCollectionExtensions.cs ;
      PerformanceDashboardView/SubscriptionOverlay : enregistrées en DI mais
      jamais résolues — voir les 2 lignes commentées ci-dessous).
    -->
    <Compile Remove="Controls\StatusBarView.xaml.cs" />
    <MauiXaml Remove="Controls\StatusBarView.xaml" />
    <Compile Remove="Controls\XenoFeedbackControl.xaml.cs" />
    <MauiXaml Remove="Controls\XenoFeedbackControl.xaml" />
    <Compile Remove="Views\AdminDashboardView.xaml.cs" />
    <MauiXaml Remove="Views\AdminDashboardView.xaml" />
    <Compile Remove="Views\PerformanceDashboardView.xaml.cs" />
    <MauiXaml Remove="Views\PerformanceDashboardView.xaml" />
    <Compile Remove="Views\SubscriptionOverlay.xaml.cs" />
    <MauiXaml Remove="Views\SubscriptionOverlay.xaml" />

    <!-- Fragments "Ajout" orphelins (pas de racine valide, jamais mergés nulle part) -->
    <Compile Remove="Views\ResourceGovernorView.xaml.cs" />
    <MauiXaml Remove="Views\ResourceGovernorView.xaml" />
    <MauiXaml Remove="Views\ChipStyle.xaml" />
  </ItemGroup>

  <!--
    Deuxième vague d'exclusions (30/08) : fonctionnalités jamais reliées à
    MainPage ni résolues nulle part dans le code réel, chacune avec ses propres
    erreurs de compilation (API supposée mais jamais écrite, classe de base
    manquante...). Comme toujours : rien n'est perdu, juste mis de côté ; les
    enregistrements DI correspondants sont commentés dans
    MotoServiceCollectionExtensions.cs.
  -->
  <ItemGroup>
    <!-- Jamais résolues (juste enregistrées en DI) : API de settings imaginaire
         (SettingsEngine.Editor.Ux.X.Value / .Editor.Update.X.Value) qui n'a
         jamais été construite — seule l'API plate Get/Set/GetBool existe. -->
    <Compile Remove="Services\SessionBookmarkService.cs" />
    <Compile Remove="Services\Moto.EditorServicesInlineDiffPreviewService.cs" />
    <Compile Remove="Services\UxModeService.cs" />
    <Compile Remove="Services\UxEnchancementService.cs" />

    <!-- Vues jamais instanciées ni enregistrées, chacune avec un .xaml.cs qui
         suppose des éléments x:Name absents de son propre .xaml (même motif
         "AJOUT sans base" que partout ailleurs dans ce dépôt). -->
    <Compile Remove="Views\AiChatView.xaml.cs" />
    <MauiXaml Remove="Views\AiChatView.xaml" />
    <Compile Remove="Views\ConditionalBreakpointDialog.xaml.cs" />
    <MauiXaml Remove="Views\ConditionalBreakpointDialog.xaml" />
    <Compile Remove="Views\GlobalDashboardView.xaml.cs" />
    <MauiXaml Remove="Views\GlobalDashboardView.xaml" />
    <Compile Remove="Views\HealthMonitorView.xaml.cs" />
    <MauiXaml Remove="Views\HealthMonitorView.xaml" />
    <Compile Remove="Views\LanguageSelectorView.xaml.cs" />
    <MauiXaml Remove="Views\LanguageSelectorView.xaml" />
    <Compile Remove="Views\MarketplaceView.xaml.cs" />
    <MauiXaml Remove="Views\MarketplaceView.xaml" />
    <Compile Remove="Views\SnippetCreatorView.xaml.cs" />
    <MauiXaml Remove="Views\SnippetCreatorView.xaml" />
    <Compile Remove="Views\ThreadListView.xaml.cs" />
    <MauiXaml Remove="Views\ThreadListView.xaml" />
    <Compile Remove="Views\TranslationOverlay.xaml.cs" />
    <MauiXaml Remove="Views\TranslationOverlay.xaml" />
    <Compile Remove="Views\StatusBarView.xaml.cs" />
    <MauiXaml Remove="Views\StatusBarView.xaml" />

    <!-- Enregistrées en DI mais jamais résolues -->
    <Compile Remove="Views\ThemeSelectorView.xaml.cs" />
    <MauiXaml Remove="Views\ThemeSelectorView.xaml" />
    <Compile Remove="Views\WhiteboardView.xaml.cs" />
    <MauiXaml Remove="Views\WhiteboardView.xaml" />
    <Compile Remove="Views\PerformanceStatusBarView.xaml.cs" />
    <MauiXaml Remove="Views\PerformanceStatusBarView.xaml" />
    <Compile Remove="Views\XenoFeedbackOverlay.xaml.cs" />
    <MauiXaml Remove="Views\XenoFeedbackOverlay.xaml" />

    <!-- Pages jamais navigables (ni DI, ni Navigation.PushAsync nulle part) -->
    <Compile Remove="Pages\MotoAiPage.xaml.cs" />
    <MauiXaml Remove="Pages\MotoAiPage.xaml" />
    <Compile Remove="Pages\SettingsPage.xaml.cs" />
    <MauiXaml Remove="Pages\SettingsPage.xaml" />

    <!-- Overlays/gutter de debug jamais reliés (référencés uniquement depuis
         EditorPaneView.Lsp.cs, déjà exclu ci-dessus) -->
    <Compile Remove="Controls\BreakpointGutterOverlay.cs" />
    <!-- Doublon : EditorPaneView.InlayHints.cs utilise InlayHintOverlay (singulier) -->
    <Compile Remove="Controls\InlayHintsOverlay.cs" />

    <!-- Onglets image dans l'éditeur : suppose des membres (OpenTabs/SelectedTab/
         AddTab) jamais déclarés nulle part ; EditorPaneView.cs garde sa propre
         méthode partielle AddTabForImage (2 arguments) qui devient un no-op
         une fois cette implémentation retirée — comportement C# normal pour
         une méthode partielle jamais implémentée. -->
    <Compile Remove="Controls\EditorPaneView.ImageTabs.cs" />
    <Compile Remove="Controls\EditorPaneView.ImageIntegration.cs" />
    <Compile Remove="Services\FileTreeService.Images.cs" />
    <Compile Remove="Platforms\Windows\ExternalImageWindow.xaml.cs" Condition="Exists('Platforms\Windows\ExternalImageWindow.xaml.cs')" />
    <Compile Remove="Platforms\Windows\ExternalImageWindow.cs" />
    <!-- N'a plus d'appelant depuis qu'EditorPaneView.OpenImage ne câble plus le bouton
         "fenêtre externe" (dépendait d'ExternalImageWindow, ci-dessus). -->
    <Compile Remove="Services\ImageOpenerService.cs" />

    <!-- Snap Layouts (survol du bouton Maximiser) : plus appelé nulle part
         depuis que MainPage.OnPageLoaded a mis ConfigureSnapLayouts de côté
         (types WinUI incompatibles avec les Border MAUI de CustomMenuBarView). -->
    <Compile Remove="Platforms\Windows\SnapLayoutsHelper.cs" />
    <Compile Remove="Helpers\DragZoneHelper.cs" />
  </ItemGroup>

</Project>
