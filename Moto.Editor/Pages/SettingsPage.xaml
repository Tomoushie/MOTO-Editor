<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:settings="clr-namespace:Moto.Editor.Settings"
             x:Class="Moto.Editor.Pages.SettingsPage"
             Title="Paramètres"
             BackgroundColor="{StaticResource BgApp}">

    <ContentPage.Resources>

        <!-- ★ AJOUT (08/09, chantier visuel) : Segoe UI Variable appliqué à ce
             panneau via un style implicite SCOPÉ À CETTE PAGE (n'affecte pas
             App.xaml ni les autres écrans). -->
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        </Style>
        <Style TargetType="Picker">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        </Style>

        <!-- Template : Toggle (Switch) -->
        <DataTemplate x:Key="TplToggle">
            <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Def.Title}" FontSize="{DynamicResource FontSizeUiText}" FontAttributes="Bold" />
                    <Label Text="{Binding Def.Description}" FontSize="{DynamicResource FontSizeUiSmall}" Opacity="0.6" />
                </VerticalStackLayout>
                <Switch Grid.Column="1" IsToggled="{Binding BoolValue}" VerticalOptions="Center" />
            </Grid>
        </DataTemplate>

        <!-- Template : Int (stepper − / +) -->
        <DataTemplate x:Key="TplInt">
            <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Def.Title}" FontSize="{DynamicResource FontSizeUiText}" FontAttributes="Bold" />
                    <Label Text="{Binding Def.Description}" FontSize="{DynamicResource FontSizeUiSmall}" Opacity="0.6" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                    <Button Text="−" Command="{Binding DecrementCommand}" Padding="8,2" FontSize="12" />
                    <Label Text="{Binding IntValue}" WidthRequest="50" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                    <Button Text="+" Command="{Binding IncrementCommand}" Padding="8,2" FontSize="12" />
                </HorizontalStackLayout>
            </Grid>
        </DataTemplate>

        <!-- Template : Enum (Picker) -->
        <DataTemplate x:Key="TplEnum">
            <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Def.Title}" FontSize="{DynamicResource FontSizeUiText}" FontAttributes="Bold" />
                    <Label Text="{Binding Def.Description}" FontSize="{DynamicResource FontSizeUiSmall}" Opacity="0.6" />
                </VerticalStackLayout>
                <Picker Grid.Column="1" ItemsSource="{Binding Def.Options}"
                        SelectedItem="{Binding OptionValue}"
                        WidthRequest="180" FontSize="{DynamicResource FontSizeUiSmall}" VerticalOptions="Center" />
            </Grid>
        </DataTemplate>

        <!-- Template : String (Entry) -->
        <DataTemplate x:Key="TplString">
            <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Def.Title}" FontSize="{DynamicResource FontSizeUiText}" FontAttributes="Bold" />
                    <Label Text="{Binding Def.Description}" FontSize="{DynamicResource FontSizeUiSmall}" Opacity="0.6" />
                </VerticalStackLayout>
                <Entry Grid.Column="1" Text="{Binding StringValue}"
                       WidthRequest="240" FontSize="{DynamicResource FontSizeUiSmall}" VerticalOptions="Center" />
            </Grid>
        </DataTemplate>

        <!-- Template : Action (bouton Configurer / Test Audio...) -->
        <DataTemplate x:Key="TplAction">
            <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Def.Title}" FontSize="{DynamicResource FontSizeUiText}" FontAttributes="Bold" />
                    <Label Text="{Binding Def.Description}" FontSize="{DynamicResource FontSizeUiSmall}" Opacity="0.6" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="{Binding ActionLabel}"
                        Command="{Binding ActionCommand}"
                        FontSize="{DynamicResource FontSizeUiSmall}" Padding="10,4"
                        VerticalOptions="Center" />
            </Grid>
        </DataTemplate>

        <!-- Sélecteur de template selon le type du paramètre -->
        <settings:SettingTemplateSelector x:Key="SettingSelector"
            ToggleTemplate="{StaticResource TplToggle}"
            IntTemplate="{StaticResource TplInt}"
            EnumTemplate="{StaticResource TplEnum}"
            StringTemplate="{StaticResource TplString}"
            ActionTemplate="{StaticResource TplAction}" />

    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="260,*">

        <!-- Barre du haut -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto"
              BackgroundColor="{StaticResource BgSide}" Padding="12,8">
            <Label Grid.Column="0" Text="⚙ MOTO Editor — Paramètres"
                   FontSize="{StaticResource FontSizeUiTitle}"
                   FontAttributes="Bold" />
            <Button Grid.Column="2" Text="Éditer settings.json"
                    FontSize="{DynamicResource FontSizeUiSmall}" Padding="8,4"
                    Clicked="OnEditJsonClicked" />
        </Grid>

        <!-- Sidebar : recherche + sections -->
        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,*"
              BackgroundColor="{StaticResource BgSide}" Padding="8">

            <Entry Grid.Row="0" x:Name="SearchEntry"
                   Placeholder="Rechercher un paramètre…"
                   BackgroundColor="Transparent" FontSize="12"
                   TextChanged="OnSearchChanged" />

            <CollectionView Grid.Row="1" x:Name="SectionList" SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="8,5">
                            <Label Text="{Binding}" FontSize="12" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

        <!-- Liste des paramètres (rendue par type via le sélecteur) -->
        <CollectionView Grid.Row="1" Grid.Column="1"
                        x:Name="SettingsList"
                        ItemTemplate="{StaticResource SettingSelector}" />

    </Grid>

</ContentPage>
