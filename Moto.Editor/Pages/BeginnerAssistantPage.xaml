<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moto.Editor.Pages.BeginnerAssistantPage"
             Title="Beginner Assistant (Orchestrator)">

    <ContentPage.Resources>
        <!-- ★ AJOUT (08/09, chantier visuel) : Segoe UI Variable appliqué à ce
             panneau via un style implicite SCOPÉ À CETTE PAGE (n'affecte pas
             App.xaml ni les autres écrans). Un FontFamily explicite posé
             directement sur un contrôle (OriginalEditor/ProposedEditor plus
             bas, en Consolas) reste prioritaire sur ce style implicite. -->
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        </Style>
        <Style TargetType="Editor">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        </Style>
        <Style TargetType="Picker">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView Padding="16">

        <VerticalStackLayout Spacing="12">

            <Label Text="Beginner Assistant — via l'orchestrateur XENO-SSS∞"
                   FontSize="{StaticResource FontSizeUiTitle}"
                   FontAttributes="Bold" />

            <Label Text="Le patch proposé n'est jamais écrit automatiquement : relis-le, puis clique 'Appliquer'."
                   FontSize="12"
                   Opacity="0.8" />

            <Entry x:Name="FilePathEntry"
                   Placeholder="Chemin complet du fichier (ex: E:\Projet\Fichier.cs)" />

            <Picker x:Name="ActionPicker"
                    Title="Action">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>FixFile</x:String>
                        <x:String>MakeBetter</x:String>
                        <x:String>GenerateMissingFiles</x:String>
                        <x:String>ExplainCode</x:String>
                        <x:String>ExplainErrors</x:String>
                        <x:String>Teach</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Editor x:Name="ContentEditor"
                    Placeholder="Contenu (optionnel — auto-lu depuis le fichier si laissé vide, pour FixFile/MakeBetter/ExplainCode/ExplainErrors)"
                    HeightRequest="90"
                    AutoSize="TextChanges" />

            <Entry x:Name="CompilerErrorsEntry"
                   Placeholder="Erreurs de compilation (ExplainErrors uniquement)" />

            <Entry x:Name="TopicEntry"
                   Placeholder="Sujet (Teach uniquement — classe, interface, namespace, système, pipeline)" />

            <Button Text="Envoyer"
                    Clicked="OnSendClicked" />

            <BoxView HeightRequest="1" Color="Gray" Opacity="0.3" />

            <Label Text="Requête envoyée"
                   FontSize="{StaticResource FontSizeUiHeading}"
                   FontAttributes="Bold" />
            <Label x:Name="RequestSummaryLabel"
                   FontSize="12"
                   LineBreakMode="WordWrap" />

            <Label Text="Réponse"
                   FontSize="{StaticResource FontSizeUiHeading}"
                   FontAttributes="Bold" />
            <Label x:Name="ResultLabel"
                   LineBreakMode="WordWrap" />

            <Label x:Name="SuggestionsLabel"
                   FontSize="12"
                   Opacity="0.8"
                   LineBreakMode="WordWrap" />

            <VerticalStackLayout x:Name="DiffSection" IsVisible="False" Spacing="8">

                <Label Text="Diff proposé"
                       FontSize="{StaticResource FontSizeUiHeading}"
                       FontAttributes="Bold" />

                <Label Text="Avant (sur disque)"
                       FontSize="12" />
                <Editor x:Name="OriginalEditor"
                        IsReadOnly="True"
                        HeightRequest="160"
                        BackgroundColor="#1a1a1a"
                        TextColor="White"
                        FontFamily="{StaticResource FontFamilyMono}" />

                <Label Text="Proposé par l'orchestrateur"
                       FontSize="12" />
                <Editor x:Name="ProposedEditor"
                        IsReadOnly="True"
                        HeightRequest="160"
                        BackgroundColor="#102a1a"
                        TextColor="White"
                        FontFamily="{StaticResource FontFamilyMono}" />

                <Button x:Name="ApplyButton"
                        Text="Appliquer (écrit réellement sur disque)"
                        Clicked="OnApplyClicked"
                        IsEnabled="False" />

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
