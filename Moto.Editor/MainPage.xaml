<?xml version="1.0" encoding="utf-8" ?>
<!--
  Moto.Editor/MainPage.xaml
  ★ REFONTE (30/08, 2e passe) : mise en page façon "Zen Code" minimaliste,
  demandée par Tom après le premier lancement réel. Changements structurels :
    - Colonne 0 (barre d'activité, icônes verticales) → ligne horizontale sous
      la barre de titre (ActivityBarView, réécrite en horizontal, sans icônes).
    - L'ancienne colonne 3 ("dock IA" : Cortex/Neural/Workspace/etc.) devient
      la colonne 0, à GAUCHE (comme le panneau de discussion IA façon
      VS Code/Zen demandé par Tom). Largeur nommée AiDockColumn, 0 par défaut
      (repli de la "zone noire" toujours visible même vide, repérée par Tom) —
      étendue par code (RefreshAiDockColumnWidth, MainPage.Panels.cs) dès qu'un
      panneau de cette colonne devient visible.
    - L'explorateur de fichiers (ancienne colonne 1) devient la colonne 2, à
      DROITE (demandé par Tom). Largeur nommée FileTreeColumn, 0 par défaut —
      étendue par code (ToggleSide / LoadWorkspace) à l'ouverture d'un dossier.
    - Colonne centrale (Accueil/Éditeur) reste "*" : à largeur nulle des deux
      côtés, elle occupe donc tout naturellement 100% de la largeur par défaut.
    - Petit logo qui occupait le coin de l'ancienne colonne 1 : supprimé (plus
      de coin sensé où le poser une fois la barre d'activité horizontale ;
      l'accueil a déjà son propre gros logo).
  Chaque élément nommé ci-dessous a été retrouvé en lisant tous les
  MainPage.*.cs (partial class) pour savoir quel type/membre chacun exige.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Moto.Editor.Controls"
             xmlns:views="clr-namespace:Moto.Editor.Views"
             x:Class="Moto.Editor.MainPage"
             BackgroundColor="#1E2025"
             Loaded="OnPageLoaded">

    <!--
      ★ CORRECTION (après coup, 30/08) : les colonnes 0/2 utilisaient d'abord une
      largeur absolue (GridLength 0/500/260) basculée par code. Ça a fait planter
      WinUI à l'arrangement (CS... non, exception native WinRT dans Arrange —
      voir %TEMP%\moto-editor-crash.log) : un Grid MAUI dont une colonne mesure
      exactement 0px tente quand même d'arranger l'enfant qui s'y trouve, et le
      CollectionView de l'explorateur (ItemsRepeater WinUI) ne tolère pas un
      rectangle d'arrangement de taille nulle. Remplacé par le patron standard
      MAUI : colonnes "Auto" + repli via IsVisible=False sur l'ÉLÉMENT lui-même
      (AiDockPanel / ExplorerPanel / Sidebar) — un enfant invisible est
      complètement ignoré par le moteur de layout (contribution 0,0), au lieu
      d'être mesuré puis arrangé dans un rectangle dégénéré.
    -->
    <!-- ★ CORRECTION (31/08) : ligne 0 34→38 pour accueillir CustomMenuBarView agrandie
         (boutons min/max/close plus grands, demandé par Tom). -->
    <Grid x:Name="RootGrid" RowDefinitions="38,38,*,26" ColumnDefinitions="Auto,*,Auto">

        <!-- ══════════════════ Barre de titre / menu ══════════════════ -->
        <views:CustomMenuBarView x:Name="MenuBar" Grid.Row="0" Grid.ColumnSpan="3" />

        <!-- ══════════════════ Barre de navigation horizontale (ex-barre d'activité) ══════════════════ -->
        <controls:ActivityBarView x:Name="ActivityBar" Grid.Row="1" Grid.ColumnSpan="3" />

        <!-- ══════════════════ Colonne 0 : dock IA (placeholders) + panneaux ══════════════════ -->
        <!-- Ancre réelle des panneaux IA (Cortex/Neural/Workspace/etc.), un par un
             (voir AddFloatingPanel, MainPage.Panels.cs). AiHost/ChatHost/ThreadHost
             inchangés (utilisés ailleurs, OnMaximizeToggled notamment). -->
        <Grid x:Name="AiDockPanel" Grid.Row="2" Grid.Column="0" RowDefinitions="Auto,*"
              WidthRequest="500" IsVisible="False" BackgroundColor="#17181C">
            <VerticalStackLayout Grid.Row="0" Spacing="8" Padding="8">
                <Border x:Name="AiHost" IsVisible="False" Padding="10"
                        BackgroundColor="{StaticResource BgPanel}" StrokeShape="RoundRectangle 8">
                    <Label Text="🤖 Panneau IA" FontSize="12" TextColor="{StaticResource Txt2}" />
                </Border>
                <Border x:Name="ChatHost" IsVisible="False" Padding="10"
                        BackgroundColor="{StaticResource BgPanel}" StrokeShape="RoundRectangle 8">
                    <Label Text="💬 Chat" FontSize="12" TextColor="{StaticResource Txt2}" />
                </Border>
                <Border x:Name="ThreadHost" IsVisible="False" Padding="10"
                        BackgroundColor="{StaticResource BgPanel}" StrokeShape="RoundRectangle 8">
                    <Label Text="🧵 Threads" FontSize="12" TextColor="{StaticResource Txt2}" />
                </Border>
            </VerticalStackLayout>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout x:Name="PanelHost" Spacing="8" Padding="8" />
            </ScrollView>
        </Grid>

        <!-- ══════════════════ Colonne 1 : Accueil / Éditeur ══════════════════ -->
        <controls:EditorPaneView x:Name="EditorPane" Grid.Row="2" Grid.Column="1" IsVisible="False" />
        <!-- Home (x:Name="Home") est ajouté ici par code dans MainPage.xaml.cs :
             HomeView n'a pas de constructeur sans paramètre (elle a besoin de
             ChatService/CortexEngine/WorkspaceStateService, disponibles seulement
             après InitializeComponent()). Elle occupe la même cellule Row=2,Col=1. -->

        <!-- ══════════════════ Colonne 2 : Explorateur / Sidebar ══════════════════ -->
        <views:FileExplorerView x:Name="ExplorerPanel" Grid.Row="2" Grid.Column="2"
                                 WidthRequest="260" IsVisible="False" />
        <views:SidebarView x:Name="Sidebar" Grid.Row="2" Grid.Column="2"
                            WidthRequest="260" IsVisible="False" />

        <!-- ══════════════════ Barre de statut ══════════════════ -->
        <views:StatusBarPanelView x:Name="StatusBar" Grid.Row="3" Grid.ColumnSpan="3" />

        <!-- ══════════════════ Bandeau IA flottant (Ctrl+Shift+I) ══════════════════ -->
        <!-- ★ CORRECTION (30/08, 2e passe) : centré sur les 3 colonnes (dock IA +
             centre + arborescence), ce bandeau se retrouvait décalé/coupé dès que le
             dock IA (colonne 0) s'ouvrait à gauche — repéré par Tom ("le bouton pour
             lui écrire est mal aligné et coupé par le bandeau"). Restreint à la seule
             colonne centrale : il suit désormais la zone Accueil/Éditeur, peu importe
             ce qui est ouvert à gauche ou à droite. -->
        <views:AiCommandBarView x:Name="AiBar" Grid.Row="2" Grid.Column="1"
                                 HorizontalOptions="Center" VerticalOptions="End"
                                 Margin="0,0,0,40" IsVisible="False" />

        <!-- ══════════════════ Panneaux flottants (toggle IsVisible) ══════════════════ -->
        <views:ExportMenuView x:Name="ExportMenu" Grid.Row="2" Grid.ColumnSpan="3"
                               HorizontalOptions="End" VerticalOptions="Start"
                               Margin="0,10,60,0" IsVisible="False" />

        <views:AutoLinkView x:Name="AutoLinkPanel" Grid.Row="2" Grid.ColumnSpan="3"
                             HorizontalOptions="End" VerticalOptions="Start"
                             Margin="0,10,60,0" IsVisible="False" />

        <views:ContextSuggestionsView x:Name="ContextPanel" Grid.Row="2" Grid.ColumnSpan="3"
                                       HorizontalOptions="End" VerticalOptions="Start"
                                       Margin="0,10,60,0" IsVisible="False" />

        <views:DocPanelView x:Name="DocPanel" Grid.Row="2" Grid.ColumnSpan="3"
                             HorizontalOptions="End" VerticalOptions="Start"
                             Margin="0,10,60,0" IsVisible="False" />

        <views:PresentationView x:Name="PresentationPanel" Grid.Row="2" Grid.ColumnSpan="3"
                                 HorizontalOptions="End" VerticalOptions="Start"
                                 Margin="0,10,60,0" IsVisible="False" />

        <views:RemoteConnectView x:Name="RemotePanel" Grid.Row="2" Grid.ColumnSpan="3"
                                  HorizontalOptions="End" VerticalOptions="Start"
                                  Margin="0,10,60,0" IsVisible="False" />

        <!-- ★ CORRECTION (31/08) : restreint à la colonne centrale (comme AiBar) —
             Tom a signalé "Collab ne s'ouvre pas" ; ancré sur les 3 colonnes, son
             alignement "End" se calculait par rapport à un bord droit qui bouge
             selon que le dock IA/l'arborescence sont ouverts (même piège qu'AiBar,
             déjà corrigé). Colonne 1 = bord stable quoi qu'il y ait d'ouvert ailleurs. -->
        <views:CollabPanelView x:Name="CollabPanel" Grid.Row="2" Grid.Column="1"
                                HorizontalOptions="End" VerticalOptions="Start"
                                Margin="0,10,20,0" IsVisible="False" />

        <!-- ══════════════════ Live Preview (bouton 🌐 de EditorPaneView) ══════════════════ -->
        <!-- ★ AJOUT (30/08, 3e passe) : LivePreviewView/PreviewEngine existaient déjà,
             complets, mais jamais atteignables (point 18 de Tom) — câblés ici. Centré
             (fenêtre de prévisualisation), pas ancré à un coin comme les autres menus. -->
        <views:LivePreviewView x:Name="LivePreview" Grid.Row="2" Grid.ColumnSpan="3"
                                HorizontalOptions="Center" VerticalOptions="Center"
                                HeightRequest="500" IsVisible="False" />

        <!-- Écran de verrouillage (projet protégé par mot de passe) -->
        <views:PasswordGateView x:Name="PasswordGate" Grid.Row="2" Grid.ColumnSpan="3" IsVisible="False" />

        <!-- Menu custom "Emplacement d'exécution" (chip "💻 Local" de l'accueil) -->
        <controls:ExecutionLocationMenu x:Name="LocationMenu" Grid.Row="2" Grid.ColumnSpan="3"
                                          HorizontalOptions="End" VerticalOptions="Start"
                                          Margin="0,10,60,0" IsVisible="False" />

        <!-- SettingsMenu (x:Name="SettingsMenu") est ajouté par code : SettingsMenuView
             a besoin de PluginRegistry/ProfileManager/SettingsImporterExporter en
             constructeur (résolus via DI dans MainPage.xaml.cs). -->

    </Grid>

</ContentPage>
