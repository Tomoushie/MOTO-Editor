<?xml version="1.0" encoding="utf-8" ?>
<!--
  Moto.Editor/MainPage.xaml
  ★ REFONTE (30/08, 2e passe) : mise en page façon "Zen Code" minimaliste,
  demandée par Tom après le premier lancement réel. Changements structurels :
    - Colonne 0 (barre d'activité, icônes verticales) → ligne horizontale sous
      la barre de titre (ActivityBarView, réécrite en horizontal, sans icônes).
    - L'ancienne colonne 3 ("dock IA" : Cortex/Neural/Workspace/etc.) devient
      la colonne 0, à GAUCHE (comme le panneau de discussion IA façon
      VS Code/Zen demandé par Tom). Largeur nommée AiDockColumn, 0 par défaut
      (repli de la "zone noire" toujours visible même vide, repérée par Tom) —
      étendue par code (RefreshAiDockColumnWidth, MainPage.Panels.cs) dès qu'un
      panneau de cette colonne devient visible.
    - L'explorateur de fichiers (ancienne colonne 1) devient la colonne 2, à
      DROITE (demandé par Tom). Largeur nommée FileTreeColumn, 0 par défaut —
      étendue par code (ToggleSide / LoadWorkspace) à l'ouverture d'un dossier.
    - Colonne centrale (Accueil/Éditeur) reste "*" : à largeur nulle des deux
      côtés, elle occupe donc tout naturellement 100% de la largeur par défaut.
    - Petit logo qui occupait le coin de l'ancienne colonne 1 : supprimé (plus
      de coin sensé où le poser une fois la barre d'activité horizontale ;
      l'accueil a déjà son propre gros logo).
  Chaque élément nommé ci-dessous a été retrouvé en lisant tous les
  MainPage.*.cs (partial class) pour savoir quel type/membre chacun exige.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Moto.Editor.Controls"
             xmlns:views="clr-namespace:Moto.Editor.Views"
             x:Class="Moto.Editor.MainPage"
             BackgroundColor="#1E2025"
             Loaded="OnPageLoaded">

    <!--
      ★ CORRECTION (après coup, 30/08) : les colonnes 0/2 utilisaient d'abord une
      largeur absolue (GridLength 0/500/260) basculée par code. Ça a fait planter
      WinUI à l'arrangement (CS... non, exception native WinRT dans Arrange —
      voir %TEMP%\moto-editor-crash.log) : un Grid MAUI dont une colonne mesure
      exactement 0px tente quand même d'arranger l'enfant qui s'y trouve, et le
      CollectionView de l'explorateur (ItemsRepeater WinUI) ne tolère pas un
      rectangle d'arrangement de taille nulle. Remplacé par le patron standard
      MAUI : colonnes "Auto" + repli via IsVisible=False sur l'ÉLÉMENT lui-même
      (AiDockPanel / ExplorerPanel / Sidebar) — un enfant invisible est
      complètement ignoré par le moteur de layout (contribution 0,0), au lieu
      d'être mesuré puis arrangé dans un rectangle dégénéré.
    -->
    <!-- ★ CORRECTION (31/08) : ligne 0 34→38 pour accueillir CustomMenuBarView agrandie
         (boutons min/max/close plus grands, demandé par Tom). -->
    <!-- ★ CORRECTION (31/08) : ligne 1 38→0 — Fichiers/Recherche/IA/Cortex/Collab ont
         déménagé DANS CustomMenuBarView (ligne 0), sur la même ligne que
         l'engrenage/Min/Max/Fermer (Tom : "sur la même ligne"). Ligne gardée à 0 (pas
         supprimée) pour ne PAS avoir à renuméroter tous les Grid.Row="2"/"3" du
         reste de ce fichier — une ligne à hauteur 0 sans aucun enfant est sans
         risque (contrairement au bug historique d'une CollectionView arrangée dans
         un rectangle dégénéré, documenté plus bas : ici, rien n'y est placé du tout). -->
    <!-- ★ AJOUT (01/09, chantier "panneaux modulaires" — dock du bas) : nouvelle
         ligne 3 "Auto" pour le Terminal (repli à 0 par IsVisible=False sur
         TerminalPanel lui-même, même patron que les colonnes 0/2 ci-dessus —
         jamais de RowDefinition touchée par code). La barre de statut, seule
         chose qui référençait Grid.Row="3" dans ce fichier, devient Grid.Row="4"
         (vérifié : aucun autre Grid.Row="3" dans tout ce fichier). -->
    <Grid x:Name="RootGrid" RowDefinitions="38,0,*,Auto,26" ColumnDefinitions="Auto,*,Auto">

        <!-- ══════════════════ Barre de titre / menu (+ nav, même ligne) ══════════════════ -->
        <views:CustomMenuBarView x:Name="MenuBar" Grid.Row="0" Grid.ColumnSpan="3" />

        <!-- ══════════════════ Colonne 0 : dock IA + panneaux ══════════════════ -->
        <!-- Ancre réelle des panneaux IA (Cortex/Neural/Workspace/AiChatView/etc.),
             un par un (voir AddFloatingPanel, MainPage.Panels.cs).
             ★ RETRAIT (02/09) : AiHost (stub "🤖 Panneau IA" codé en dur, sans
             aucun vrai contenu) supprimé — le bouton "IA" de l'écran d'accueil
             ouvrait cette coquille vide au lieu d'un vrai panneau (repéré par
             Tom). Remplacé par un vrai AiChatView, branché comme les autres
             panneaux IA via AddFloatingPanel (voir MainPage.xaml.cs/.Routing.cs).
             ★ RETRAIT (02/09, état des lieux) : ChatHost/ThreadHost (étiquettes
             "💬 Chat"/"🧵 Threads" codées en dur, jamais reliées à un vrai
             contenu) supprimés aussi — un simple cycle Maximiser/Restaurer
             (OnMaximizeToggled) les repassait à visible=true en permanence,
             pouvant garder ce dock ouvert pour n'afficher que 2 labels morts. -->
        <Grid x:Name="AiDockPanel" Grid.Row="2" Grid.Column="0"
              WidthRequest="500" IsVisible="False" BackgroundColor="#17181C">
            <ScrollView>
                <VerticalStackLayout x:Name="PanelHost" Spacing="{StaticResource SpaceSm}" Padding="{StaticResource SpaceSm}" />
            </ScrollView>
        </Grid>

        <!-- ★ AJOUT (01/09, chantier "panneaux modulaires" — 1re étape) : poignée
             d'étirement sur le bord DROIT du dock IA (même patron que
             ExplorerResizeHandle, côté opposé puisque ce dock est à gauche de
             l'écran). Généralise le redimensionnement à la souris, déjà en place
             sur l'explorateur, au dock IA. -->
        <Border x:Name="AiDockResizeHandle" Grid.Row="2" Grid.Column="0"
                WidthRequest="6" HorizontalOptions="End" VerticalOptions="Fill"
                BackgroundColor="Transparent" StrokeThickness="0" IsVisible="False">
            <Border.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnAiDockResizePanUpdated" />
            </Border.GestureRecognizers>
        </Border>

        <!-- ══════════════════ Colonne 1 : Accueil / Éditeur ══════════════════ -->
        <controls:EditorPaneView x:Name="EditorPane" Grid.Row="2" Grid.Column="1" IsVisible="False" />
        <!-- Home (x:Name="Home") est ajouté ici par code dans MainPage.xaml.cs :
             HomeView n'a pas de constructeur sans paramètre (elle a besoin de
             ChatService/CortexEngine/WorkspaceStateService, disponibles seulement
             après InitializeComponent()). Elle occupe la même cellule Row=2,Col=1. -->

        <!-- ══════════════════ Colonne 2 : Explorateur / Sidebar ══════════════════ -->
        <!-- ★ AJOUT (01/09, chantier "panneaux modulaires" — 4e étape, glisser-
             déposer ENTRE docks) : ExplorerPanel/Sidebar enveloppés dans un Grid
             (RowDefinitions "*,Auto") pour accueillir, empilée EN DESSOUS, une
             zone déroulante recevant les panneaux du dock IA glissés jusqu'ici —
             symétrique de la structure d'AiDockPanel (zone fixe + liste
             dynamique), rôles inversés : ici l'explorateur/sidebar garde tout
             l'espace disponible ("*"), la zone de panneaux migrés ne prend que ce
             qu'il lui faut ("Auto", plafonné par MaximumHeightRequest) et
             n'apparaît QUE si un panneau y a effectivement été déplacé (même
             patron IsVisible=repli-à-0 qu'ailleurs dans ce fichier — jamais de
             RowDefinition touchée par code). ExplorerResizeHandle reste un
             SIBLING de ce Grid, pas un enfant : il continue de couvrir toute la
             hauteur de la colonne (explorateur + zone migrée), inchangé. -->
        <Grid x:Name="ExplorerDockPanel" Grid.Row="2" Grid.Column="2" RowDefinitions="*,Auto">
            <views:FileExplorerView x:Name="ExplorerPanel" Grid.Row="0"
                                     WidthRequest="260" IsVisible="False" />
            <views:SidebarView x:Name="Sidebar" Grid.Row="0"
                                WidthRequest="260" IsVisible="False" />

            <!-- ★ CORRECTION (01/09, revue croisée) : MaximumWidthRequest="640" ajouté
                 — sans lui, un panneau migré ici dont le contenu naturel dépasse
                 260px (ex. Analytics/Galerie, pensés pour les 500px du dock IA)
                 pourrait élargir la colonne "Auto" au-delà de ce qu'ExplorerPanel/
                 Sidebar (WidthRequest="260" fixe) demandent eux-mêmes, sans passer
                 par la poignée de redimensionnement. Plafonné à 640 = la même
                 borne haute que cette poignée s'impose déjà (OnExplorerResizePanUpdated) —
                 aucun pire cas nouveau par rapport à ce que l'utilisateur peut déjà
                 obtenir en tirant la poignée à fond. -->
            <ScrollView x:Name="ExplorerPanelHostWrapper" Grid.Row="1"
                        MaximumHeightRequest="320" MaximumWidthRequest="640" IsVisible="False">
                <VerticalStackLayout x:Name="PanelHostRight" Spacing="{StaticResource SpaceSm}" Padding="{StaticResource SpaceSm}" />
            </ScrollView>
        </Grid>

        <!-- ★ AJOUT (31/08, point 7) : poignée d'étirement sur le bord gauche de
             l'explorateur/sidebar (même cellule de grille, ancrée à gauche, dessinée
             par-dessus — même patron que le coin de redimensionnement de
             SettingsWindowView). Redimensionne les DEUX vues ensemble pour qu'elles
             restent alignées, qu'on bascule de l'une à l'autre ou non. -->
        <Border x:Name="ExplorerResizeHandle" Grid.Row="2" Grid.Column="2"
                WidthRequest="6" HorizontalOptions="Start" VerticalOptions="Fill"
                BackgroundColor="Transparent" StrokeThickness="0" IsVisible="False">
            <Border.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnExplorerResizePanUpdated" />
            </Border.GestureRecognizers>
        </Border>

        <!-- ══════════════════ Dock du bas : Terminal ══════════════════ -->
        <!-- ★ AJOUT (01/09) : le vrai moteur (TerminalService — cmd.exe/bash,
             sortie en direct, envoi de commandes) et tout le câblage ViewModel
             (TerminalLines/TerminalInput/SendTerminalCommand/IsTerminalVisible)
             existaient déjà et tournaient (OnPlayClicked, MainPage.UI.cs) —
             seul cet écran manquait. Liaison directe {Binding IsTerminalVisible}
             plutôt que la poignée C# (RefreshXVisibility) utilisée ailleurs dans
             ce fichier : IsTerminalVisible est déjà une vraie propriété
             observable du ViewModel, donc une liaison XAML est ici plus simple
             ET plus correcte, pas une entorse à la convention sans raison. -->
        <views:TerminalPanelView x:Name="TerminalPanel" Grid.Row="3" Grid.ColumnSpan="3"
                                  HeightRequest="220" IsVisible="{Binding IsTerminalVisible}" />

        <!-- Poignée d'étirement sur le bord HAUT du dock (même patron que les
             poignées gauche/droite : sibling, pas enfant, pour ne jamais être
             clippée par la même astuce que le bug du menu "Local"). -->
        <Border x:Name="BottomDockResizeHandle" Grid.Row="3" Grid.ColumnSpan="3"
                HeightRequest="6" VerticalOptions="Start" HorizontalOptions="Fill"
                BackgroundColor="Transparent" StrokeThickness="0"
                IsVisible="{Binding IsTerminalVisible}">
            <Border.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnBottomDockResizePanUpdated" />
            </Border.GestureRecognizers>
        </Border>

        <!-- ══════════════════ Barre de statut ══════════════════ -->
        <views:StatusBarPanelView x:Name="StatusBar" Grid.Row="4" Grid.ColumnSpan="3" />

        <!-- ══════════════════ Bandeau IA flottant (Ctrl+Shift+I) ══════════════════ -->
        <!-- ★ CORRECTION (30/08, 2e passe) : centré sur les 3 colonnes (dock IA +
             centre + arborescence), ce bandeau se retrouvait décalé/coupé dès que le
             dock IA (colonne 0) s'ouvrait à gauche — repéré par Tom ("le bouton pour
             lui écrire est mal aligné et coupé par le bandeau"). Restreint à la seule
             colonne centrale : il suit désormais la zone Accueil/Éditeur, peu importe
             ce qui est ouvert à gauche ou à droite. -->
        <views:AiCommandBarView x:Name="AiBar" Grid.Row="2" Grid.Column="1"
                                 HorizontalOptions="Center" VerticalOptions="End"
                                 Margin="0,0,0,40" IsVisible="False" />

        <!-- ══════════════════ Panneaux flottants (toggle IsVisible) ══════════════════ -->
        <views:ExportMenuView x:Name="ExportMenu" Grid.Row="2" Grid.ColumnSpan="3"
                               HorizontalOptions="End" VerticalOptions="Start"
                               Margin="0,10,60,0" IsVisible="False" />

        <views:AutoLinkView x:Name="AutoLinkPanel" Grid.Row="2" Grid.ColumnSpan="3"
                             HorizontalOptions="End" VerticalOptions="Start"
                             Margin="0,10,60,0" IsVisible="False" />

        <views:ContextSuggestionsView x:Name="ContextPanel" Grid.Row="2" Grid.ColumnSpan="3"
                                       HorizontalOptions="End" VerticalOptions="Start"
                                       Margin="0,10,60,0" IsVisible="False" />

        <views:DocPanelView x:Name="DocPanel" Grid.Row="2" Grid.ColumnSpan="3"
                             HorizontalOptions="End" VerticalOptions="Start"
                             Margin="0,10,60,0" IsVisible="False" />

        <views:PresentationView x:Name="PresentationPanel" Grid.Row="2" Grid.ColumnSpan="3"
                                 HorizontalOptions="End" VerticalOptions="Start"
                                 Margin="0,10,60,0" IsVisible="False" />

        <views:RemoteConnectView x:Name="RemotePanel" Grid.Row="2" Grid.ColumnSpan="3"
                                  HorizontalOptions="End" VerticalOptions="Start"
                                  Margin="0,10,60,0" IsVisible="False" />

        <!-- ★ CORRECTION (31/08) : restreint à la colonne centrale (comme AiBar) —
             Tom a signalé "Collab ne s'ouvre pas" ; ancré sur les 3 colonnes, son
             alignement "End" se calculait par rapport à un bord droit qui bouge
             selon que le dock IA/l'arborescence sont ouverts (même piège qu'AiBar,
             déjà corrigé). Colonne 1 = bord stable quoi qu'il y ait d'ouvert ailleurs.
             ★ CORRECTION (31/08, suite) : Tom voulait Collab en bas à droite, juste
             au-dessus de la barre de statut, pas en plein milieu — VerticalOptions
             Start→End, marge haute→basse. -->
        <views:CollabPanelView x:Name="CollabPanel" Grid.Row="2" Grid.Column="1"
                                HorizontalOptions="End" VerticalOptions="End"
                                Margin="0,0,20,10" IsVisible="False" />

        <!-- ══════════════════ Live Preview (bouton 🌐 de EditorPaneView) ══════════════════ -->
        <!-- ★ AJOUT (30/08, 3e passe) : LivePreviewView/PreviewEngine existaient déjà,
             complets, mais jamais atteignables (point 18 de Tom) — câblés ici. Centré
             (fenêtre de prévisualisation), pas ancré à un coin comme les autres menus. -->
        <views:LivePreviewView x:Name="LivePreview" Grid.Row="2" Grid.ColumnSpan="3"
                                HorizontalOptions="Center" VerticalOptions="Center"
                                HeightRequest="500" IsVisible="False" />

        <!-- Écran de verrouillage (projet protégé par mot de passe) -->
        <views:PasswordGateView x:Name="PasswordGate" Grid.Row="2" Grid.ColumnSpan="3" IsVisible="False" />

        <!-- Menu custom "Emplacement d'exécution" (chip "💻 Local" de l'accueil) -->
        <!-- ★ RETRAIT (31/08, point 1 de Tom) : LocationMenu a déménagé DANS HomeView
             (ancré juste au-dessus de la chip "Local", façon Claude Code, au lieu
             d'en haut à droite de toute la fenêtre). Voir HomeView.xaml. -->

        <!-- ══════════════════ Menu déroulant engrenage/avatar (points 2, 11) ══════════════════ -->
        <views:GearMenuView x:Name="GearMenu" Grid.Row="2" Grid.ColumnSpan="3"
                             HorizontalOptions="End" VerticalOptions="Start"
                             Margin="0,6,8,0" IsVisible="False" />

        <!-- ══════════════════ Fenêtre de Réglages (façon Zed) ══════════════════ -->
        <!-- ★ AJOUT (31/08) : remplace SettingsMenu comme cible de l'icône ⚙ —
             demandé par Tom sur le modèle exact de Zed (fenêtre flottante centrée,
             déplaçable, redimensionnable, catégories + détail).
             ★ RETRAIT (02/09, état des lieux) : SettingsMenu (ancien menu, construit
             en code dans MainPage.xaml.cs — voir CreateHome) supprimé pour de bon,
             plus aucun bouton ne le rouvrait depuis ce 31/08. -->
        <views:SettingsWindowView x:Name="SettingsWindow" Grid.Row="2" Grid.ColumnSpan="3" />

    </Grid>

</ContentPage>
