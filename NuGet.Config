<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Le NuGet.Config global de cette machine (%AppData%\NuGet\NuGet.Config) a ses
    <packageSources> vidées, donc dotnet ne voit que le cache Visual Studio hors-ligne.
    On rajoute nuget.org ICI, seulement pour ce dépôt (aucun effet sur le reste
    de la machine), pour pouvoir restaurer les paquets NuGet du projet.
  -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
